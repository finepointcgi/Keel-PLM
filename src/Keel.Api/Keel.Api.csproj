<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The Blazor components live in Keel.Web; the host must still publish the framework script (blazor.web.js). -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Keel.Core\Keel.Core.csproj" />
    <ProjectReference Include="..\Keel.Security\Keel.Security.csproj" />
    <ProjectReference Include="..\Keel.Audit\Keel.Audit.csproj" />
    <ProjectReference Include="..\Keel.Parts\Keel.Parts.csproj" />
    <ProjectReference Include="..\Keel.Documents\Keel.Documents.csproj" />
    <ProjectReference Include="..\Keel.Bom\Keel.Bom.csproj" />
    <ProjectReference Include="..\Keel.Workflow\Keel.Workflow.csproj" />
    <ProjectReference Include="..\Keel.Change\Keel.Change.csproj" />
    <ProjectReference Include="..\Keel.Admin\Keel.Admin.csproj" />
    <ProjectReference Include="..\Keel.Integration\Keel.Integration.csproj" />
    <ProjectReference Include="..\Keel.Web\Keel.Web.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\db\migrations\*.sql" LinkBase="migrations" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Keel.IntegrationTests" />
  </ItemGroup>
</Project>
