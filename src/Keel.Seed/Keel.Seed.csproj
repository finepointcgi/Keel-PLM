<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>keel-seed</AssemblyName>
    <RootNamespace>Keel.Seed</RootNamespace>
    <NoWarn>$(NoWarn);CA1303;CA2000;CA1031;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Keel.Core\Keel.Core.csproj" />
    <ProjectReference Include="..\Keel.Security\Keel.Security.csproj" />
    <ProjectReference Include="..\Keel.Audit\Keel.Audit.csproj" />
    <ProjectReference Include="..\Keel.Parts\Keel.Parts.csproj" />
    <ProjectReference Include="..\Keel.Documents\Keel.Documents.csproj" />
    <ProjectReference Include="..\Keel.Bom\Keel.Bom.csproj" />
    <ProjectReference Include="..\Keel.Workflow\Keel.Workflow.csproj" />
    <ProjectReference Include="..\Keel.Change\Keel.Change.csproj" />
    <ProjectReference Include="..\Keel.Admin\Keel.Admin.csproj" />
    <ProjectReference Include="..\Keel.Integration\Keel.Integration.csproj" />
    <ProjectReference Include="..\Keel.Requirements\Keel.Requirements.csproj" />
    <!-- The scale scenario wraps the existing bulk generator (the same code the performance gate uses). -->
    <ProjectReference Include="..\..\tests\Keel.TestSupport\Keel.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The synthetic users come from the dev realm itself, so the seed can never drift from what Keycloak issues. -->
    <EmbeddedResource Include="..\..\deploy\compose\keycloak\keel-realm.json" LogicalName="keel-realm.json" />
  </ItemGroup>
</Project>
