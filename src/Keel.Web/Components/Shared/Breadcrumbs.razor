@* Where the user is: Home, then each level, the last one the current page (no link). Fed through PageFrame by every page. *@
@if (Items.Count > 0)
{
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="">Home</a></li>
            @for (var i = 0; i < Items.Count; i++)
            {
                var crumb = Items[i];
                if (i == Items.Count - 1 || crumb.Href is null)
                {
                    <li aria-current="page"><span>@crumb.Label</span></li>
                }
                else
                {
                    <li><a href="@crumb.Href">@crumb.Label</a></li>
                }
            }
        </ol>
    </nav>
}

@code {
    [Parameter] public IReadOnlyList<Crumb> Items { get; set; } = [];
}
