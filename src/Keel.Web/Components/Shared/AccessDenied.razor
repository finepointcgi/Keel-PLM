@inject CurrentUser Users
@inject IAuditLog Audit
@inject NavigationManager Nav

<PageFrame Banner="@UiText.Unclassified" Title="@(signedIn ? "Not authorized" : "Session ended")">
    @if (signedIn)
    {
        <p>You are not authorized to open this page. The attempt has been recorded.</p>
    }
    else
    {
        <p>Your session has ended. <a href="@Nav.Uri" target="_top" @onclick="Reload" @onclick:preventDefault>Sign in again</a>.</p>
    }
</PageFrame>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    /// <summary>False when the HTTP middleware already audited this denial (direct navigation).</summary>
    [Parameter] public bool RecordDenial { get; set; } = true;
    private bool signedIn;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        signedIn = SessionRevalidatingStateProvider.IsValid(user, DateTimeOffset.UtcNow) && SubjectClaims.FromPrincipal(user) is not null;
        // An external supplier user who lands on the home page goes to the supplier portal (8.2); any other internal page stays denied and audited.
        if (signedIn && user.IsInRole(Roles.Supplier) && LandedFromHome()) { Nav.NavigateTo("portal", replace: true); return; }
        if (!signedIn || !RecordDenial) return;
        // In-circuit navigation is authorized by AuthorizeRouteView, not the HTTP middleware, so audit the denial here.
        await Audit.AppendAsync(new AuditEntry
        {
            Actor = ActorSnapshot.From(await Users.GetAsync()),
            Action = "access.denied",
            Outcome = AuditOutcome.Denied,
            ObjectType = "page",
            ObjectId = "/" + Nav.ToBaseRelativePath(Nav.Uri),
            CorrelationId = CurrentUser.NewCorrelationId(),
            Details = AuditDetails.Of(("reason", "role.missing")),
        });
    }

    // The home page itself (in-circuit), or the cookie handler's redirect after a refused "/" (sign-in lands there): ReturnUrl is the home page or absent.
    private bool LandedFromHome()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (path.Length == 0) return true;
        if (!path.StartsWith("access-denied", StringComparison.Ordinal)) return false;
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        return !query.TryGetValue("ReturnUrl", out var ret) || ret.ToString() is "" or "/";
    }

    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}
