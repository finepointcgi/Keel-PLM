<div class="marking-banner @Tone(Text)" role="region" aria-label="Marking banner (@Position)" data-position="@Position">@Text</div>

@code {
    [Parameter, EditorRequired] public required string Text { get; set; }
    [Parameter, EditorRequired] public required string Position { get; set; }

    /// <summary>Green for unclassified, purple for CUI (common DoD practice).</summary>
    public static string Tone(string text) => text.StartsWith("CUI", StringComparison.Ordinal) ? "tone-cui" : "tone-unclassified";
}
