@* Quick add part (ADR 0061): a name is all that is required. Type, unit and source start from the person's last choice, the markings from their own program (one chip
   with a Change button), and the attributes the administrator marked required are asked for here; the rest wait under More details. The part is created by the same
   PartService call as before, so numbering, validation, markings rules and audit are unchanged. *@
@inject CurrentUser Users
@inject PartService Parts
@inject NpgsqlDataSource Db
@inject NavigationManager Nav
@inject IReferenceData Refs
@inject LastChoiceStore Last
@inject ToastService Toasts
@inject ShellJs Js
@inject SimpleFlows Flows
@inject Keel.Documents.Vault.VaultOptions Vault
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C
@using Npgsql
@inject UiLanguage Language

@if (defs is not null)
{
    <form class="stack quick-form" @onsubmit="CreateAsync" novalidate aria-labelledby="quick-part-title" data-quick-part>
        <p class="muted" id="quick-part-title">@P["PartForm.Intro"]</p>
        <div class="grid-form">
            <label class="wide">
                @C["Field.Name"]
                <input @bind="name" @bind:event="oninput" maxlength="200" aria-required="true" aria-invalid="@(Has(nameKey) ? "true" : null)" aria-describedby="@(Has(nameKey) ? "quick-name-error" : null)" data-quick-name />
                @if (Has(nameKey)) { <span id="quick-name-error" class="error" role="alert">@Field(nameKey)</span> }
            </label>
            <label class="wide">
                @C["Field.DescriptionOptional"]
                <textarea rows="2" maxlength="4000" @bind="description"></textarea>
            </label>
            @if (requiredDefs.Count > 0)
            {
                <AttributeFields Definitions="requiredDefs" Value="attributes" />
                @foreach (var d in requiredDefs.Where(d => Has(d.Name)))
                {
                    <p class="error wide" role="alert">@Field(d.Name)</p>
                }
            }
        </div>

        <div class="defaults-line">
            <p class="markings-line">
                @Rich.Strong(P["PartForm.Summary"], Label(partTypes, partType), Label(units, unit).ToLower(Language.Culture), Label(sources, source).ToLower(Language.Culture))
                <button type="button" class="secondary small" aria-expanded="@(showKind ? "true" : "false")" aria-controls="quick-kind" data-kind-change @onclick="() => showKind = !showKind">@(showKind ? P["PartForm.Done"] : P["PartForm.Change"])</button>
            </p>
            @if (showKind)
            {
                <fieldset class="grid-form" id="quick-kind">
                    <legend>@P["PartForm.Kind"]</legend>
                    <label>@C["Column.Type"] <InputSelect @bind-Value="partType">@foreach (var t in partTypes) { <option value="@t.Code">@t.Label</option> }</InputSelect></label>
                    <label>@P["PartForm.Unit"] <InputSelect @bind-Value="unit">@foreach (var u in units) { <option value="@u.Code">@u.Label</option> }</InputSelect></label>
                    <label>@P["PartForm.Source"] <InputSelect @bind-Value="source">@foreach (var s in sources) { <option value="@s.Code">@s.Label</option> }</InputSelect></label>
                    <p class="muted small wide">@P["PartForm.Fixed"]</p>
                </fieldset>
            }
        </div>

        <MarkingsDefaultPicker @ref="markingsPicker" Value="markings" />

        <fieldset class="files-fieldset">
            <legend>@P["Files.Title"]</legend>
            <p class="muted small">@P["Files.Intro"]</p>
            <NewFilesPanel Rows="rows" Types="docTypes" MaxBytes="@Vault.MaxUploadBytes" OnChanged="() => { fileError = null; }" />
            @if (rows.Count > 0)
            {
                <label>@P["Files.Relation"]
                    <select @bind="linkType" data-files-link>@foreach (var c in QuickDefaults.LinkChoices) { <option value="@c.Value">@c.Label</option> }</select>
                </label>
            }
            @if (fileError is not null) { <p class="error" role="alert" data-files-error>@fileError</p> }
        </fieldset>

        @if (optionalDefs.Count > 0)
        {
            <details class="more-details" data-more-details>
                <summary>@P["PartForm.More"]</summary>
                <div class="grid-form"><AttributeFields Definitions="optionalDefs" Value="attributes" /></div>
            </details>
        }

        @if (errors is { Count: > 0 })
        {
            <ul class="error" role="alert" data-quick-errors>@foreach (var e in errors) { <li>@e</li> }</ul>
        }
        <div class="toolbar">
            <button type="submit" disabled="@busy">@P["Parts.Create"]</button>
            <button type="button" class="secondary" disabled="@busy" data-create-another @onclick="CreateAnotherAsync">@P["PartForm.CreateAnother"]</button>
            <a class="button secondary" href="parts">@C["Cancel"]</a>
        </div>
    </form>
}

@code {
    private const string nameKey = "name";
    private IReadOnlyList<AttributeDefinition>? defs;
    private IReadOnlyList<AttributeDefinition> requiredDefs = [], optionalDefs = [];
    private IReadOnlyList<RefItem> partTypes = [], units = [], sources = [];
    private string name = "", partType = QuickDefaults.PartType, unit = UnitsOfMeasure.Each, source = QuickDefaults.PartSource, description = "";
    private readonly AttributeInput attributes = new();
    private MarkingsInput markings = new();
    private MarkingsDefaultPicker? markingsPicker;
    private readonly Dictionary<string, string> fieldErrors = new(StringComparer.Ordinal);
    private List<string>? errors;
    private bool busy, showKind;
    private readonly List<FileRow> rows = [];
    private IReadOnlyList<RefItem> docTypes = [];
    private string linkType = Keel.Documents.LinkTypes.Describes;
    private string? fileError;

    protected override async Task OnInitializedAsync()
    {
        await using (var conn = await Db.OpenConnectionAsync())
            defs = await AttributeValidator.LoadAsync(conn, null, PartService.ObjectType, CancellationToken.None);
        var active = defs.Where(d => !d.Retired).ToList();
        requiredDefs = [.. active.Where(d => d.Required)];
        optionalDefs = [.. active.Where(d => !d.Required)];
        partTypes = await Refs.ListAsync(RefLists.PartType);
        units = await Refs.ListAsync(RefLists.Unit);
        sources = await Refs.ListAsync(RefLists.PartSource);
        var me = await Users.GetAsync();
        IReadOnlyDictionary<string, string> last = new Dictionary<string, string>();
        try { last = await Last.GetAsync(me); } catch (Exception e) when (e is NpgsqlException or InvalidOperationException) { /* defaults apply */ }
        partType = QuickDefaults.Pick([.. partTypes.Select(t => t.Code)], last, LastChoiceKeys.PartType, QuickDefaults.PartType);
        unit = QuickDefaults.Pick([.. units.Select(t => t.Code)], last, LastChoiceKeys.PartUnit, UnitsOfMeasure.Each);
        source = QuickDefaults.Pick([.. sources.Select(t => t.Code)], last, LastChoiceKeys.PartSource, QuickDefaults.PartSource);
        markings = QuickDefaults.Markings(me);
        docTypes = await Refs.ListAsync(RefLists.DocumentType);
        linkType = QuickDefaults.DefaultLinkType(last);
    }

    private bool Has(string key) => fieldErrors.ContainsKey(key);
    private string? Field(string key) => fieldErrors.GetValueOrDefault(key);
    private static string Label(IReadOnlyList<RefItem> list, string code) => list.FirstOrDefault(i => i.Code == code)?.Label ?? code;

    private Task CreateAsync() => SubmitAsync(another: false);
    private Task CreateAnotherAsync() => SubmitAsync(another: true);

    // Rules the server owns (markings, attribute formats, numbering) are checked there; the form only asks for what the person has not filled in yet, in plain words.
    private bool Check()
    {
        fieldErrors.Clear();
        errors = null;
        fileError = null;
        if (rows.Any(r => string.IsNullOrWhiteSpace(r.Name))) fileError = P["Files.NameRequired"];
        if (string.IsNullOrWhiteSpace(name)) fieldErrors[nameKey] = P["PartForm.NameRequired"];
        foreach (var d in requiredDefs)
            if (!attributes.Values.TryGetValue(d.Name, out var v) || string.IsNullOrWhiteSpace(v))
                fieldErrors[d.Name] = P["PartForm.ValueRequired", d.Label];
        return fieldErrors.Count == 0 && fileError is null;
    }

    private async Task SubmitAsync(bool another)
    {
        if (busy) return;
        if (!Check()) return;
        var m = markings.Effective().ToMarkings();
        if (!m.IsSuccess)
        {
            errors = [.. m.Errors.Select(e => C["Markings.Prefix", e].Value)];
            markingsPicker?.Show();
            return;
        }
        busy = true;
        var me = await Users.GetAsync();
        var outcome = await Parts.CreateAsync(me,
            new CreatePartCommand(name.Trim(), partType, unit, source, m.Value, description, attributes.ToJson(defs!)), CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk)
        {
            errors = outcome.Kind == OutcomeKind.Invalid ? [.. outcome.Errors] : [UiText.Message(outcome)];
            return;
        }
        try
        {
            await Last.SetAsync(me, new Dictionary<string, string>
            { [LastChoiceKeys.PartType] = partType, [LastChoiceKeys.PartUnit] = unit, [LastChoiceKeys.PartSource] = source });
        }
        catch (Exception e) when (e is NpgsqlException or InvalidOperationException) { /* remembering is a convenience */ }
        var created = outcome.Value!;
        var hasModel = rows.Any(r => FileGuess.IsModel(r.File.Name));
        var filesNote = await AddFilesAsync(me, created.Number, m.Value!);
        if (!another) { Nav.NavigateTo($"parts/{Uri.EscapeDataString(created.Number)}{(hasModel && filesNote.Ok ? "?tab=viewer" : "")}"); return; }
        Toasts.Success(P["PartForm.CreatedNext", created.Number, created.Name]);
        name = description = "";
        rows.Clear();
        attributes.Values.Clear();
        await Js.InvokeVoidAsync("focusSelector", "[data-quick-name]");
    }

    // The files chosen on this page become documents of the new part, in one action (one new version of the part). The part already exists by now: what could not
    // be added is said in plain words and can be added again from the part page.
    private async Task<(bool Ok, string? Note)> AddFilesAsync(Subject me, string partNumber, Markings documentMarkings)
    {
        if (rows.Count == 0) return (true, null);
        var streams = new List<Stream>();
        try
        {
            var specs = new List<NewDocumentSpec>();
            foreach (var r in rows)
            {
                var content = r.File.OpenReadStream(Vault.MaxUploadBytes);
                streams.Add(content);
                specs.Add(new NewDocumentSpec(new Keel.Documents.CreateDocumentCommand(r.Name.Trim(), r.Type, documentMarkings), r.File.Name, r.File.ContentType, content, linkType, FileGuess.IsModel(r.File.Name)));
            }
            var result = await Flows.AddNewDocumentsAsync(me, partNumber, specs, CurrentUser.NewCorrelationId());
            var failed = result.Lines.Where(l => !l.Linked).ToList();
            if (result.IsOk && failed.Count == 0) Toasts.Success(P["Files.Done", partNumber, result.Lines.Count]);
            else Toasts.Warning(P["Files.Partial", partNumber, string.Join(" ", failed.Select(l => l.Message).DefaultIfEmpty(result.Message))]);
            try { await Last.SetAsync(me, new Dictionary<string, string> { [LastChoiceKeys.LinkType] = linkType }); }
            catch (Exception e) when (e is NpgsqlException or InvalidOperationException) { /* remembering is a convenience */ }
            return (result.IsOk, result.Message);
        }
        catch (Exception e) when (e is IOException or InvalidOperationException or ArgumentException or Microsoft.JSInterop.JSException)
        {
            Toasts.Warning(P["Files.Partial", partNumber, e.Message]);
            return (false, e.Message);
        }
        finally
        {
            foreach (var st in streams) await st.DisposeAsync();
        }
    }
}
