@* Server paging controls: "Showing 1-50 of 123" and Previous / Next. The page keeps owning the query; this only reports the new offset. *@
@if (Total > 0)
{
    <nav class="toolbar" aria-label="Paging">
        <span class="muted" aria-live="polite">Showing @(Offset + 1)–@Math.Min(Offset + PageSize, Total) of @Total</span>
        <button type="button" class="secondary" disabled="@(Offset == 0)" @onclick="() => OnPage.InvokeAsync(Math.Max(0, Offset - PageSize))">Previous</button>
        <button type="button" class="secondary" disabled="@(Offset + PageSize >= Total)" @onclick="() => OnPage.InvokeAsync(Offset + PageSize)">Next</button>
    </nav>
}

@code {
    [Parameter, EditorRequired] public required long Total { get; set; }
    [Parameter, EditorRequired] public required int Offset { get; set; }
    [Parameter] public int PageSize { get; set; } = 50;
    [Parameter] public EventCallback<int> OnPage { get; set; }
}
