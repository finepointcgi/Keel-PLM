@* The user menu: who is signed in, "My access", the theme and density switchers, lock the session, sign out. A disclosure: the button opens it, Escape or a click
   elsewhere closes it, and focus returns to the button. The choices are saved for the user (server side) and applied at once. *@
@implements IAsyncDisposable
@using Keel.Workspace
@inject ShellState Shell
@inject ShellJs Js
@inject IServiceProvider Services
@inject UiLanguage Language
@inject NavigationManager Nav
@inject IStringLocalizer<ShellStrings> S

<div class="user-menu" @ref="root">
    <button type="button" class="icon-button bordered" id="user-menu-button" aria-haspopup="true" aria-expanded="@(open ? "true" : "false")" aria-controls="user-menu-panel" @onclick="ToggleAsync">
        <Icon Name="user" />
        <span class="label">@DisplayName</span>
        <Icon Name="chevron-down" />
    </button>
    @if (open)
    {
        <div class="user-menu-panel" id="user-menu-panel" role="group" aria-label="@S["UserMenu"]">
            <h2>@DisplayName</h2>
            <a class="menu-item" href="profile" @onclick="Close"><Icon Name="access" /> @S["UserMenu.MyAccess"]</a>
            <div class="group" role="group" aria-labelledby="theme-label">
                <span class="label" id="theme-label">@S["Theme"]</span>
                <div class="segmented">
                    @foreach (var value in Themes)
                    {
                        var v = value;
                        <button type="button" aria-pressed="@(Shell.Preferences.Theme == v ? "true" : "false")" data-theme-choice="@v" @onclick="() => Shell.SetThemeAsync(v)">@S["Theme." + v]</button>
                    }
                </div>
            </div>
            <div class="group" role="group" aria-labelledby="density-label">
                <span class="label" id="density-label">@S["Density"]</span>
                <div class="segmented">
                    @foreach (var value in Densities)
                    {
                        var v = value;
                        <button type="button" aria-pressed="@(Shell.Preferences.Density == v ? "true" : "false")" data-density-choice="@v" @onclick="() => Shell.SetDensityAsync(v)">@S["Density." + v]</button>
                    }
                </div>
            </div>
            <div class="group" role="group" aria-labelledby="simple-label">
                <span class="label" id="simple-label">@S["Navigation"]</span>
                <div class="segmented">
                    <button type="button" aria-pressed="@(Shell.Preferences.SimpleView ? "true" : "false")" data-simple-view-choice="simple" @onclick="() => Shell.SetSimpleViewAsync(true)">@S["Navigation.Simple"]</button>
                    <button type="button" aria-pressed="@(Shell.Preferences.SimpleView ? "false" : "true")" data-simple-view-choice="all" @onclick="() => Shell.SetSimpleViewAsync(false)">@S["Navigation.All"]</button>
                </div>
                <span class="muted small">@S["Navigation.Help"]</span>
            </div>
            <div class="group" role="group" aria-labelledby="language-label">
                <span class="label" id="language-label">@S["Language"]</span>
                <div class="segmented">
                    @foreach (var locale in Language.Available)
                    {
                        var tag = locale.Tag;
                        <button type="button" lang="@(locale.Pseudo ? null : tag)" aria-pressed="@(Language.Tag == tag ? "true" : "false")" data-language-choice="@tag" @onclick="() => ChangeLanguageAsync(tag)">@locale.NativeName</button>
                    }
                </div>
                <span class="muted small">@S["Language.Help"]</span>
            </div>
            <div class="group">
                @if (Lock is { Enabled: true, View: { Phase: SessionPhase.Active } })
                {
                    <button type="button" class="menu-item" data-action="lock-from-menu" @onclick="LockAsync"><Icon Name="lock" /> @S["UserMenu.Lock"]</button>
                }
                <button type="submit" class="menu-item" form="signout-form" data-action="sign-out-menu"><Icon Name="logout" /> @S["SignOut"]</button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] Themes = [ThemeNames.System, ThemeNames.Light, ThemeNames.Dark, ThemeNames.HighContrast];
    private static readonly string[] Densities = [DensityNames.Comfortable, DensityNames.Compact];

    // The language is saved for the person, then the page loads again so the new circuit starts in it (ADR 0057). Only the words change: access, markings and banners do not.
    private async Task ChangeLanguageAsync(string tag)
    {
        if (tag == Language.Tag) return;
        await Shell.SetLanguageAsync(tag);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private SessionLockCoordinator? Lock => Services.GetService<SessionLockCoordinator>();

    private ElementReference root;
    private DotNetObjectReference<UserMenu>? self;
    private bool open, watching;

    [Parameter, EditorRequired] public required string DisplayName { get; set; }

    protected override void OnInitialized() => Shell.Changed += OnShellChanged;

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleAsync()
    {
        if (open) { await CloseAsync(refocus: true); return; }
        open = true;
        StateHasChanged();
        if (!watching)
        {
            watching = true;
            self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("watchDismiss", root, self);
        }
    }

    private void Close() => open = false;

    private async Task CloseAsync(bool refocus)
    {
        open = false;
        if (watching)
        {
            watching = false;
            await Js.InvokeVoidAsync("stopWatchDismiss", root);
        }
        if (refocus) await Js.InvokeVoidAsync("focusSelector", "#user-menu-button");
    }

    [JSInvokable] public async Task Dismiss(string reason)
    {
        var wasOpen = open && reason == "escape";
        await InvokeAsync(async () =>
        {
            await CloseAsync(refocus: false);
            StateHasChanged();
        });
        if (wasOpen) await Js.InvokeVoidAsync("focusSelector", "#user-menu-button");
    }

    private async Task LockAsync()
    {
        await CloseAsync(refocus: false);
        if (Lock is { } coordinator) await coordinator.LockNowAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Shell.Changed -= OnShellChanged;
        if (watching) await Js.InvokeVoidAsync("stopWatchDismiss", root);
        self?.Dispose();
    }
}
