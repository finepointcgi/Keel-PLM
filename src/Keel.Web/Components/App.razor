<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Keel.Web/app.css" />
    <link rel="stylesheet" href="_content/Keel.Web/bom.css" />
    <HeadOutlet @rendermode="Mode" />
</head>
<body>
    <Routes @rendermode="Mode" />
