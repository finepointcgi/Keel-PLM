@using Keel.Workspace
@inject WorkspaceService Workspace
@inject Microsoft.Extensions.Configuration.IConfiguration Config
<!DOCTYPE html>
@* The page shell is rendered by the server for every document load: the user's stored theme and density go into <html> here, so the first paint already has them
   (no inline script, CSP-safe). "system" has no explicit attribute rule: tokens.css follows prefers-color-scheme for it. The same goes for the language of the
   document (ADR 0057): lang names the person's interface language, so screen readers pronounce it right. Right-to-left layouts are not supported yet (dir stays ltr). *@
<html lang="@Lang" dir="ltr" data-theme="@prefs.Theme" data-density="@prefs.Density">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* MudBlazor first: its element rules (a { text-decoration: none }, a { color }) must lose to the Keel design system, which links are underlined by (WCAG link-in-text-block). *@
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/tokens.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/base.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/layout.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/components.css" />
    <link rel="stylesheet" href="_content/Keel.Web/bom.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/awareness.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/visuals.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/model-viewer.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/requirements.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/process.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/styleguide.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/m3.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/mud-keel.css" />
    <link rel="stylesheet" href="_content/Keel.Web/css/simple.css" />
    <HeadOutlet @rendermode="Mode" />
</head>
<body>
    <Routes @rendermode="Mode" />
    <noscript>Keel PLM requires JavaScript.</noscript>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // ADR-0014: interactive server without prerendering, so each page loads (and is audited) exactly once.
    private static readonly IComponentRenderMode Mode = new InteractiveServerRenderMode(prerender: false);

    private UserPreferences prefs = UserPreferences.Default;

    // The pseudo-locale is generated English, so the document says "en" for it (no real language tag exists for it).
    private string Lang
    {
        get
        {
            var tag = Locales.Resolve(prefs.Language, bool.TryParse(Config["Keel:Localization:PseudoLocale"], out var on) && on);
            return tag == Locales.PseudoTag ? Locales.Source : tag;
        }
    }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // The signed-in user's own preference by the subject of the session cookie (a person who is not signed in gets the defaults).
        if (HttpContext?.User.FindFirst("sub")?.Value is { Length: > 0 } sub)
        {
            try { prefs = await Workspace.GetPreferencesForShellAsync(sub); }
            catch (Exception e) when (e is Npgsql.NpgsqlException or InvalidOperationException) { /* defaults: a damaged preference never blocks the shell */ }
        }
    }
}
