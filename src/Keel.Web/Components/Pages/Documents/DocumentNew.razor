@page "/documents/new"
@using Keel.Documents
@using Keel.Documents.Vault
@inject CurrentUser Users
@inject DocumentService Docs
@inject PartService Parts
@inject SimpleFlows Flows
@inject VaultOptions Vault
@inject NavigationManager Nav
@inject IReferenceData Refs
@inject LastChoiceStore Last
@inject ToastService Toasts
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C
@inject UiLanguage Language

@* A blank form shows no controlled data; the markings being entered appear on the created document. The optional "Link to part" links the new document to a part in the same step (ADR 0061). *@
<PageFrame Banner="@UiText.Unclassified" Title="@P["DocNew.Title"]">
    <form class="stack" @onsubmit="Create" novalidate>
        <div class="grid-form">
            <label class="wide">
                @C["Field.Name"]
                <input @bind="name" @bind:event="oninput" maxlength="200" aria-required="true" aria-invalid="@(nameError is null ? null : "true")" aria-describedby="@(nameError is null ? null : "doc-name-error")" />
                @if (nameError is not null) { <span id="doc-name-error" class="error" role="alert">@nameError</span> }
            </label>
            <label>
                @C["Column.Type"]
                <InputSelect @bind-Value="documentType">@foreach (var t in docTypes) { <option value="@t.Code">@t.Label</option> }</InputSelect>
            </label>
            <label class="wide">@C["Field.DescriptionOptional"] <InputTextArea @bind-Value="description" rows="2" maxlength="4000" /></label>
            <label class="wide">
                @P["DocNew.File", DocumentUi.Size(Vault.MaxUploadBytes)]
                <InputFile OnChange="Pick" />
            </label>
        </div>
        <section class="panel" aria-labelledby="link-part-heading" data-link-to-part>
            <h2 id="link-part-heading" class="h3">@P["DocNew.LinkPart"]</h2>
            <ObjectPicker Id="link-part" Label="@P["DocNew.Part"]" Noun="parts" Placeholder="@P["DocNew.PartPlaceholder"]" Search="q => Flows.FindPartsAsync(me!, q)" @bind-Selected="part" />
            @if (part is not null)
            {
                <label>
                    @P["DocNew.Related"]
                    <select @bind="linkType" data-link-type>
                        @foreach (var c in QuickDefaults.LinkChoices) { <option value="@c.Value">@P.Or("DocNew.Link." + c.Value + ".Label", c.Label)</option> }
                    </select>
                    <span class="muted small">@(P.Or("DocNew.Link." + linkType + ".Help", QuickDefaults.LinkChoices.First(c => c.Value == linkType).Help))</span>
                </label>
                <p class="muted small">@P["DocNew.LinkNote"]</p>
            }
        </section>
        <MarkingsDefaultPicker @ref="markingsPicker" Value="markings" />
        @if (errors is not null)
        {
            <ul class="error" role="alert">@foreach (var e in errors) { <li>@e</li> }</ul>
        }
        <div class="toolbar">
            <button type="submit" disabled="@busy">@(busy && file is not null ? P["DocNew.Uploading"] : P["Documents.Create"])</button>
            <a class="button secondary" href="documents">@C["Cancel"]</a>
        </div>
    </form>
</PageFrame>

@code {
    [SupplyParameterFromQuery(Name = "part")] public string? PartParam { get; set; }

    private string name = "", documentType = QuickDefaults.DocumentType, description = "", linkType = LinkTypes.Describes;
    private IReadOnlyList<RefItem> docTypes = []; // 2.2: administrator data
    private MarkingsInput markings = new();
    private MarkingsDefaultPicker? markingsPicker;
    private Subject? me;
    private PickItem? part;
    private IBrowserFile? file;
    private IReadOnlyList<string>? errors;
    private string? nameError;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        me = await Users.GetAsync();
        docTypes = await Refs.ListAsync(RefLists.DocumentType);
        IReadOnlyDictionary<string, string> last = new Dictionary<string, string>();
        try { last = await Last.GetAsync(me); } catch (Exception e) when (e is Npgsql.NpgsqlException or InvalidOperationException) { /* defaults apply */ }
        documentType = QuickDefaults.Pick([.. docTypes.Select(t => t.Code)], last, LastChoiceKeys.DocumentType, QuickDefaults.DocumentType);
        linkType = QuickDefaults.DefaultLinkType(last);
        markings = QuickDefaults.Markings(me);
        if (!string.IsNullOrWhiteSpace(PartParam)) // coming from a part page: the part is already chosen
        {
            var found = await Parts.GetAsync(me, PartParam.Trim().ToUpperInvariant(), null, CurrentUser.NewCorrelationId());
            if (found.IsOk) part = new PickItem(found.Value!.Number, found.Value.Name, found.Value.Banner);
        }
    }

    private void Pick(InputFileChangeEventArgs e) => file = e.File;

    private async Task Create()
    {
        if (busy) return;
        errors = null;
        nameError = string.IsNullOrWhiteSpace(name) ? P["DocNew.NameRequired"].Value : null;
        if (nameError is not null) return;
        var m = markings.Effective().ToMarkings();
        if (!m.IsSuccess) { errors = [.. m.Errors.Select(e => C["Markings.Prefix", e].Value)]; markingsPicker?.Show(); return; }
        busy = true;
        // The browser streams the file over the circuit straight into the vault; it is never buffered whole.
        await using var content = file?.OpenReadStream(Vault.MaxUploadBytes);
        var upload = file is null ? null : new FileUpload(file.Name, file.ContentType, content!);
        var (doc, link) = await Flows.CreateDocumentAndLinkAsync(me!, new CreateDocumentCommand(name.Trim(), documentType, m.Value, description), upload, part?.Number, linkType,
            CurrentUser.NewCorrelationId());
        busy = false;
        if (!doc.IsOk)
        {
            errors = doc.Kind == OutcomeKind.Invalid ? doc.Errors : [UiText.Message(doc, C)];
            return;
        }
        try
        {
            var map = new Dictionary<string, string> { [LastChoiceKeys.DocumentType] = documentType };
            if (part is not null) map[LastChoiceKeys.LinkType] = linkType;
            await Last.SetAsync(me!, map);
        }
        catch (Exception e) when (e is Npgsql.NpgsqlException or InvalidOperationException) { /* remembering is a convenience */ }
        if (link is not null)
        {
            if (link.IsOk) Toasts.Success(link.Message);
            else Toasts.Warning(P["DocNew.LinkFailed", doc.Value!.Number, part!.Number, link.Message].Value);
        }
        Nav.NavigateTo($"documents/{Uri.EscapeDataString(doc.Value!.Number)}");
    }
}
