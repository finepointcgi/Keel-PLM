@page "/documents/{Number}"
@using Keel.Documents
@using Keel.Documents.Vault
@inject CurrentUser Users
@inject DocumentService Docs
@inject VaultOptions Vault
@inject NpgsqlDataSource Db
@using Npgsql

<PageFrame Banner="@(doc?.Banner ?? UiText.Unclassified)" Title="Document">
    @if (notFound)
    {
        <p class="error" role="alert">Document @Number was not found, or you are not authorized to see it.</p>
    }
    else if (doc is not null)
    {
        var d = doc;
        <article class="stack">
            <header class="part-header">
                <div>
                    <h2>@d.Number · @d.Name</h2>
                    <p class="muted">@d.DocumentType · created by @d.CreatedBy</p>
                </div>
                <div class="badges">
                    <span class="badge">Version @d.Iteration.Label</span>
                    <span class="badge state-@d.Revision.State.ToLowerInvariant()">@d.Revision.StateLabel</span>
                    @if (d.Revision.IsLocked) { <span class="badge">Locked</span> }
                </div>
            </header>

            @if (d.Revisions.Count > 1)
            {
                <nav class="toolbar" aria-label="Revisions">
                    @foreach (var r in d.Revisions)
                    {
                        <a href="@($"documents/{Uri.EscapeDataString(d.Number)}{(r.IsLatest ? "" : $"?revision={r.Revision}")}")" aria-current="@(r.Id == d.Revision.Id ? "page" : null)">Rev @r.Revision (@r.StateLabel)</a>
                    }
                </nav>
            }

            @if (error is not null) { <p class="error" role="alert">@error</p> }
            @if (!d.Permissions.CanModify)
            {
                <p class="muted">Read only: @string.Join(" ", d.Permissions.ModifyDeniedReasons.Select(UiText.Reason))</p>
            }

            @if (d.Revision.IsLatest)
            {
                var co = d.Checkout;
                <section class="panel">
                    <h3>Work</h3>
                    @if (co is not null && !co.IsMine)
                    {
                        <p>Checked out by @(co.UserName ?? co.UserId) since @UiText.Utc(co.CheckedOutAt).</p>
                    }
                    <div class="toolbar">
                        @if (co is null && d.Permissions.CanModify && !d.Revision.IsLocked)
                        {
                            <button type="button" disabled="@busy" @onclick="() => Run(s => Docs.CheckOutAsync(s, Number, Corr()))">Check out</button>
                        }
                        @if (co is not null && (co.IsMine || d.Permissions.CanAdminister))
                        {
                            <button type="button" class="secondary" disabled="@busy" @onclick="() => Run(s => Docs.UndoCheckOutAsync(s, Number, Corr()))">Undo check-out</button>
                        }
                        @foreach (var t in d.Transitions)
                        {
                            <button type="button" class="secondary" disabled="@(!t.Allowed || busy)" title="@t.Reason"
                                    @onclick="() => Run(s => Docs.SetStateAsync(s, Number, t.To, null, false, Corr()))">Move to @t.Label</button>
                        }
                    </div>
                    @foreach (var t in d.Transitions.Where(t => !t.Allowed && t.Reason is not null))
                    {
                        <p class="muted small">@t.Label: @t.Reason</p>
                    }

                    @if (co?.IsMine == true)
                    {
                        <div class="stack">
                            <p class="muted">You have this document checked out. Changes stay private until you check in.</p>
                            <label class="grid-form">Description <textarea rows="3" maxlength="4000" @bind="workingDescription"></textarea></label>
                            <h4>Working files</h4>
                            <DocumentFileList Files="co.Files ?? []" OnRemove="RemoveFile" Busy="busy" Empty="The working copy has no files." />
                            <div class="toolbar">
                                <select aria-label="File role" @bind="uploadRole">
                                    <option value="primary">Primary (replaces the current primary)</option>
                                    <option value="attachment">Attachment</option>
                                </select>
                                <InputFile OnChange="Upload" disabled="@busy" aria-label="Add file" />
                                @if (uploading is not null) { <span class="muted">Uploading @uploading…</span> }
                            </div>
                            <div class="toolbar">
                                <button type="button" class="secondary" disabled="@busy" @onclick="SaveWorkingCopy">Save working copy</button>
                                <input aria-label="Check-in comment" placeholder="Check-in comment" class="grow" @bind="comment" />
                                <button type="button" disabled="@busy" @onclick="CheckIn">Check in</button>
                            </div>
                        </div>
                    }

                    @if (d.Permissions.CanAdminister)
                    {
                        <details class="admin">
                            <summary>Administrator: set state</summary>
                            <div class="toolbar">
                                <select aria-label="Target state" @bind="overrideState">
                                    @foreach (var s in lifecycleStates) { <option value="@s.State">@s.Label</option> }
                                </select>
                                <input aria-label="Override reason" placeholder="Reason (required, audited)" class="grow" @bind="overrideReason" />
                                <button type="button" disabled="@(busy || overrideState == d.Revision.State)"
                                        @onclick="() => Run(s => Docs.SetStateAsync(s, Number, overrideState, overrideReason, true, Corr()))">Set state</button>
                            </div>
                        </details>
                    }
                </section>
            }

            <section class="panel">
                <h3>Iteration @d.Iteration.Label</h3>
                <p>@(string.IsNullOrEmpty(d.Iteration.Description) ? "No description" : d.Iteration.Description)</p>
                @if (!d.Permissions.CanDownload) { <p class="muted">You may view this document but not download its files.</p> }
                <DocumentFileList Files="d.Iteration.Files" DownloadNumber="@(d.Permissions.CanDownload ? d.Number : null)" Empty="No files yet." />
                <p class="muted small">Downloads are marked: PDFs are stamped with the banner and notices on every page; other files arrive in a ZIP with a marking cover sheet.</p>
            </section>

            <section class="panel">
                <h3>Security markings</h3>
                @if (editMarkings is null)
                {
                    var m = d.Markings;
                    <dl class="facts">
                        <dt>Export jurisdiction</dt>
                        <dd>@(m.ExportJurisdiction switch { ExportJurisdiction.Itar => $"ITAR, USML {m.UsmlCategory}", ExportJurisdiction.Ear => $"EAR, ECCN {m.Eccn}", _ => "None" })</dd>
                        <dt>CUI categories</dt><dd>@(m.CuiCategories.IsEmpty ? "None" : string.Join(", ", m.CuiCategories))</dd>
                        <dt>Distribution</dt><dd>Statement @m.DistributionStatement@(m.ControllingOffice is null ? "" : $": {m.DistributionReason}; controlling office {m.ControllingOffice}")</dd>
                        <dt>Program</dt><dd>@(m.Program ?? "None")</dd>
                        <dt>Owning organization</dt><dd>@m.OwningOrg</dd>
                        <dt>Export authorizations</dt><dd>@(m.ExportAuthorizations.IsEmpty ? "None" : string.Join(", ", m.ExportAuthorizations))</dd>
                    </dl>
                    @if (d.Permissions.CanModify && d.Revision.IsLatest && !d.Revision.IsLocked)
                    {
                        <button type="button" class="secondary" @onclick="() => editMarkings = MarkingsInput.From(d.Markings)">Change markings</button>
                    }
                }
                else
                {
                    <div class="stack">
                        <div class="grid-form">
                            <MarkingsFields Value="editMarkings" />
                            <label class="wide">Reason for change (required, audited) <input @bind="markingsReason" /></label>
                        </div>
                        <div class="toolbar">
                            <button type="button" disabled="@busy" @onclick="SaveMarkings">Save markings</button>
                            <button type="button" class="secondary" @onclick="() => editMarkings = null">Cancel</button>
                        </div>
                    </div>
                }
            </section>

            <section class="panel">
                <h3>Used by parts</h3>
                @if (parts is null || parts.Parts.Count == 0)
                {
                    <p class="muted">No part's latest iteration links to this document.</p>
                }
                else
                {
                    <div class="table-wrap"><table class="data">
                        <thead><tr><th scope="col">Link</th><th scope="col">Part</th><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Markings</th></tr></thead>
                        <tbody>
                            @foreach (var p in parts.Parts)
                            {
                                <tr>
                                    <td>@DocumentUi.LinkTypeLabel(p.LinkType)</td>
                                    @if (p.Redacted)
                                    {
                                        <td colspan="4" class="muted redacted">Restricted part: you are not authorized to see it.</td>
                                    }
                                    else
                                    {
                                        <td><a href="parts/@Uri.EscapeDataString(p.PartNumber!)">@p.PartNumber</a></td>
                                        <td>@p.PartName</td>
                                        <td>@p.IterationLabel</td>
                                        <td><MarkingChip Text="@(p.Banner ?? "")" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </section>

            <section class="panel">
                <h3>History</h3>
                <div class="table-wrap"><table class="data">
                    <thead><tr><th scope="col">Version</th><th scope="col">Checked in (UTC)</th><th scope="col">By</th><th scope="col">Comment</th><th scope="col">Files</th></tr></thead>
                    <tbody>
                        @foreach (var h in d.History)
                        {
                            <tr>
                                <td>@h.Label</td><td>@UiText.Utc(h.CreatedAt)</td><td>@h.CreatedBy</td><td>@h.Comment</td>
                                <td>
                                    @foreach (var f in h.Files)
                                    {
                                        @if (d.Permissions.CanDownload)
                                        {
                                            <a href="@DocumentUi.DownloadUrl(d.Number, f.Id)" download>@f.FileName</a><br />
                                        }
                                        else
                                        {
                                            @f.FileName<br />
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </section>
        </article>
    }
</PageFrame>

@code {
    [Parameter] public required string Number { get; set; }
    [SupplyParameterFromQuery] public string? Revision { get; set; }

    private DocumentDetail? doc;
    private DocumentPartLinks? parts;
    private IReadOnlyList<LifecycleState> lifecycleStates = [];
    private bool notFound, busy;
    private string? error, uploading;
    private string workingDescription = "", comment = "", overrideState = "", overrideReason = "", markingsReason = "", uploadRole = FileRoles.Primary;
    private MarkingsInput? editMarkings;

    private static string Corr() => CurrentUser.NewCorrelationId();

    protected override async Task OnParametersSetAsync()
    {
        var subject = await Users.GetAsync();
        var outcome = await Docs.GetAsync(subject, Number, Revision, Corr());
        // 2.2: the document's own lifecycle version (versions are data)
        await using (var conn = await Db.OpenConnectionAsync())
            lifecycleStates = (await Lifecycle.LoadAsync(conn, null, outcome.Value?.LifecycleId ?? DocumentService.DefaultLifecycle, CancellationToken.None))?.States ?? [];
        notFound = !outcome.IsOk;
        Apply(outcome.Value);
        if (outcome.IsOk)
            parts = (await Docs.GetDocumentPartsAsync(subject, Number, Corr())).Value;
    }

    private void Apply(DocumentDetail? d)
    {
        doc = d;
        if (d is null) return;
        overrideState = d.Revision.State;
        if (d.Checkout?.IsMine == true) workingDescription = d.Checkout.Description ?? "";
    }

    private async Task<bool> Run(Func<Subject, Task<Outcome<DocumentDetail>>> op)
    {
        busy = true;
        error = null;
        var outcome = await op(await Users.GetAsync());
        busy = false;
        if (outcome.IsOk) { Apply(outcome.Value); return true; }
        error = UiText.Message(outcome);
        return false;
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        uploading = file.Name;
        // Streams from the browser over the circuit straight into the vault.
        await using var content = file.OpenReadStream(Vault.MaxUploadBytes);
        var role = uploadRole;
        await Run(s => Docs.UploadFileAsync(s, Number, role, new FileUpload(file.Name, file.ContentType, content), Corr()));
        uploading = null;
    }

    private Task RemoveFile(Guid fileId) => Run(s => Docs.RemoveFileAsync(s, Number, fileId, Corr()));

    private Task SaveWorkingCopy() => Run(s => Docs.UpdateWorkingCopyAsync(s, Number, workingDescription, Corr()));

    // Check-in saves the open working copy first so unsaved edits are never silently dropped.
    private async Task CheckIn()
    {
        if (await Run(s => Docs.UpdateWorkingCopyAsync(s, Number, workingDescription, Corr())))
        {
            var c = comment;
            if (await Run(s => Docs.CheckInAsync(s, Number, c, Corr()))) comment = "";
        }
    }

    private async Task SaveMarkings()
    {
        var m = editMarkings!.Effective().ToMarkings();
        if (!m.IsSuccess) { error = string.Join(" ", m.Errors); return; }
        if (await Run(s => Docs.ChangeMarkingsAsync(s, Number, m.Value, markingsReason, Corr()))) { editMarkings = null; markingsReason = ""; }
    }
}
