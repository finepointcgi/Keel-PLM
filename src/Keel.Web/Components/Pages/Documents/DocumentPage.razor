@page "/documents/{Number}"
@using Keel.Documents
@using Keel.Documents.Vault
@using Keel.Web.Components.Pages.Cad
@using Keel.Web.Components.Pages.Workflow
@inject CurrentUser Users
@inject DocumentService Docs
@inject VaultOptions Vault
@inject NpgsqlDataSource Db
@inject ToastService Toasts
@inject NavigationManager Nav
@using Npgsql

<PageFrame Banner="@PageBanner" Title="@PageTitle" Crumbs="@Crumbs" Header="@(doc is not null ? HeaderFragment(doc) : null)">
    @if (notFound)
    {
        <p class="error" role="alert">Document @Number was not found, or you are not authorized to see it.</p>
    }
    else if (doc is not null)
    {
        var d = doc;
        var co = d.Checkout;
        <article class="stack">
            <ViewTracker Kind="@ObjectKinds.Document" Number="@d.Number" />
            <CommentCount Kind="@ObjectKinds.Document" Number="@d.Number" OnCount="c => commentCount = c" />
            <UnsavedGuard Dirty="@(co?.IsMine == true && workingDescription != (co.Description ?? ""))" />

            <div class="action-bar" role="toolbar" aria-label="Document actions">
                @if (d.Revision.IsLatest)
                {
                    @if (co is null && d.Permissions.CanModify && !d.Revision.IsLocked)
                    {
                        <button type="button" disabled="@busy" @onclick='() => Run(s => Docs.CheckOutAsync(s, Number, Corr()), "Checked out. Your changes stay private until you check in.")'>Check out</button>
                    }
                    @if (co?.IsMine == true)
                    {
                        <button type="button" class="secondary" disabled="@busy" @onclick="SaveWorkingCopy">Save working copy</button>
                        <input aria-label="Check-in comment" placeholder="Check-in comment" class="grow" @bind="comment" />
                        <button type="button" disabled="@busy" @onclick="CheckIn">Check in</button>
                    }
                    @if (co is not null && (co.IsMine || d.Permissions.CanAdminister))
                    {
                        <button type="button" class="secondary" disabled="@busy" @onclick="() => confirmUndo = true">Undo check-out</button>
                    }
                    @foreach (var t in d.Transitions)
                    {
                        <button type="button" class="secondary" disabled="@(!t.Allowed || busy)" title="@t.Reason"
                                @onclick='() => Run(s => Docs.SetStateAsync(s, Number, t.To, null, false, Corr()), $"Moved to {t.Label}.")'>Move to @t.Label</button>
                    }
                }
            </div>

            @if (error is not null) { <p class="error" role="alert">@error</p> }
            @if (co is not null && !co.IsMine)
            {
                <p class="notice">Checked out by @(co.UserName ?? co.UserId) since @UiText.Utc(co.CheckedOutAt).</p>
            }
            @if (!d.Permissions.CanModify)
            {
                <p class="muted">Read only: @string.Join(" ", d.Permissions.ModifyDeniedReasons.Select(UiText.Reason))</p>
            }
            @foreach (var t in d.Transitions.Where(t => !t.Allowed && t.Reason is not null))
            {
                <p class="muted small">@t.Label: @t.Reason</p>
            }

            <TabSet Tabs="@AwarenessTabs.Append(Tabs, commentCount)" Active="@tab" ActiveChanged="id => { tab = id; timelineBanner = null; cadBanner = null; }" Label="Document sections">
                @switch (tab)
                {
                    case "overview":
                        <div class="stack">
                            @if (co?.IsMine == true)
                            {
                                <section class="panel" aria-labelledby="work-heading">
                                    <h3 id="work-heading">Edit working copy</h3>
                                    <p class="muted">You have this document checked out. Changes stay private until you check in.</p>
                                    <label class="grid-form">Description <textarea rows="3" maxlength="4000" @bind="workingDescription"></textarea></label>
                                    <h4>Working files</h4>
                                    <DocumentFileList Files="co.Files ?? []" OnRemove="RemoveFile" Busy="busy" Empty="The working copy has no files." />
                                    <div class="toolbar">
                                        <select aria-label="File role" @bind="uploadRole">
                                            <option value="primary">Primary (replaces the current primary)</option>
                                            <option value="attachment">Attachment</option>
                                        </select>
                                        <InputFile OnChange="Upload" disabled="@busy" aria-label="Add file" />
                                        @if (uploading is not null) { <span class="muted">Uploading @uploading…</span> }
                                    </div>
                                </section>
                            }
                            <section class="panel" aria-labelledby="iteration-heading">
                                <h3 id="iteration-heading">Version @d.Iteration.Label</h3>
                                <p>@(string.IsNullOrEmpty(d.Iteration.Description) ? "No description" : d.Iteration.Description)</p>
                                @if (!d.Permissions.CanDownload) { <p class="muted">You may view this document but not download its files.</p> }
                                <DocumentFileList Files="d.Iteration.Files" DownloadNumber="@(d.Permissions.CanDownload ? d.Number : null)" Empty="No files yet." />
                                <p class="muted small">Downloads are marked: PDFs are stamped with the banner and notices on every page; other files arrive in a ZIP with a marking cover sheet.</p>
                            </section>
                            @if (d.Permissions.CanAdminister && d.Revision.IsLatest)
                            {
                                <details class="admin">
                                    <summary>Administrator: set state</summary>
                                    <div class="toolbar">
                                        <select aria-label="Target state" @bind="overrideState">
                                            @foreach (var s in lifecycleStates) { <option value="@s.State">@s.Label</option> }
                                        </select>
                                        <button type="button" class="secondary" disabled="@(busy || overrideState == d.Revision.State)" @onclick="() => confirmOverride = true">Set state…</button>
                                    </div>
                                </details>
                            }
                        </div>
                        break;
                    case "cad":
                        <CadPackagePanel Number="@d.Number" OnBanner="b => cadBanner = b" />
                        break;
                    case "usedby":
                        <section class="panel" aria-labelledby="usedby-heading">
                            <h3 id="usedby-heading">Used by parts</h3>
                            @if (parts is null || parts.Parts.Count == 0)
                            {
                                <EmptyState Title="Not used by any part" IconName="part">No part's latest version links to this document. Link it from the Documents tab of a part that is checked out.</EmptyState>
                            }
                            else
                            {
                                <div class="table-wrap"><table class="data">
                                    <thead><tr><th scope="col">Link</th><th scope="col">Part</th><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Markings</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in parts.Parts)
                                        {
                                            <tr>
                                                <td>@DocumentUi.LinkTypeLabel(p.LinkType)</td>
                                                @if (p.Redacted)
                                                {
                                                    <td colspan="4" class="muted redacted">Restricted part: you are not authorized to see it.</td>
                                                }
                                                else
                                                {
                                                    <td><a href="parts/@Uri.EscapeDataString(p.PartNumber!)">@p.PartNumber</a></td>
                                                    <td>@p.PartName</td>
                                                    <td>@p.IterationLabel</td>
                                                    <td><MarkingChip Text="@(p.Banner ?? "")" /></td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </section>
                        break;
                    case "review":
                        @* 7.6 (ADR-0033): review, e-signature and release through the workflow engine, exactly as for parts. *@
                        <DocumentReviewPanel Number="@d.Number" State="@d.Revision.State" Latest="@d.Revision.IsLatest" CheckedOut="@(d.Checkout is not null)"
                                             CanModify="@d.Permissions.CanModify" HasPrimary="@d.Iteration.Files.Any(f => f.Role == FileRoles.Primary)" OnChanged="Reload" />
                        break;
                    case "trace":
                        <Keel.Web.Components.Pages.Requirements.ObjectTracePanel Kind="document" Key="@d.Number" OnBanner="b => traceBanner = b" />
                        break;
                    case "timeline":
                        @* UX-3: the life of the document; the page banner also covers the other objects its entries name. *@
                        <TimelinePanel ObjectType="document" Key="@d.Number" Version="@($"{d.Revision.Revision}.{d.Iteration.Iteration}.{d.Revision.State}")"
                                       OnShown="m => timelineBanner = m.Count == 0 ? null : Markings.AggregateBanner(m)" />
                        break;
                    case "history":
                        <section class="panel" aria-labelledby="history-heading">
                            <h3 id="history-heading">Version history</h3>
                            <div class="table-wrap"><table class="data">
                                <thead><tr><th scope="col">Version</th><th scope="col">Checked in (UTC)</th><th scope="col">By</th><th scope="col">Comment</th><th scope="col">Files</th></tr></thead>
                                <tbody>
                                    @foreach (var h in d.History)
                                    {
                                        <tr>
                                            <td>@h.Label</td><td>@UiText.Utc(h.CreatedAt)</td><td>@h.CreatedBy</td><td>@h.Comment</td>
                                            <td>
                                                @foreach (var f in h.Files)
                                                {
                                                    @if (d.Permissions.CanDownload)
                                                    {
                                                        <a href="@DocumentUi.DownloadUrl(d.Number, f.Id)" download>@f.FileName</a><br />
                                                    }
                                                    else
                                                    {
                                                        @f.FileName<br />
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        </section>
                        break;
                    case "security":
                        <section class="panel" aria-labelledby="markings-heading">
                            <h3 id="markings-heading">Security markings</h3>
                            @if (editMarkings is null)
                            {
                                var m = d.Markings;
                                <dl class="facts">
                                    <dt>Export jurisdiction</dt>
                                    <dd>@(m.ExportJurisdiction switch { ExportJurisdiction.Itar => $"ITAR, USML {m.UsmlCategory}", ExportJurisdiction.Ear => $"EAR, ECCN {m.Eccn}", _ => "None" })</dd>
                                    <dt>CUI categories</dt><dd>@(m.CuiCategories.IsEmpty ? "None" : string.Join(", ", m.CuiCategories))</dd>
                                    <dt>Distribution</dt><dd>Statement @m.DistributionStatement@(m.ControllingOffice is null ? "" : $": {m.DistributionReason}; controlling office {m.ControllingOffice}")</dd>
                                    <dt>Program</dt><dd>@(m.Program ?? "None")</dd>
                                    <dt>Owning organization</dt><dd>@m.OwningOrg</dd>
                                    <dt>Export authorizations</dt><dd>@(m.ExportAuthorizations.IsEmpty ? "None" : string.Join(", ", m.ExportAuthorizations))</dd>
                                </dl>
                                @if (d.Permissions.CanModify && d.Revision.IsLatest && !d.Revision.IsLocked)
                                {
                                    <button type="button" class="secondary" @onclick="() => editMarkings = MarkingsInput.From(d.Markings)">Change markings</button>
                                }
                            }
                            else
                            {
                                <div class="stack">
                                    <div class="grid-form">
                                        <MarkingsFields Value="editMarkings" />
                                        <label class="wide">Reason for change (required, audited) <input @bind="markingsReason" /></label>
                                    </div>
                                    <div class="toolbar">
                                        <button type="button" disabled="@busy" @onclick="SaveMarkings">Save markings</button>
                                        <button type="button" class="secondary" @onclick="() => editMarkings = null">Cancel</button>
                                    </div>
                                </div>
                            }
                        </section>
                        break;
                    case "activity":
                        <ActivityFeed Kind="@ObjectKinds.Document" Number="@d.Number" />
                        break;
                    case "comments":
                        <CommentThread Kind="@ObjectKinds.Document" Number="@d.Number" OnCount="c => commentCount = c" />
                        break;
                }
            </TabSet>
        </article>

        <ConfirmDialog @bind-Open="confirmUndo" Title="Undo check-out?" Destructive="true" ConfirmText="Undo check-out" OnConfirm='_ => Run(s => Docs.UndoCheckOutAsync(s, Number, Corr()), "Check-out undone. Unsaved changes were discarded.")'>
            <p>The working copy of @d.Number is discarded: edits and files you have not checked in are lost. The last checked-in version stays as it is.</p>
        </ConfirmDialog>
        <ConfirmDialog @bind-Open="confirmOverride" Title="@($"Set the state to {lifecycleStates.FirstOrDefault(s => s.State == overrideState)?.Label ?? overrideState}?")" Destructive="true" ConfirmText="Set state"
                       ReasonLabel="Reason for this override" ReasonRequired="true"
                       OnConfirm='reason => Run(s => Docs.SetStateAsync(s, Number, overrideState, reason, true, Corr()), "State set.")'>
            <p>This bypasses the normal steps. The reason and your name are recorded in the audit log.</p>
        </ConfirmDialog>
    }
    else
    {
        <Skeleton Lines="6" Label="Loading the document" />
    }
</PageFrame>

@code {
    [Parameter] public required string Number { get; set; }
    [SupplyParameterFromQuery] public string? Revision { get; set; }

    private string? seenUri; // the address the tab was last taken from (GAP-A-4)

    private static readonly string[] TabIds = ["overview", "usedby", "cad", "history", "review", "timeline", "security", "trace", .. AwarenessTabs.Ids];
    private static readonly IReadOnlyList<TabInfo> Tabs = [new("overview", "Overview"), new("usedby", "Used by"), new("cad", "CAD"), new("history", "History"), new("review", "Review & release"), new("timeline", "Timeline"), new("security", "Security markings"), new("trace", "Trace")];
    private string PageBanner => BannerMerge.Union(doc?.Banner ?? UiText.Unclassified, timelineBanner, tab == "cad" ? cadBanner : null, tab == "trace" ? traceBanner : null);
    private string? cadBanner; // banner of the CAD documents the CAD tab names (ADR-0035)
    private string? timelineBanner; // banner of the objects the timeline entries name (UX-3)
    private string? traceBanner; // banner of the requirements the Trace tab names (8.3)

    private DocumentDetail? doc;
    private DocumentPartLinks? parts;
    private IReadOnlyList<LifecycleState> lifecycleStates = [];
    private bool notFound, busy, confirmUndo, confirmOverride;
    private string? error, uploading;
    private string tab = "overview";
    private int? commentCount; // number of comments, shown on the Comments tab (UX-4)
    private string workingDescription = "", comment = "", overrideState = "", markingsReason = "", uploadRole = FileRoles.Primary;
    private MarkingsInput? editMarkings;

    private string PageTitle => doc is null ? "Document" : $"{doc.Number} · {doc.Name}";
    private IReadOnlyList<Crumb> Crumbs => [new("Documents", "documents"), new(doc?.Number ?? Number)];

    private RenderFragment HeaderFragment(DocumentDetail d) => @<ObjectHeader Title="@PageTitle" Banner="@d.Banner" Subtitle="@($"{d.DocumentType} · created by {d.CreatedBy}")">
        <Badges>
            <span class="badge">Version @d.Iteration.Label</span>
            <span class="badge state-@d.Revision.State.ToLowerInvariant()">@d.Revision.StateLabel</span>
            @if (d.Revision.IsLocked) { <span class="badge">Locked</span> }
            <FavoriteButton Kind="@ObjectKinds.Document" Number="@d.Number" />
            <WatchButton Kind="@ObjectKinds.Document" Number="@d.Number" />
        </Badges>
        <Steps>
            <Stepper States="lifecycleStates" Current="@d.Revision.State" Reachable="@(d.Transitions.Where(t => t.Allowed).Select(t => t.To).ToHashSet())" Label="Document lifecycle" />
        </Steps>
        <ChildContent>
            @if (d.Revisions.Count > 1)
            {
                <nav class="toolbar" aria-label="Revisions">
                    @foreach (var r in d.Revisions)
                    {
                        <a href="@($"documents/{Uri.EscapeDataString(d.Number)}{(r.IsLatest ? "" : $"?revision={r.Revision}")}")" aria-current="@(r.Id == d.Revision.Id ? "page" : null)">Rev @r.Revision (@r.StateLabel)</a>
                    }
                </nav>
            }
        </ChildContent>
    </ObjectHeader>;

    private static string Corr() => CurrentUser.NewCorrelationId();

    protected override async Task OnParametersSetAsync()
    {
        tab = TabSet.OnNavigation(Nav.Uri, ref seenUri, TabIds, tab);
        var subject = await Users.GetAsync();
        var outcome = await Docs.GetAsync(subject, Number, Revision, Corr());
        // 2.2: the document's own lifecycle version (versions are data)
        await using (var conn = await Db.OpenConnectionAsync())
            lifecycleStates = (await Lifecycle.LoadAsync(conn, null, outcome.Value?.LifecycleId ?? DocumentService.DefaultLifecycle, CancellationToken.None))?.States ?? [];
        notFound = !outcome.IsOk;
        Apply(outcome.Value);
        if (outcome.IsOk)
            parts = (await Docs.GetDocumentPartsAsync(subject, Number, Corr())).Value;
    }

    private async Task Reload() => await OnParametersSetAsync();

    private void Apply(DocumentDetail? d)
    {
        doc = d;
        if (d is null) return;
        overrideState = d.Revision.State;
        if (d.Checkout?.IsMine == true) workingDescription = d.Checkout.Description ?? "";
    }

    private async Task<bool> Run(Func<Subject, Task<Outcome<DocumentDetail>>> op, string? success = null)
    {
        busy = true;
        error = null;
        var outcome = await op(await Users.GetAsync());
        busy = false;
        if (outcome.IsOk)
        {
            Apply(outcome.Value);
            if (success is not null) Toasts.Success(success);
            return true;
        }
        error = UiText.Message(outcome);
        return false;
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        uploading = file.Name;
        // Streams from the browser over the circuit straight into the vault.
        await using var content = file.OpenReadStream(Vault.MaxUploadBytes);
        var role = uploadRole;
        await Run(s => Docs.UploadFileAsync(s, Number, role, new FileUpload(file.Name, file.ContentType, content), Corr()));
        uploading = null;
    }

    private Task RemoveFile(Guid fileId) => Run(s => Docs.RemoveFileAsync(s, Number, fileId, Corr()));

    private Task SaveWorkingCopy() => Run(s => Docs.UpdateWorkingCopyAsync(s, Number, workingDescription, Corr()), "Working copy saved.");

    // Check-in saves the open working copy first so unsaved edits are never silently dropped.
    private async Task CheckIn()
    {
        if (await Run(s => Docs.UpdateWorkingCopyAsync(s, Number, workingDescription, Corr())))
        {
            var c = comment;
            if (await Run(s => Docs.CheckInAsync(s, Number, c, Corr()), "Checked in.")) comment = "";
        }
    }

    private async Task SaveMarkings()
    {
        var m = editMarkings!.Effective().ToMarkings();
        if (!m.IsSuccess) { error = string.Join(" ", m.Errors); return; }
        if (await Run(s => Docs.ChangeMarkingsAsync(s, Number, m.Value, markingsReason, Corr()), "Markings changed.")) { editMarkings = null; markingsReason = ""; }
    }
}
