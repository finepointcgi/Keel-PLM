@page "/documents"
@using Keel.Documents
@inject CurrentUser Users
@inject DocumentService Docs
@inject IReferenceData Refs
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C

<PageFrame Banner="@(result?.PageBanner ?? UiText.Unclassified)" Title="@P["Documents.Title"]" Crumbs="@Crumbs">
    <form class="toolbar" role="search" @onsubmit="() => Search(0)">
        <input aria-label="@P["Documents.Search"]" placeholder="@C["Search.Placeholder"]" class="grow" @bind="query" />
        <select aria-label="@P["Documents.Type"]" @bind="type" @bind:after="() => Search(0)">
            <option value="">@C["Type.Any"]</option>
            @foreach (var t in docTypes) { <option value="@t">@t</option> }
        </select>
        <select aria-label="@C["State"]" @bind="state" @bind:after="() => Search(0)">
            <option value="">@C["State.Any"]</option>
            @foreach (var s in States) { <option value="@s">@C.StateLabel(s)</option> }
        </select>
        <button type="submit">@C["Search"]</button>
        <AuthorizeView Roles="@($"{Roles.Author},{Roles.Admin}")">
            <a class="button" href="documents/new">@P["Documents.Create"]</a>
        </AuthorizeView>
    </form>

    @if (result is not null)
    {
        <p class="muted">@P.Count("Documents.Count", result.Total)</p>
        <DataTable TItem="DocumentSummary" TableId="documents" Items="result.Items" Columns="Columns" Caption="@P["Documents.Title"]" OnServerSort="OnSort" ServerSort="sort">
            <Empty>
                <EmptyState Title="@(Filtered ? P["Documents.NoMatch"] : P["Documents.None"])" IconName="document" ActionHref="@(Filtered ? null : "documents/new")" ActionText="@P["Documents.Create"]">
                    @(Filtered ? P["Documents.NoMatchHelp"] : P["Documents.NoneHelp"])
                </EmptyState>
            </Empty>
        </DataTable>
        <Pager Total="result.Total" Offset="offset" PageSize="PageSize" OnPage="Search" />
    }
    else
    {
        <Skeleton Lines="6" Label="@P["Documents.Loading"]" />
    }
</PageFrame>

@code {
    private const int PageSize = 50;
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    private SortSpec? sort;
    private bool sortLoaded;

    // The order lives in the address bar (GAP-A-1). A stale or hand-edited value that is not one of the module's sort keys falls back to the default order.
    protected override async Task OnParametersSetAsync()
    {
        _ = DocumentService.SortKeys.TryResolve(SortParam, DirParam, out var requested, out _);
        if (sortLoaded && requested == sort) return;
        (sort, sortLoaded) = (requested, true);
        await Search(0);
    }

    private async Task OnSort((string Key, bool Descending) s)
    {
        sort = new SortSpec(s.Key, s.Descending);
        await Search(0);
    }

    private string query = "", type = "", state = "";
    private int offset;
    private DocumentSearchResult? result;

    private static readonly string[] States = ["InWork", "UnderReview", "Released", "Obsolete"];
    private IReadOnlyList<Crumb> Crumbs => [new(P["Documents.Title"])];
    private bool Filtered => query.Length > 0 || type != "" || state != "";

    private IReadOnlyList<DataColumn<DocumentSummary>> Columns =>
    [
        new() { Key = "number", Title = C["Column.Number"], Required = true, ServerSortKey = "number", Cell = d => @<a href="documents/@Uri.EscapeDataString(d.Number)">@d.Number</a> },
        new() { Key = "name", Title = C["Column.Name"], ServerSortKey = "name", Text = d => d.Name },
        new() { Key = "type", Title = C["Column.Type"], ServerSortKey = "type", Text = d => d.DocumentType },
        new() { Key = "version", Title = C["Column.Version"], ServerSortKey = "version", Text = d => $"{d.Revision}.{d.Iteration}" },
        new() { Key = "state", Title = C["Column.State"], ServerSortKey = "state", Text = d => C.StateLabel(d.State) },
        new() { Key = "markings", Title = C["Column.Markings"], Required = true, Cell = d => @<MarkingChip Text="@d.Banner" /> },
    ];

    private IReadOnlyList<string> docTypes = []; // 2.2: administrator data

    protected override async Task OnInitializedAsync()
    {
        docTypes = await Refs.CodesAsync(RefLists.DocumentType);
    }

    private async Task Search(int newOffset)
    {
        offset = newOffset;
        result = await Docs.SearchAsync(await Users.GetAsync(), query, type == "" ? null : type, state == "" ? null : state, PageSize, offset, sort, CurrentUser.NewCorrelationId());
    }
}
