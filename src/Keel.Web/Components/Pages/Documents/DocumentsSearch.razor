@page "/documents"
@using Keel.Documents
@inject CurrentUser Users
@inject DocumentService Docs
@inject IReferenceData Refs

<PageFrame Banner="@(result?.PageBanner ?? UiText.Unclassified)" Title="Documents" Crumbs="@Crumbs">
    <form class="toolbar" role="search" @onsubmit="() => Search(0)">
        <input aria-label="Search documents" placeholder="Number or name" class="grow" @bind="query" />
        <select aria-label="Document type" @bind="type" @bind:after="() => Search(0)">
            <option value="">Any type</option>
            @foreach (var t in docTypes) { <option value="@t">@t</option> }
        </select>
        <select aria-label="State" @bind="state" @bind:after="() => Search(0)">
            <option value="">Any state</option>
            <option value="InWork">In Work</option>
            <option value="UnderReview">Under Review</option>
            <option value="Released">Released</option>
            <option value="Obsolete">Obsolete</option>
        </select>
        <button type="submit">Search</button>
        <AuthorizeView Roles="@($"{Roles.Author},{Roles.Admin}")">
            <a class="button secondary" href="documents/new">New document</a>
        </AuthorizeView>
    </form>

    @if (result is not null)
    {
        <p class="muted">@result.Total document@(result.Total == 1 ? "" : "s") you can access</p>
        <DataTable TItem="DocumentSummary" TableId="documents" Items="result.Items" Columns="Columns" Caption="Documents">
            <Empty>
                <EmptyState Title="@(Filtered ? "No documents match" : "No documents yet")" IconName="document" ActionHref="@(Filtered ? null : "documents/new")" ActionText="New document">
                    @(Filtered ? "Try a different number or name, or clear the filters." : "Upload the first drawing or specification to get started.")
                </EmptyState>
            </Empty>
        </DataTable>
        <Pager Total="result.Total" Offset="offset" PageSize="PageSize" OnPage="Search" />
    }
    else
    {
        <Skeleton Lines="6" Label="Loading documents" />
    }
</PageFrame>

@code {
    private const int PageSize = 50;
    private string query = "", type = "", state = "";
    private int offset;
    private DocumentSearchResult? result;

    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Documents")];
    private bool Filtered => query.Length > 0 || type != "" || state != "";

    private static readonly IReadOnlyList<DataColumn<DocumentSummary>> Columns =
    [
        new() { Key = "number", Title = "Number", Required = true, SortValue = d => d.Number, Cell = d => @<a href="documents/@Uri.EscapeDataString(d.Number)">@d.Number</a> },
        new() { Key = "name", Title = "Name", SortValue = d => d.Name, Text = d => d.Name },
        new() { Key = "type", Title = "Type", SortValue = d => d.DocumentType, Text = d => d.DocumentType },
        new() { Key = "version", Title = "Version", Text = d => $"{d.Revision}.{d.Iteration}" },
        new() { Key = "state", Title = "State", SortValue = d => d.State, Text = d => StateText.Label(d.State) },
        new() { Key = "markings", Title = "Markings", Required = true, Cell = d => @<MarkingChip Text="@d.Banner" /> },
    ];

    private IReadOnlyList<string> docTypes = []; // 2.2: administrator data

    protected override async Task OnInitializedAsync()
    {
        docTypes = await Refs.CodesAsync(RefLists.DocumentType);
        await Search(0);
    }

    private async Task Search(int newOffset)
    {
        offset = newOffset;
        result = await Docs.SearchAsync(await Users.GetAsync(), query, type == "" ? null : type, state == "" ? null : state, PageSize, offset, CurrentUser.NewCorrelationId());
    }
}
