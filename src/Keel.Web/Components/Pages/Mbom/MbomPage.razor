@page "/mboms/{Number}"
@inject CurrentUser Users
@inject MbomService Mbom

@* One manufacturing BOM (ADR-0024): header, lines with EBOM-link indicators, working-copy editing, reconciliation, update from the EBOM, release review and structure.
   The page banner is the aggregate of the MBOM and every row any panel displays (ADR-0014). *@
<PageFrame Banner="@BannerMerge.Union(detail?.Summary.Banner ?? UiText.Unclassified, linesBanner, reconBanner, BannerOf(structureMarkings), BannerOf(editorMarkings))" Title="Manufacturing BOM">
    @if (notFound)
    {
        <p class="error" role="alert">The manufacturing BOM @Number was not found, or you are not authorized to see it.</p>
    }
    else if (detail is not null)
    {
        var d = detail;
        var s = d.Summary;
        <article class="stack">
            <header class="part-header">
                <div>
                    <h2>@s.Number · @s.PartName</h2>
                    <p class="muted">Manufacturing BOM of <a href="parts/@Uri.EscapeDataString(s.PartNumber)">@s.PartNumber</a> for plant @d.Plant.Code (@d.Plant.Name) · part is at @d.PartState</p>
                </div>
                <div class="badges">
                    <span class="badge">Version @d.Displayed.Revision.@d.Iteration.Iteration</span>
                    <span class="badge @MbomUiText.StateClass(d.Displayed.State)">@d.Displayed.StateLabel</span>
                    @if (s.ReconciliationStatus is { } rs) { <span class="badge @MbomUiText.StatusClass(rs)">@ReconcileStatuses.Label(rs)</span> }
                    <MarkingChip Text="@s.Banner" />
                </div>
            </header>

            @if (d.Revisions.Count > 1)
            {
                <nav class="toolbar" aria-label="Revisions">
                    @foreach (var r in d.Revisions)
                    {
                        <a href="@($"{MbomUiText.Href(s.Number)}{(r.IsLatest ? "" : $"?revision={r.Revision}")}")" aria-current="@(r.Id == d.Displayed.Id ? "page" : null)">Rev @r.Revision (@r.StateLabel)</a>
                    }
                </nav>
            }
            @if (error is not null) { <p class="error" role="alert">@error</p> }
            @if (!d.Permissions.CanModify) { <p class="muted">Read only: @string.Join(" ", d.Permissions.ModifyDeniedReasons.Select(UiText.Reason))</p> }

            <dl class="facts">
                <dt>Derived from EBOM</dt><dd>@(d.Iteration.DerivedFrom ?? "none (manual MBOM)")@(d.Iteration.DerivedSpec is null ? "" : $" · {d.Iteration.DerivedSpec}")</dd>
                <dt>Lines</dt><dd>@d.Iteration.LineCount lines, @d.Iteration.LinkCount EBOM link@(d.Iteration.LinkCount == 1 ? "" : "s")</dd>
                <dt>Created</dt><dd>@UiText.Utc(d.Iteration.CreatedAt) by @d.Iteration.CreatedBy@(d.Iteration.Comment is null ? "" : $" · {d.Iteration.Comment}")</dd>
                <dt>Release policy</dt><dd>Plant @d.Plant.Code @(d.Plant.ReleaseAllowsWarnings ? "releases with warnings allowed" : "releases only without warnings")</dd>
            </dl>

            @if (d.Displayed.IsLatest)
            {
                <section class="panel" aria-labelledby="mbom-work-heading">
                    <h3 id="mbom-work-heading">Work</h3>
                    @if (d.Checkout is { IsMine: false } other) { <p>Checked out by @(other.UserName ?? other.UserId) since @UiText.Utc(other.At).</p> }
                    <div class="toolbar">
                        @if (d.Checkout is null && d.Permissions.CanModify && d.Displayed.State == "InWork")
                        {
                            <button type="button" disabled="@busy" @onclick="() => Act(x => Mbom.CheckOutAsync(x, Number, Corr()))">Check out</button>
                        }
                        @if (d.Checkout is not null && (d.Checkout.IsMine || d.Permissions.CanAdminister))
                        {
                            <button type="button" class="secondary" disabled="@busy" @onclick="() => Act(x => Mbom.UndoCheckOutAsync(x, Number, Corr()))">Undo check-out</button>
                        }
                        @foreach (var t in d.Transitions.Where(t => t.To == "Obsolete"))
                        {
                            <input aria-label="Reason to make the MBOM obsolete" placeholder="Reason (required)" @bind="obsoleteReason" />
                            <button type="button" class="secondary" disabled="@(!t.Allowed || busy)" title="@t.Reason" @onclick="() => Act(x => Mbom.TransitionAsync(x, Number, t.To, obsoleteReason, Corr()))">Move to @t.Label</button>
                        }
                        @if (d.Displayed.State == "Released" && d.Permissions.CanModify)
                        {
                            <input aria-label="Reason for the new revision" placeholder="Reason for revision B (required)" @bind="reviseReason" />
                            <button type="button" disabled="@busy" @onclick="() => Act(x => Mbom.ReviseAsync(x, Number, reviseReason, Corr()))">Revise</button>
                        }
                    </div>
                    @if (d.Checkout?.IsMine == true)
                    {
                        <div class="toolbar">
                            <input aria-label="Check-in comment" placeholder="Check-in comment" class="grow" @bind="comment" />
                            <button type="button" disabled="@busy" @onclick="() => Act(x => Mbom.CheckInAsync(x, Number, comment, Corr()))">Check in</button>
                        </div>
                    }
                </section>
            }

            <MbomReviewPanel Detail="d" OnChanged="Reload" />

            <section class="panel stack" aria-labelledby="mbom-lines-heading">
                <div class="bom-heading">
                    <h3 id="mbom-lines-heading">Lines of version @d.Displayed.Revision.@d.Iteration.Iteration</h3>
                    <nav class="toolbar" aria-label="MBOM views">
                        <a href="@($"{MbomUiText.Href(s.Number)}/side-by-side")">EBOM and MBOM side by side</a>
                        <a href="@($"{MbomUiText.Href(s.Number)}/compare")">Compare versions</a>
                    </nav>
                </div>
                @if (lines is null) { }
                else if (lines.Lines.Count == 0) { <p class="muted">No lines yet.@(d.Permissions.CanModify ? " Check the MBOM out to add lines, or update it from the EBOM." : "")</p> }
                else { <MbomLinesGrid Lines="lines.Lines" /> }
                <p class="muted small" aria-live="polite">@(lines is null ? "" : $"{lines.Lines.Count} line{(lines.Lines.Count == 1 ? "" : "s")}")@((lines?.Lines.Count(l => l.Redacted) ?? 0) > 0 ? $" · {lines!.Lines.Count(l => l.Redacted)} restricted item(s) you cannot see" : "")</p>
            </section>

            @if (d.Checkout?.IsMine == true)
            {
                <MbomEditor Number="@s.Number" OnChanged="Reload" OnMarkings="m => editorMarkings = m" />
            }

            <ReconciliationPanel Detail="d" OnChanged="Reload" OnBanner="b => reconBanner = b" />

            @if (d.Displayed.IsLatest && d.Displayed.State == "InWork" && d.Checkout is null && d.Permissions.CanModify)
            {
                <RegenerationPanel Detail="d" OnChanged="Reload" />
            }

            <MbomStructure Detail="d" OnMarkings="m => structureMarkings = m" />
        </article>
    }
</PageFrame>

@code {
    [Parameter] public required string Number { get; set; }
    [SupplyParameterFromQuery(Name = "revision")] public string? Revision { get; set; }

    private MbomDetail? detail;
    private MbomLines? lines;
    private bool notFound, busy;
    private string? error, linesBanner, reconBanner, comment = "", obsoleteReason = "", reviseReason = "";
    private IReadOnlyList<Markings> structureMarkings = [], editorMarkings = [];

    private static string Corr() => CurrentUser.NewCorrelationId();

    private static string? BannerOf(IReadOnlyList<Markings> m) => m.Count == 0 ? null : Markings.AggregateBanner(m);

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        var subject = await Users.GetAsync();
        var outcome = await Mbom.GetAsync(subject, Number, Revision, Corr());
        if (!outcome.IsOk) { notFound = outcome.Kind == OutcomeKind.NotFound; error = notFound ? null : UiText.Message(outcome); detail = null; return; }
        notFound = false;
        detail = outcome.Value;
        var l = await Mbom.GetLinesAsync(subject, Number, detail!.Displayed.IsLatest ? null : detail.Displayed.Revision, null, Corr());
        lines = l.IsOk ? l.Value : null;
        linesBanner = lines?.Banner;
    }

    private async Task Act<T>(Func<Subject, Task<Outcome<T>>> action)
    {
        busy = true;
        error = null;
        var outcome = await action(await Users.GetAsync());
        busy = false;
        if (!outcome.IsOk) error = outcome.Kind is OutcomeKind.Invalid or OutcomeKind.Conflict ? string.Join(" ", outcome.Errors) : UiText.Message(outcome);
        else { comment = obsoleteReason = reviseReason = ""; }
        await Reload();
    }
}
