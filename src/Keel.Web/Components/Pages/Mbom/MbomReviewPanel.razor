@inject CurrentUser Users
@inject WorkflowService Flow

@* Review status, "Submit for review" and signature history of one MBOM. A release needs a fresh reconciliation without errors; the workflow signs a digest of the
   lines, the links and that reconciliation. Reuses the workflow start dialog (ADR-0018, ADR-0024). *@
@if (status is not null)
{
    <section class="panel" aria-labelledby="mbom-review-heading">
        <h3 id="mbom-review-heading">Release review</h3>
        @* UX-3: the progress map of the running (or last) review: steps, vote rule, who signed, who is pending. *@
        @{ var mapInstance = status.Active ?? status.Last; }
        @if (mapInstance is not null) { <WorkflowMapPanel InstanceId="@mapInstance.Id" Version="@($"{mapInstance.Status}:{mapInstance.Tasks.Count(t => t.Status != "Open")}")" /> }

        @if (status.Active is { } active)
        {
            <p>
                <span class="badge state-underreview">Under review</span>
                Started by @active.StartedBy on @WorkflowText.Utc(active.StartedAt) · <a href="workflows/@active.Id">Workflow details</a>
            </p>
            <ul class="plain">
                @foreach (var t in active.Tasks.Where(t => t.Status == "Open"))
                {
                    <li>@t.Name: waiting for @(t.AssigneeName ?? WorkflowText.Role(t.RequiredRole))@(t.Overdue ? " (overdue)" : "")</li>
                }
            </ul>
        }
        else
        {
            @if (status.Last is { } last)
            {
                <p>
                    <span class="badge @(last.Status == InstanceStatus.Approved ? "state-released" : null)">Last review: @WorkflowText.Status(last.Status)</span>
                    @(last.CompletedAt is { } done ? WorkflowText.Utc(done) : "") · <a href="workflows/@last.Id">Workflow details</a>
                </p>
                @if (last.Status == InstanceStatus.Rejected)
                {
                    <ul class="plain" aria-label="Rejection reasons">@foreach (var r in last.Rejections) { <li>Rejected by @r.By (@r.Username): @r.Comment</li> }</ul>
                }
                else if (last.Status == InstanceStatus.Cancelled) { <p class="muted">@last.CompletionNote</p> }
            }
            else { <p class="muted">This MBOM has not been submitted for review.</p> }

        }

        @if (status.Releases.Count > 0)
        {
            <h4>Signatures</h4>
            @foreach (var rel in status.Releases)
            {
                <div class="release">
                    <p>Released @WorkflowText.Utc(rel.ReleasedAt) · <a href="workflows/@rel.InstanceId">Workflow details</a></p>
                    <ul class="plain signatures">@foreach (var s in rel.Signatures) { <li>@s.Manifestation@(string.IsNullOrEmpty(s.Comment) ? "" : $": {s.Comment}")</li> }</ul>
                </div>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public required MbomDetail Detail { get; set; }
    /// <summary>The review started or was cancelled; the page reloads the MBOM.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private ObjectWorkflowStatus? status;

    protected override async Task OnParametersSetAsync()
    {
        var outcome = await Flow.StatusForObjectAsync(await Users.GetAsync(), MbomService.ObjectType, Detail.Summary.Number, CurrentUser.NewCorrelationId());
        status = outcome.IsOk ? outcome.Value : null;
    }

}
