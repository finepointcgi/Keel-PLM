@page "/approve/{Id:guid}"
@inject NavigationManager Nav

@* The phone approval page was merged into the task page (ADR-0063); this address is kept so saved links and bookmarks still work. *@
<PageFrame Banner="@UiText.Unclassified" Title="Approve">
    <p class="muted">Taking you to <a href="tasks">My tasks</a>.</p>
</PageFrame>

@code {
    [Parameter] public Guid Id { get; set; }

    protected override void OnInitialized() => Nav.NavigateTo($"tasks/{Id:D}", replace: true);
}
