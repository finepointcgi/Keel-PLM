@page "/tasks"
@inject CurrentUser Users
@inject WorkflowService Flow
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C
@inject UiLanguage Language
@inject WorkspaceReads Reads

<PageFrame Banner="@PageBanner" Title="@P["Tasks.Title"]" Crumbs="@Crumbs">
    @if (tasks is not null)
    {
        <p class="muted">@P.Count("Tasks.Count", tasks.Items.Count + changeTasks.Count)</p>
        @if (tasks.Items.Count > 0 || changeTasks.Count == 0)
        {
        <div class="tasks-table">
            <DataTable TItem="TaskSummary" TableId="tasks" Items="tasks.Items" Columns="Columns" Caption="@P["Tasks.Caption"]" OnServerSort="OnSort" ServerSort="sort">
                <Empty><EmptyState Title="@P["Tasks.EmptyTitle"]" IconName="check">@P["Tasks.EmptyText"]</EmptyState></Empty>
            </DataTable>
        </div>
        }
        @* The tasks of changes assigned to the person are the same ones Home counts under "Needs my attention", so the two pages agree. *@
        @if (changeTasks.Count > 0)
        {
            <section class="list-card">
                <p class="list-title">@P["Tasks.ChangeTasks"]</p>
                <ul class="items">
                    @foreach (var c in changeTasks)
                    {
                        <li>
                            <span class="main">
                                <a href="@c.Href">@c.Title</a>
                                <span class="sub">@c.Detail@if (c.At is { } at) { <text> · @P["Attention.Due", Language.Date(at)]</text> }</span>
                            </span>
                            @if (c.Overdue) { <span class="badge state-obsolete error">@P["Attention.Overdue"]</span> }
                        </li>
                    }
                </ul>
            </section>
        }
        @* On a phone the same tasks are large cards instead of a table (the one page replaces the separate approvals screens). *@
        @if (tasks.Items.Count > 0)
        {
            <ul class="plain approve-list" aria-label="@P["Tasks.Caption"]">
                @foreach (var t in tasks.Items)
                {
                    <li class="approve-card" data-testid="approval-card">
                        <h2 class="approve-title">@t.Name</h2>
                        @if (t.Redacted || t.Target is null)
                        {
                            <p class="muted">@P["Tasks.Restricted"]</p>
                        }
                        else
                        {
                            <p class="approve-item"><strong>@t.Target.Key</strong> · @t.Target.Name <span class="muted">@P["Tasks.Rev", t.Target.Revision]</span></p>
                            <p><MarkingChip Text="@t.Target.Banner" /></p>
                            <p class="muted small">@P["Tasks.StartedByLine", t.StartedByName ?? ""]</p>
                        }
                        <p class="@(t.Overdue ? "error" : "muted") small">@WorkflowText.Due(t.DueAt, t.Overdue, C, Language)</p>
                        @if (!t.Redacted && t.Target is not null)
                        {
                            <a class="button approve-open" href="tasks/@t.Id" aria-label="@P["Tasks.OpenAria", t.Name, t.Target.Key]">@P["Tasks.Open"]</a>
                        }
                    </li>
                }
            </ul>
        }
    }
</PageFrame>

@code {
    private MyTasks? tasks;
    private IReadOnlyList<AttentionItem> changeTasks = [];

    // The banner covers what the page shows: the tasks and the markings of the change tasks listed under them.
    private string PageBanner => BannerMerge.Union([tasks?.PageBanner ?? UiText.Unclassified, .. changeTasks.Where(c => c.Markings is not null).Select(c => c.Markings!.BannerText())]);

    private IReadOnlyList<Crumb> Crumbs => [new(P["Tasks.Title"])];

    private IReadOnlyList<DataColumn<TaskSummary>> Columns =>
    [
        new() { Key = "task", Title = P["Tasks.Column.Task"], Required = true, ServerSortKey = "task", Cell = t => @<a href="tasks/@t.Id">@t.Name</a> },
        new() { Key = "item", Title = P["Tasks.Column.Item"], ServerSortKey = "item", Cell = t => @<text>@if (t.Redacted || t.Target is null) { <span class="muted">@P["Tasks.Restricted"]</span> } else { @t.Target.Key <text>·</text> @t.Target.Name <span class="muted">@P["Tasks.Rev", t.Target.Revision]</span> }</text> },
        new() { Key = "markings", Title = C["Column.Markings"], Cell = t => @<text>@if (!t.Redacted && t.Target is not null) { <MarkingChip Text="@t.Target.Banner" /> }</text> },
        new() { Key = "started", Title = P["Tasks.Column.StartedBy"], ServerSortKey = "started", Text = t => t.Redacted ? "" : t.StartedByName },
        new() { Key = "due", Title = P["Tasks.Column.Due"], ServerSortKey = "due", Cell = t => @<span class="@(t.Overdue ? "error" : null)">@WorkflowText.Due(t.DueAt, t.Overdue, C, Language)</span> },
    ];

    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    private SortSpec? sort;
    private bool sortLoaded;

    // The order lives in the address bar (GAP-A-1); a value that is not one of the sort keys falls back to the default order.
    protected override async Task OnParametersSetAsync()
    {
        _ = WorkflowService.SortKeys.TryResolve(SortParam, DirParam, out var requested, out _);
        if (sortLoaded && requested == sort) return;
        (sort, sortLoaded) = (requested, true);
        await LoadAsync();
    }

    private async Task OnSort((string Key, bool Descending) s)
    {
        sort = new SortSpec(s.Key, s.Descending);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        tasks = await Flow.MyTasksAsync(await Users.GetAsync(), sort, CurrentUser.NewCorrelationId());
        var attention = await Reads.AttentionAsync();
        changeTasks = [.. attention.Items.Where(i => i.Kind == "change task")];
    }
}
