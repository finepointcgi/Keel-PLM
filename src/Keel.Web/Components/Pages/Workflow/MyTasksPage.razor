@page "/tasks"
@inject CurrentUser Users
@inject WorkflowService Flow

<PageFrame Banner="@(tasks?.PageBanner ?? UiText.Unclassified)" Title="My tasks">
    @if (tasks is not null)
    {
        @if (tasks.Items.Count == 0)
        {
            <p class="muted">You have no open tasks.</p>
        }
        else
        {
            <p class="muted">@tasks.Items.Count open task@(tasks.Items.Count == 1 ? "" : "s")</p>
            <div class="table-wrap"><table class="data">
                <thead><tr><th scope="col">Task</th><th scope="col">Item</th><th scope="col">Markings</th><th scope="col">Started by</th><th scope="col">Due</th></tr></thead>
                <tbody>
                    @foreach (var t in tasks.Items)
                    {
                        <tr>
                            <td><a href="tasks/@t.Id">@t.Name</a></td>
                            @if (t.Redacted || t.Target is null)
                            {
                                <td colspan="3" class="muted">Restricted item. You are no longer eligible to see it; the task cannot be signed.</td>
                            }
                            else
                            {
                                <td>@t.Target.Key · @t.Target.Name <span class="muted">rev @t.Target.Revision</span></td>
                                <td><MarkingChip Text="@t.Target.Banner" /></td>
                                <td>@t.StartedByName</td>
                            }
                            <td class="@(t.Overdue ? "error" : null)">@WorkflowText.Due(t.DueAt, t.Overdue)</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    }
</PageFrame>

@code {
    private MyTasks? tasks;

    protected override async Task OnInitializedAsync() =>
        tasks = await Flow.MyTasksAsync(await Users.GetAsync(), CurrentUser.NewCorrelationId());
}
