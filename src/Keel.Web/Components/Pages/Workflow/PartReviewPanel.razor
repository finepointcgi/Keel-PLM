@inject CurrentUser Users
@inject WorkflowService Flow

@* Review status, status and release history for one part (increment 1.5). Self-contained so the part page only hosts it. *@
@if (status is not null)
{
    <section class="panel" aria-labelledby="review-heading">
        <h3 id="review-heading">Review and release</h3>
        @* UX-3: the progress map of the running (or last) review: steps, vote rule, who signed, who is pending. *@
        @{ var mapInstance = status.Active ?? status.Last; }
        @if (mapInstance is not null) { <WorkflowMapPanel InstanceId="@mapInstance.Id" Version="@($"{mapInstance.Status}:{mapInstance.Tasks.Count(t => t.Status != "Open")}")" /> }

        @if (status.Active is { } active)
        {
            <p>
                <span class="badge state-underreview">Under review</span>
                Started by @active.StartedBy on @WorkflowText.Utc(active.StartedAt) ·
                <a href="workflows/@active.Id">Workflow details</a>
            </p>
            <ul class="plain">
                @foreach (var t in active.Tasks.Where(t => t.Status == "Open"))
                {
                    <li>@t.Name: waiting for @(t.AssigneeName ?? WorkflowText.Role(t.RequiredRole))@(t.Overdue ? " (overdue)" : "")</li>
                }
            </ul>
        }
        else
        {
            @if (status.Last is { } last)
            {
                <p>
                    <span class="badge @(last.Status == InstanceStatus.Approved ? "state-released" : null)">Last review: @WorkflowText.Status(last.Status)</span>
                    @(last.CompletedAt is { } done ? WorkflowText.Utc(done) : "") ·
                    <a href="workflows/@last.Id">Workflow details</a>
                </p>
                @if (last.Status == InstanceStatus.Rejected)
                {
                    <ul class="plain" aria-label="Rejection reasons">
                        @foreach (var r in last.Rejections)
                        {
                            <li>Rejected by @r.By (@r.Username): @r.Comment</li>
                        }
                    </ul>
                }
                else if (last.Status == InstanceStatus.Cancelled)
                {
                    <p class="muted">@last.CompletionNote</p>
                }
            }
            else
            {
                <p class="muted">This part has not been submitted for review.</p>
            }

        }

        @if (status.Releases.Count > 0)
        {
            <h4>Release history</h4>
            @foreach (var rel in status.Releases)
            {
                <div class="release">
                    <p><strong>Revision @rel.Revision (@rel.IterationLabel)</strong> released @WorkflowText.Utc(rel.ReleasedAt) · <a href="workflows/@rel.InstanceId">Workflow details</a></p>
                    <ul class="plain signatures">
                        @foreach (var s in rel.Signatures)
                        {
                            <li>@s.Manifestation@(string.IsNullOrEmpty(s.Comment) ? "" : $": {s.Comment}")</li>
                        }
                    </ul>
                </div>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public required string Number { get; set; }
    /// <summary>Lifecycle state key of the revision shown.</summary>
    [Parameter, EditorRequired] public required string State { get; set; }

    private ObjectWorkflowStatus? status;

    protected override async Task OnParametersSetAsync()
    {
        var outcome = await Flow.StatusForObjectAsync(await Users.GetAsync(), "part", Number, CurrentUser.NewCorrelationId());
        status = outcome.IsOk ? outcome.Value : null;
    }
}
