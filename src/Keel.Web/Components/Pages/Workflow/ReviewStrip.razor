@inject CurrentUser Users
@inject WorkflowService Flow

@* The review step in the header of an object page (part, document, change, baseline, specification, MBOM, quality record, supplier ...): one line saying where the item is (ready, waiting for someone, rejected, released) and the one button that moves it on
   (Submit for review, or Review and sign for the person the task is assigned to). It uses the same workflow calls as the Review & release tab, so separation of duties, role and
   markings checks, locking and audit are unchanged; the tab keeps the progress map and the release history. *@
@if (status is not null && Visible)
{
    <div class="review-strip" role="group" aria-label="Review and release" data-review-strip>
        @if (status.Active is { } active)
        {
            var mine = active.Tasks.FirstOrDefault(t => t.Status == "Open" && t.AssigneeSub == me);
            var waiting = active.Tasks.Where(t => t.Status == "Open").Select(t => t.AssigneeName ?? WorkflowText.Role(t.RequiredRole)).Distinct().ToList();
            <span class="badge state-underreview">Review in progress</span>
            <span class="muted">@(waiting.Count == 0 ? "Waiting for the last step." : "Waiting for " + string.Join(", ", waiting))</span>
            <span class="spacer"></span>
            @if (mine is not null)
            {
                <a class="button" href="tasks/@mine.Id">Review and sign</a>
            }
            <button type="button" class="secondary" aria-expanded="@showProgress" aria-controls="@(showProgress ? "review-progress" : null)" @onclick="() => showProgress = !showProgress">Progress</button>
            @if (active.CanCancel)
            {
                <button type="button" class="secondary" disabled="@busy" @onclick="() => cancelling = !cancelling" aria-expanded="@cancelling">Cancel review</button>
            }
        }
        else
        {
            @if (status.Last is { } last && last.Status == InstanceStatus.Rejected)
            {
                <span class="badge">Review rejected</span>
                <span class="muted">@(last.Rejections.FirstOrDefault() is { } r ? $"{r.By}: {r.Comment}" : "Fix what was asked, then submit again.")</span>
            }
            else if (CanStart || WhyNot is not null)
            {
                <span class="muted">@(CanStart ? "Ready to go to review?" : WhyNot)</span>
            }
            else if (status.Releases.Count > 0 && status.Releases[0] is { } rel)
            {
                <span class="badge state-released">Released</span>
                <span class="muted">@(string.IsNullOrEmpty(rel.IterationLabel) ? "" : $"Revision {rel.Revision}, ")@WorkflowText.Utc(rel.ReleasedAt)</span>
            }
            <span class="spacer"></span>
            @if (CanStart)
            {
                <button type="button" disabled="@busy" data-action="submit-review" @onclick="BeginStart">@(status.Last?.Status == InstanceStatus.Rejected ? "Submit again" : StartText)</button>
            }
        }
        @if (showProgress && status.Active is { } running)
        {
            <div id="review-progress" class="review-strip-note stack">
                <WorkflowMapPanel InstanceId="@running.Id" Version="@($"{running.Status}:{running.Tasks.Count(t => t.Status != "Open")}")" />
                <p class="small"><a href="workflows/@running.Id">Workflow details</a></p>
            </div>
        }
        @if (CanStart && !string.IsNullOrEmpty(Hint) && status.Active is null) { <p class="muted small review-strip-note">@Hint</p> }
        @if (error is not null) { <p class="error review-strip-note" role="alert">@error</p> }
        @if (cancelling && status.Active is not null && status.Active.CanCancel)
        {
            <div class="toolbar review-strip-note">
                <input aria-label="Reason for cancelling" placeholder="Reason for cancelling (required)" class="grow" @bind="cancelReason" />
                <button type="button" class="secondary" disabled="@busy" @onclick="Cancel">Cancel review</button>
            </div>
        }
    </div>

    @if (starting && template is not null)
    {
        <div class="dialog-backdrop">
            <div class="dialog wide" role="dialog" aria-modal="true" aria-label="Submit for review" tabindex="-1">
                <div class="dialog-body">
                    <StartReviewDialog Template="template" Search="SearchUsers" OnStart="Start" OnCancel="EndStart" Busy="busy" Error="@startError" />
                </div>
            </div>
        </div>
    }
}

@code {
    /// <summary>The workflow object type of the review ("part", "document", "ecn", "baseline" ...).</summary>
    [Parameter, EditorRequired] public required string ObjectType { get; set; }
    /// <summary>The key the workflow knows the object by (its number).</summary>
    [Parameter, EditorRequired] public required string Number { get; set; }
    /// <summary>What the person sees the object called, for the messages ("part", "document", "change notice").</summary>
    [Parameter] public string Noun { get; set; } = "item";
    /// <summary>Whether the object is at the stage where a review can start and the person may start it (the page knows its own rules).</summary>
    [Parameter] public bool CanStart { get; set; }
    /// <summary>Why a review cannot be started yet, when the object is at that stage (null when there is nothing to say).</summary>
    [Parameter] public string? WhyNot { get; set; }
    /// <summary>A note shown under the strip while the review can be started (what the signatures will cover, what to check first).</summary>
    [Parameter] public string? Hint { get; set; }
    /// <summary>The button text.</summary>
    [Parameter] public string StartText { get; set; } = "Submit for review";
    /// <summary>Raised after the review started or was cancelled, so the host page can reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Changes when the object's state does, so the strip reloads with it.</summary>
    [Parameter] public string? Version { get; set; }

    private ObjectWorkflowStatus? status;
    private TemplateView? template;
    private bool starting, busy, cancelling, showProgress;
    private string? error, startError, me;
    private string cancelReason = "";

    // Nothing to say for an object that is neither being reviewed, nor ready for it, nor released, so the strip stays out of the way.
    private bool Visible => status is { Active: not null } || CanStart || WhyNot is not null || status?.Releases.Count > 0
        || status?.Last?.Status == InstanceStatus.Rejected;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        var subject = await Users.GetAsync();
        me = subject.Id;
        var outcome = await Flow.StatusForObjectAsync(subject, ObjectType, Number, CurrentUser.NewCorrelationId());
        status = outcome.IsOk ? outcome.Value : null;
    }

    private async Task BeginStart()
    {
        error = startError = null;
        var templates = await Flow.ListTemplatesAsync(await Users.GetAsync(), activeOnly: true, CurrentUser.NewCorrelationId());
        template = templates.FirstOrDefault(t => t.ObjectType == ObjectType);
        if (template is null) { error = $"No workflow template is available for a {Noun}. Ask an administrator to upload one."; return; }
        starting = true;
    }

    private Task EndStart()
    {
        starting = false;
        return Task.CompletedTask;
    }

    private async Task<IReadOnlyList<DirectoryUserView>> SearchUsers(SlotView slot, string text)
    {
        var outcome = await Flow.SearchUsersAsync(await Users.GetAsync(), text, slot.Role, ObjectType, Number, 25, CurrentUser.NewCorrelationId());
        return outcome.IsOk ? outcome.Value! : [];
    }

    private async Task Start(StartSelection selection)
    {
        busy = true;
        startError = null;
        var outcome = await Flow.StartAsync(await Users.GetAsync(),
            new StartReviewCommand(ObjectType, Number, selection.Participants, selection.TemplateId, selection.Comment), CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk) { startError = WorkflowText.Message(outcome); return; }
        starting = false;
        await OnChanged.InvokeAsync();
        await Load();
    }

    private async Task Cancel()
    {
        busy = true;
        error = null;
        var outcome = await Flow.CancelAsync(await Users.GetAsync(), status!.Active!.Id, cancelReason, CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk) { error = WorkflowText.Message(outcome); return; }
        cancelReason = "";
        cancelling = false;
        await OnChanged.InvokeAsync();
        await Load();
    }
}
