@page "/tasks/{Id:guid}"
@inject CurrentUser Users
@inject WorkflowService Flow
@inject SignDraftStore Drafts
@inject NavigationManager Nav
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C
@inject UiLanguage Language

<PageFrame Banner="@(detail?.Banner ?? UiText.Unclassified)" Title="@P["Task.Title"]">
    @if (notFound)
    {
        <p class="error" role="alert">@P["Task.NotFound"]</p>
    }
    else if (detail is not null)
    {
        var d = detail;
        @if (d.Summary.Redacted || d.Summary.Target is null)
        {
            <article class="stack">
                <h2>@d.Summary.Name</h2>
                <p role="status">@P["Task.NoLongerEligible"]</p>
                @* UX-3: the steps and their status, with every participant shown as "Participant". *@
                <WorkflowMapPanel InstanceId="@d.Summary.InstanceId" Version="@d.Status" />
            </article>
        }
        else
        {
            var o = d.Summary.Target;
            <article class="stack">
                <header class="part-header">
                    <div>
                        <h2>@d.Summary.Name</h2>
                        <p class="muted">
                            @{
                                var link = WorkflowText.ObjectLink(o.ObjectType, o.Key);
                                RenderFragment objectKey = link is not null ? @<a href="@link">@o.Key</a> : @<span>@o.Key</span>;
                            }
                            @Rich.With(P[d.Summary.Kind == "approval" ? "Task.ApprovalOf" : "Task.ReviewOf"], objectKey)
                            · @o.Name · @P["Task.Revision", o.Revision, o.IterationLabel] · @P["Task.StartedBy", d.Summary.StartedByName ?? ""]
                        </p>
                    </div>
                    <div class="badges">
                        <span class="badge">@d.Status</span>
                        <MarkingChip Text="@o.Banner" />
                        <span class="badge @(d.Summary.Overdue ? "error" : null)">@WorkflowText.Due(d.Summary.DueAt, d.Summary.Overdue, C, Language)</span>
                    </div>
                </header>

                @if (message is not null)
                {
                    <p class="permit" role="status" data-testid="approve-message">@message</p>
                    @if (detail.Status != "Open") { <p><a class="button" href="tasks">@P["Task.BackToTasks"]</a></p> }
                }

                <section class="panel review-summary" aria-labelledby="task-summary-heading" data-testid="review-summary">
                    <h3 id="task-summary-heading">@P["Task.Summary"]</h3>
                    <p class="rs-name"><strong>@o.Key</strong> · @o.Name</p>
                    <dl class="facts">
                        <dt>@P["Task.Fact.Kind"]</dt><dd>@char.ToUpperInvariant(WorkflowText.Noun(o.ObjectType)[0])@WorkflowText.Noun(o.ObjectType)[1..]</dd>
                        <dt>@P["Task.Fact.Revision"]</dt><dd data-testid="rs-revision">@o.Revision</dd>
                        <dt>@P["Task.Fact.Version"]</dt><dd>@o.IterationLabel</dd>
                        <dt>@P["Task.Fact.State"]</dt><dd>@o.StateLabel</dd>
                        <dt>@P["Task.Fact.Markings"]</dt><dd><MarkingChip Text="@o.Banner" /></dd>
                        <dt>@P["Task.Fact.StartedBy"]</dt><dd>@d.Summary.StartedByName</dd>
                        <dt>@P["Task.Fact.Due"]</dt><dd class="@(d.Summary.Overdue ? "error" : null)">@WorkflowText.Due(d.Summary.DueAt, d.Summary.Overdue, C, Language)</dd>
                    </dl>
                    <p>@(string.IsNullOrEmpty(d.Description) ? P["Task.NoDescription"] : d.Description)</p>
                    @if (d.Attributes is { Count: > 0 })
                    {
                        <dl class="facts">
                            @foreach (var (k, v) in d.Attributes) { <dt>@k</dt><dd>@v?.ToString()</dd> }
                        </dl>
                    }
                    <p class="muted small">@P["Task.VersionNote", o.IterationLabel]</p>
                    @if (d.Review is { } review)
                    {
                        <p class="muted small">@P["Task.HashNote"]</p>
                        <p><code class="hash" data-testid="rs-hash">@review.ContentHash</code></p>
                    }
                </section>

                @if (d.Instance is { } note)
                {
                    <section class="panel"><h3>@P["Task.SubmitterComment"]</h3><p data-testid="rs-note">@(string.IsNullOrWhiteSpace(note.Comment) ? P["Task.NoNote"].Value : note.Comment)</p></section>
                }

                @if (d.Status == "Open")
                {
                    <SignPanel ReasonCodes="d.ReasonCodes" CanSign="d.CanSign" BlockedReasons="d.CannotSignReasons" StepUpRequired="d.StepUpRequired"
                               StepUpMaxAgeSeconds="d.StepUpMaxAgeSeconds" Busy="busy" Error="@error" @bind-Comment="comment" OnSign="Sign" />
                }
                else
                {
                    <p class="muted">@(d.Decision is null ? P["Task.StatusIs", d.Status.ToLower(Language.Culture)] : P["Task.StatusIsDecision", d.Status.ToLower(Language.Culture), d.Decision])</p>
                }

                @if (d.Instance is { } inst)
                {
                    <section class="panel">
                        <h3>@P["Task.Progress"]</h3>
                        <WorkflowMapPanel InstanceId="@inst.Id" Version="@($"{inst.Status}:{inst.Tasks.Count(t => t.Status != "Open")}")" />
                    </section>
                    <section class="panel">
                        <h3>@P["Task.History"]</h3>
                        <p><a href="workflows/@inst.Id">@P["Task.OpenWorkflow"]</a> · @WorkflowText.Status(inst.Status)</p>
                        @if (inst.Signatures.Count > 0)
                        {
                            <ul class="plain signatures" aria-label="@P["Task.SignaturesSoFar"]">
                                @foreach (var s in inst.Signatures) { <li>@s.Manifestation@(string.IsNullOrEmpty(s.Comment) ? "" : $": {s.Comment}")</li> }
                            </ul>
                        }
                        <div class="table-wrap"><table class="data history-table">
                            <thead><tr><th scope="col">@P["Task.When"]</th><th scope="col">@P["Task.Who"]</th><th scope="col">@P["Task.What"]</th></tr></thead>
                            <tbody>
                                @foreach (var e in inst.Events)
                                {
                                    <tr><td>@Language.Utc(e.At)</td><td>@e.ActorName</td><td>@e.Action@(e.Detail is null ? "" : ": " + e.Detail)</td></tr>
                                }
                            </tbody>
                        </table></div>
                    </section>
                }

            </article>
        }
    }
</PageFrame>

@code {
    [Parameter] public Guid Id { get; set; }

    private TaskDetail? detail;
    private bool notFound, busy;
    private string? error, message;
    private string comment = "";

    protected override async Task OnParametersSetAsync()
    {
        var user = await Users.GetAsync();
        var outcome = await Flow.GetTaskAsync(user, Id, CurrentUser.NewCorrelationId());
        notFound = !outcome.IsOk;
        detail = outcome.Value;
        // Back from step-up: restore what the signer had typed (kept in server memory, never in the URL).
        if (outcome.IsOk && Drafts.Take(Id, user.Id) is { } draft)
        {
            comment = draft.Comment ?? "";
            message = P["Task.SignedInAgain"];
        }
    }

    private async Task Sign(SignChoice choice)
    {
        busy = true;
        error = message = null;
        var user = await Users.GetAsync();
        var outcome = await Flow.SignAsync(user, Id, choice.Code, choice.Comment, CurrentUser.NewCorrelationId());
        busy = false;
        switch (outcome.Kind)
        {
            case OutcomeKind.Ok:
                comment = "";
                // The object's noun comes with the sentence as ONE string per object kind, so the sentence keeps its grammar in every language.
                var kind = outcome.Value!.Target.ObjectType is "ecn" or "ecr" ? "change" : outcome.Value!.Target.ObjectType;
                var noun = P.Or("Task.Noun." + kind, P["Task.Noun.part"].Value);
                message = outcome.Value!.Status switch
                {
                    InstanceStatus.Approved => P["Task.SignedApproved", noun].Value,
                    InstanceStatus.Rejected => P["Task.SignedRejected", noun].Value,
                    _ => P["Task.Signed"].Value,
                };
                var refreshed = await Flow.GetTaskAsync(user, Id, CurrentUser.NewCorrelationId());
                detail = refreshed.Value ?? detail;
                break;
            case OutcomeKind.StepUpRequired:
                // Keep the comment while the IdP asks for credentials again, then return to this page.
                Drafts.Put(Id, user.Id, new SignDraft(choice.Code, choice.Comment));
                Nav.NavigateTo($"account/step-up?returnUrl={Uri.EscapeDataString("/tasks/" + Id.ToString("D"))}", forceLoad: true);
                break;
            default:
                error = WorkflowText.Message(outcome, C);
                break;
        }
    }
}
