@page "/parts/new"

@* A blank form shows no controlled data; the markings being entered appear on the created part. The form itself is the shared quick form (ADR 0061). *@
<PageFrame Banner="@UiText.Unclassified" Title="Create part" Crumbs="@Crumbs">
    <QuickPartForm />
</PageFrame>

@code {
    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Parts", "parts"), new("Create part")];
}
