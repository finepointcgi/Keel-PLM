@page "/parts/{Number}"
@inject CurrentUser Users
@inject PartService Parts
@inject NpgsqlDataSource Db
@inject ToastService Toasts
@inject NavigationManager Nav
@inject Keel.Cad.CadGraphService CadGraph
@inject SimpleFlows Flows
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C
@inject UiLanguage Language
@using Npgsql
@using Keel.Web.Components.Pages.Workflow
@using Keel.Web.Components.Pages.Change
@using Keel.Change

<PageFrame Banner="@BannerMerge.Union(bomBanner ?? part?.Banner ?? UiText.Unclassified, changesBanner, mbomBanner, tdpBanner, timelineBanner, sourcingBanner, qualityBanner, tab == "viewer" ? viewerBanner : null, tab == "trace" ? traceBanner : null)" Title="@PageTitle"
           Crumbs="@Crumbs" Header="@(part is not null && defs is not null ? HeaderFragment(part) : null)">
    @if (notFound)
    {
        <p class="error" role="alert">@P["Part.NotFound", Number]</p>
    }
    else if (part is not null && defs is not null)
    {
        var p = part;
        <article class="stack">
            <ViewTracker Kind="@ObjectKinds.Part" Number="@p.Number" />
            <CommentCount Kind="@ObjectKinds.Part" Number="@p.Number" OnCount="c => commentCount = c" />
            <UnsavedGuard Dirty="@IsDirty" />

            @* Sticky action bar: the primary actions are reachable from every tab. *@
            <div class="action-bar" role="toolbar" aria-label="@P["Part.Actions"]">
                @{ var co = p.Checkout; }
                @if (p.Revision.IsLatest)
                {
                    @* Simple path (ADR 0061): Edit starts a draft in one step, Save stores it and checks in, Discard undoes it. The step-by-step controls sit under More. *@
                    @if (co?.IsMine == true && workingAttributes is not null)
                    {
                        <input aria-label="@P["Part.ChangeNote"]" placeholder="@P["Part.ChangeNote"]" class="grow" maxlength="1000" data-change-note @bind="note" />
                        <button type="button" disabled="@busy" data-action="save" @onclick="SaveSimple">@P["Part.Save"]</button>
                        <button type="button" class="secondary" disabled="@busy" data-action="discard" @onclick="() => confirmDiscard = true">@P["Part.Discard"]</button>
                    }
                    else if (editAdvice.State == PartEditState.CanEdit)
                    {
                        <button type="button" disabled="@busy" data-action="edit" @onclick="StartEdit">@P["Part.Edit"]</button>
                    }
                    @if (editAdvice.State is PartEditState.CanEdit or PartEditState.Resume)
                    {
                        <button type="button" class="secondary" disabled="@busy" data-action="add-document" @onclick="() => OpenAddDocument(false)">@P["Part.AddDocument"]</button>
                    }
                    @foreach (var t in p.Transitions)
                    {
                        <button type="button" class="secondary" disabled="@(!t.Allowed || busy)" title="@t.Reason"
                                @onclick='() => Run(s => Parts.SetStateAsync(s, Number, t.To, null, false, Corr()), P["Part.Moved", t.Label].Value)'>@P["Part.MoveTo", t.Label]</button>
                    }
                    @if (p.Revision.State == "Released" && p.Permissions.CanModify)
                    {
                        @* A released revision is changed through a change notice; the button starts one for this part (it used to sit inside the Changes tab). *@
                        <a class="button" data-action="request-change" href="@($"{ChangeUi.NewHref(ChangeTypes.Ecn)}?part={Uri.EscapeDataString(p.Number)}")">@P["Part.RequestChange"]</a>
                    }
                    @if ((co is null && p.Permissions.CanModify && !p.Revision.IsLocked) || co?.IsMine == true || (co is not null && p.Permissions.CanAdminister))
                    {
                        <details class="more-menu" data-more-menu>
                            <summary>@P["Part.More"]</summary>
                            <div class="more-panel" role="group" aria-label="@P["Part.StepByStep"]">
                                <p class="muted small">@P["Part.StepByStepHelp"]</p>
                                <GlossaryHint Term="check out" />
                                @if (co is null && p.Permissions.CanModify && !p.Revision.IsLocked)
                                {
                                    <button type="button" disabled="@busy" @onclick='() => Run(s => Parts.CheckOutAsync(s, Number, Corr()), P["Part.CheckedOut"].Value)'>@P["Part.CheckOut"]</button>
                                }
                                @if (co?.IsMine == true && workingAttributes is not null)
                                {
                                    <button type="button" class="secondary" disabled="@busy" @onclick="SaveWorkingCopy">@P["Part.SaveWorkingCopy"]</button>
                                    <input aria-label="@P["Part.CheckInComment"]" placeholder="@P["Part.CheckInComment"]" @bind="comment" />
                                    <button type="button" disabled="@busy" @onclick="CheckIn">@P["Part.CheckIn"]</button>
                                }
                                @if (co is not null && (co.IsMine || p.Permissions.CanAdminister))
                                {
                                    <button type="button" class="secondary" disabled="@busy" @onclick="() => confirmUndo = true">@P["Part.UndoCheckOut"]</button>
                                }
                            </div>
                        </details>
                    }
                }
                <span class="spacer"></span>
                <a class="button secondary" href="@($"parts/{Uri.EscapeDataString(p.Number)}/where-used")">@P["Part.WhereUsed"]</a>
                <a class="button secondary" href="@($"parts/{Uri.EscapeDataString(p.Number)}/compare")">@P["Part.Compare"]</a>
                @if (p.Revision.IsLatest && p.Permissions.CanModify)
                {
                    <a class="button secondary" href="@($"baselines/new?part={Uri.EscapeDataString(p.Number)}")">@P["Part.CreateBaseline"]</a>
                }
            </div>

            @if (error is not null) { <p class="error" role="alert">@error</p> }
            <PartEditBanner Part="p" />
            @if (co is not null && !co.IsMine)
            {
                <p class="notice">@P["Part.CheckedOutBy", co.UserName ?? co.UserId, Language.Utc(co.CheckedOutAt)]</p>
            }
            @if (!p.Permissions.CanModify)
            {
                <p class="muted">@P["Part.ReadOnly", string.Join(" ", p.Permissions.ModifyDeniedReasons.Select(r => UiText.Reason(r, C)))]</p>
            }
            @foreach (var t in p.Transitions.Where(t => !t.Allowed && t.Reason is not null))
            {
                <p class="muted small">@t.Label: @t.Reason</p>
            }

            <TabSet Tabs="@AwarenessTabs.Append(VisibleTabs, commentCount, TrailTitle)" Active="@tab" ActiveChanged="OnTabChanged" Label="@P["Part.Sections"]">
                @switch (tab)
                {
                    case "overview":
                        <div class="stack">
                            @if (co?.IsMine == true && workingAttributes is not null)
                            {
                                <section class="panel" aria-labelledby="work-heading">
                                    <h3 id="work-heading">Your changes</h3>
                                    <p class="muted">You are editing this part. Your changes stay private until you save (this is your working copy, checked out to you).</p>
                                    <GlossaryHint Term="working copy" />
                                    <div class="grid-form">
                                        <label class="wide">Description <textarea rows="3" maxlength="4000" @bind="workingDescription"></textarea></label>
                                        <AttributeFields Definitions="defs" Value="workingAttributes" />
                                    </div>
                                </section>
                            }
                            <section class="panel" aria-labelledby="iteration-heading">
                                <h3 id="iteration-heading">Version @p.Iteration.Label</h3>
                                <p>@(string.IsNullOrEmpty(p.Iteration.Description) ? "No description" : p.Iteration.Description)</p>
                                <dl class="facts">
                                    @foreach (var (k, v) in p.Iteration.Attributes)
                                    {
                                        var (label, text) = AttributeInput.Format(defs, k, v);
                                        <dt>@label</dt><dd>@text</dd>
                                    }
                                </dl>
                            </section>
                            @if (p.Permissions.CanAdminister && p.Revision.IsLatest)
                            {
                                <details class="admin">
                                    <summary>Administrator: set state</summary>
                                    <div class="toolbar">
                                        <select aria-label="Target state" @bind="overrideState">
                                            @foreach (var s in lifecycle!.States) { <option value="@s.State">@s.Label</option> }
                                        </select>
                                        <button type="button" class="secondary" disabled="@(busy || overrideState == p.Revision.State)" @onclick="() => confirmOverride = true">Set state…</button>
                                    </div>
                                </details>
                            }
                        </div>
                        break;
                    case "structure":
                        <div class="stack">
                            @* The page banner aggregates the part and every displayed BOM row. *@
                            <Keel.Web.Components.Pages.Bom.BomSection Part="p" OnBanner="b => bomBanner = b" />
                            @* Manufacturing BOMs per plant, with generate from this EBOM. *@
                            <Keel.Web.Components.Pages.Mbom.MbomSection Part="p" OnBanner="b => mbomBanner = b" />
                        </div>
                        break;
                    case "viewer":
                        @* 9.5: the 3D viewer of the CAD model attached to the part (ADR-0052). *@
                        <Keel.Web.Components.Pages.Cad.PartModelViewerPanel PartNumber="@p.Number" OnBanner="b => viewerBanner = b" />
                        break;
                    case "documents":
                        <PartDocumentsPanel PartNumber="@p.Number" Revision="@Revision" IterationLabel="@p.Iteration.Label" CheckedOutByMe="@(p.Checkout?.IsMine == true)"
                                            OnAddDocument="@(editAdvice.CanStart ? (() => OpenAddDocument(false)) : null)" />
                        break;
                    case "changes":
                        <Keel.Web.Components.Pages.Change.PartChangesPanel Number="@p.Number" Revision="@p.Revision.Revision" State="@p.Revision.State" Latest="@p.Revision.IsLatest"
                                                                           CanModify="@p.Permissions.CanModify" OnBanner="b => changesBanner = b" />
                        break;
                    case "review":
                        <div class="stack">
                            <PartReviewPanel Number="@p.Number" State="@p.Revision.State" />
                            <TdpExportPanel ObjectType="part" Number="@p.Number" Revision="@p.Revision.Revision" OnBanner="b => tdpBanner = b" />
                        </div>
                        break;
                    case "trace":
                        <Keel.Web.Components.Pages.Requirements.ObjectTracePanel Kind="part" Key="@p.Number" OnBanner="b => traceBanner = b" />
                        break;
                    case "timeline":
                        @* UX-3: the life of the part; the page banner also covers the other objects its entries name. *@
                        <TimelinePanel ObjectType="part" Key="@p.Number" Version="@($"{p.Revision.Revision}.{p.Iteration.Iteration}.{p.Revision.State}")"
                                       OnShown="m => timelineBanner = m.Count == 0 ? null : Markings.AggregateBanner(m)" />
                        break;
                    case "quality":
                        <Keel.Web.Components.Pages.Quality.PartQualityPanel PartNumber="@p.Number" OnBanner="b => qualityBanner = b" />
                        break;
                    case "sourcing":
                        <Keel.Web.Components.Pages.Sourcing.PartSourcingPanel PartNumber="@p.Number" OnBanner="b => sourcingBanner = b" />
                        break;
                    case "compliance":
                        <Keel.Web.Components.Pages.Compliance.PartCompliancePanel PartNumber="@p.Number" />
                        break;
                    case "classification":
                        @if (p.Revision.IsLatest)
                        {
                            <Keel.Web.Components.Pages.Classification.PartClassificationPanel Number="@p.Number" Editable="@(p.Checkout?.IsMine == true && p.Permissions.CanModify)" Version="@($"{p.Iteration.Label}|{p.Checkout is not null}")" />
                        }
                        else
                        {
                            <p class="muted">Classification is shown for the latest revision.</p>
                        }
                        break;
                    case "history":
                        <section class="panel" aria-labelledby="history-heading">
                            <h3 id="history-heading">Version history</h3>
                            <GlossaryHint Term="version" />
                            <GlossaryHint Term="revision" />
                            <div class="table-wrap"><table class="data">
                                <thead><tr><th scope="col">Version</th><th scope="col">Checked in (UTC)</th><th scope="col">By</th><th scope="col">Comment</th></tr></thead>
                                <tbody>
                                    @foreach (var h in p.History)
                                    {
                                        <tr><td>@h.Label</td><td>@UiText.Utc(h.CreatedAt)</td><td>@h.CreatedBy</td><td>@h.Comment</td></tr>
                                    }
                                </tbody>
                            </table></div>
                        </section>
                        break;
                    case "security":
                        <section class="panel" aria-labelledby="markings-heading">
                            <h3 id="markings-heading">Security markings</h3>
                            @if (editMarkings is null)
                            {
                                var m = p.Markings;
                                <dl class="facts">
                                    <dt>Export jurisdiction</dt>
                                    <dd>@(m.ExportJurisdiction switch { ExportJurisdiction.Itar => $"ITAR, USML {m.UsmlCategory}", ExportJurisdiction.Ear => $"EAR, ECCN {m.Eccn}", _ => "None" })</dd>
                                    <dt>CUI categories</dt><dd>@(m.CuiCategories.IsEmpty ? "None" : string.Join(", ", m.CuiCategories))</dd>
                                    <dt>Distribution</dt><dd>Statement @m.DistributionStatement@(m.ControllingOffice is null ? "" : $": {m.DistributionReason}; controlling office {m.ControllingOffice}")</dd>
                                    <dt>Program</dt><dd>@(m.Program ?? "None")</dd>
                                    <dt>Owning organization</dt><dd>@m.OwningOrg</dd>
                                    <dt>Export authorizations</dt><dd>@(m.ExportAuthorizations.IsEmpty ? "None" : string.Join(", ", m.ExportAuthorizations))</dd>
                                </dl>
                                @if (p.Permissions.CanModify && p.Revision.IsLatest && !p.Revision.IsLocked)
                                {
                                    <button type="button" class="secondary" @onclick="() => editMarkings = MarkingsInput.From(p.Markings)">Change markings</button>
                                }
                            }
                            else
                            {
                                <div class="stack">
                                    <div class="grid-form">
                                        <MarkingsFields Value="editMarkings" />
                                        <label class="wide">Reason for change (required, audited) <input @bind="markingsReason" /></label>
                                    </div>
                                    <div class="toolbar">
                                        <button type="button" disabled="@busy" @onclick="SaveMarkings">Save markings</button>
                                        <button type="button" class="secondary" @onclick="() => editMarkings = null">Cancel</button>
                                    </div>
                                </div>
                            }
                        </section>
                        break;
                    case "activity":
                        <ActivityFeed Kind="@ObjectKinds.Part" Number="@p.Number" />
                        break;
                    case "comments":
                        <CommentThread Kind="@ObjectKinds.Part" Number="@p.Number" OnCount="c => commentCount = c" />
                        break;
                }
            </TabSet>
        </article>

        <ConfirmDialog @bind-Open="confirmDiscard" Title="@P["Part.DiscardTitle"]" Destructive="true" ConfirmText="@P["Part.Discard"]" OnConfirm='_ => Run(s => Flows.DiscardAsync(s, Number, Corr()), P["Part.Discarded"].Value)'>
            <p>@P["Part.DiscardBody", p.Number]</p>
        </ConfirmDialog>
        <AddDocumentDialog @bind-Open="addDocOpen" Part="p" StartCreate="addDocCreate" OnAdded="OnDocumentAdded" />
        <ConfirmDialog @bind-Open="confirmUndo" Title="@P["Part.UndoTitle"]" Destructive="true" ConfirmText="@P["Part.UndoCheckOut"]" OnConfirm='_ => Run(s => Parts.UndoCheckOutAsync(s, Number, Corr()), P["Part.UndoDone"].Value)'>
            <p>@P["Part.UndoBody", p.Number]</p>
        </ConfirmDialog>
        <ConfirmDialog @bind-Open="confirmOverride" Title="@P["Part.SetStateTitle", lifecycle?.State(overrideState)?.Label ?? overrideState]" Destructive="true" ConfirmText="@P["Part.SetState"]"
                       ReasonLabel="@P["Part.OverrideReason"]" ReasonRequired="true"
                       OnConfirm='reason => Run(s => Parts.SetStateAsync(s, Number, overrideState, reason, true, Corr()), P["Part.StateSet"].Value)'>
            <p>@P["Part.OverrideBody"]</p>
        </ConfirmDialog>
    }
    else if (!notFound)
    {
        <Skeleton Lines="6" Label="@P["Part.Loading"]" />
    }
</PageFrame>

@code {
    [Parameter] public required string Number { get; set; }
    [SupplyParameterFromQuery] public string? Revision { get; set; }

    private string? seenUri; // the address the tab was last taken from (GAP-A-4)

    private static readonly string[] TabIds = ["overview", "structure", "viewer", "documents", "changes", "review", "classification", "history", "timeline", "security", "sourcing", "quality", "compliance", "trace", .. AwarenessTabs.Ids];
    // Fewer, calmer tabs (ADR-0062): the rarely used ones share a group tab with a second row. Ids and deep links are unchanged.
    private const string TrailGroup = "Audit trail", DesignGroup = "Design", SupplyGroup = "Supply & checks";
    private static readonly IReadOnlyList<TabInfo> EnglishTabs =
    [
        new("overview", "Overview"), new("structure", "Structure"), new("documents", "Documents"),
        new("changes", "Changes", Group: TrailGroup), new("history", "History", Group: TrailGroup), new("timeline", "Timeline", Group: TrailGroup),
        new("review", "Review & release"), new("security", "Security markings"),
        new("viewer", "Viewer", Group: DesignGroup), new("classification", "Classification", Group: DesignGroup),
        new("sourcing", "Sourcing", Group: SupplyGroup), new("quality", "Quality", Group: SupplyGroup), new("compliance", "Compliance", Group: SupplyGroup), new("trace", "Trace", Group: SupplyGroup),
    ];

    // The tab ids are the identity (address bar, saved state); only the shown text is translated (resource keys Part.Tab.<id>).
    private IReadOnlyList<TabInfo> Tabs => [.. EnglishTabs.Select(t => t with { Title = P.Or("Part.Tab." + t.Id, t.Title), Group = t.Group is null ? null : P.Or("Part.TabGroup." + Slug(t.Group), t.Group) })];
    private static string Slug(string g) => g.StartsWith("Audit", StringComparison.Ordinal) ? "trail" : g.StartsWith("Design", StringComparison.Ordinal) ? "design" : "supply";
    private string TrailTitle => P.Or("Part.TabGroup.trail", TrailGroup);

    /// <summary>The Viewer tab is offered where a CAD model is attached to the part.</summary>
    private IReadOnlyList<TabInfo> VisibleTabs => hasModel ? Tabs : [.. Tabs.Where(t => t.Id != "viewer")];
    private bool hasModel;
    private string? viewerBanner; // banner of the CAD models the Viewer tab lists and shows (9.5)

    private PartDetail? part;
    private IReadOnlyList<AttributeDefinition>? defs;
    private Lifecycle? lifecycle;
    private bool notFound, busy, confirmUndo, confirmOverride, confirmDiscard, addDocOpen, addDocCreate;
    private string note = "";
    private string? error;
    private string tab = "overview";
    private int? commentCount; // number of comments, shown on the Comments tab (UX-4)
    private string workingDescription = "", comment = "", overrideState = "", markingsReason = "";
    private AttributeInput? workingAttributes;
    private MarkingsInput? editMarkings;
    private string? bomBanner; // aggregate banner reported by the BOM section
    private string? mbomBanner; // aggregate banner reported by the manufacturing BOM section
    private string? changesBanner; // aggregate banner reported by the changes panel
    private string? tdpBanner; // banner of the previewed Technical Data Package
    private string? timelineBanner; // banner of the objects the timeline entries name (UX-3)
    private string? qualityBanner; // banner of the deviations, reports and actions the Quality tab shows (8.1)
    private string? sourcingBanner; // banner of the suppliers and related parts the Sourcing tab shows (8.2)
    private string? traceBanner; // banner of the requirements the Trace tab names (8.3)

    private string PageTitle => part is null ? P["Part.Title"].Value : $"{part.Number} · {part.Name}";
    private IReadOnlyList<Crumb> Crumbs => [new(P["Parts.Title"], "parts"), new(part?.Number ?? Number)];

    private static string Corr() => CurrentUser.NewCorrelationId();

    private Task Refresh() => OnParametersSetAsync();

    // Unsaved edits: the working copy form differs from what was last saved.
    private bool IsDirty => part?.Checkout is { IsMine: true } co && workingAttributes is not null && defs is not null
        && (workingDescription != (co.Description ?? "") || workingAttributes.ToJson(defs).ToJsonString() != (co.Attributes?.ToJsonString() ?? "{}"));

    private RenderFragment HeaderFragment(PartDetail p) => @<ObjectHeader Title="@PageTitle" Banner="@p.Banner">
        <Facts>
            <div><dt>@P["Part.Fact.Type"]</dt><dd>@p.PartType</dd></div>
            <div><dt>@P["Part.Fact.Source"]</dt><dd>@p.Source</dd></div>
            <div><dt>@P["Part.Fact.Unit"]</dt><dd>@UiLanguage.Unit(p.DefaultUnit, C)</dd></div>
            <div><dt>@P["Part.Fact.CreatedBy"]</dt><dd>@p.CreatedBy</dd></div>
        </Facts>
        <Badges>
            <span class="badge">@P["Part.Version", p.Iteration.Label]</span>
            <span class="badge state-@p.Revision.State.ToLowerInvariant()">@C.Or(LocalizationServices.Key("State", p.Revision.StateLabel), p.Revision.StateLabel)</span>
            @if (p.Revision.IsLocked) { <span class="badge">@P["Part.Locked"]</span> }
            <FavoriteButton Kind="@ObjectKinds.Part" Number="@p.Number" />
            <WatchButton Kind="@ObjectKinds.Part" Number="@p.Number" />
            <Keel.Web.Components.Pages.Records.RecordsChip Kind="part" Number="@p.Number" />
        </Badges>
        <Steps>
            @if (lifecycle is not null)
            {
                <Stepper States="lifecycle.States" Current="@p.Revision.State" Reachable="@(p.Transitions.Where(t => t.Allowed).Select(t => t.To).ToHashSet())" Label="@P["Part.Lifecycle"]" />
            }
            <ReviewStrip ObjectType="part" Number="@p.Number" Noun="part" Version="@p.Revision.State" OnChanged="Refresh"
                         CanStart="@(p.Revision.IsLatest && p.Revision.State == "InWork" && p.Checkout is null && p.Permissions.CanModify)"
                         WhyNot="@(p.Revision.IsLatest && p.Revision.State == "InWork" && !(p.Checkout is null && p.Permissions.CanModify) ? (p.Checkout is not null ? "Save or discard your edit before submitting for review." : "You may not submit this part for review.") : null)" />
        </Steps>
        <ChildContent>
            @if (p.Revisions.Count > 1)
            {
                <nav class="toolbar" aria-label="@P["Part.Revisions"]">
                    @foreach (var r in p.Revisions)
                    {
                        <a href="@($"parts/{Uri.EscapeDataString(p.Number)}{(r.IsLatest ? "" : $"?revision={r.Revision}")}")" aria-current="@(r.Id == p.Revision.Id ? "page" : null)">@P["Part.Rev", r.Revision, C.Or(LocalizationServices.Key("State", r.StateLabel), r.StateLabel)]</a>
                    }
                </nav>
            }
        </ChildContent>
    </ObjectHeader>;

    private void OnTabChanged(string id)
    {
        tab = id;
        // Panels of a tab that is no longer shown no longer contribute to the banner.
        bomBanner = mbomBanner = changesBanner = tdpBanner = timelineBanner = sourcingBanner = qualityBanner = viewerBanner = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        bomBanner = null; // the BOM section republishes its aggregate banner after it reloads
        changesBanner = null; // likewise the changes panel
        tab = TabSet.OnNavigation(Nav.Uri, ref seenUri, TabIds, tab);
        await using (var conn = await Db.OpenConnectionAsync())
        {
            defs = await AttributeValidator.LoadAsync(conn, null, PartService.ObjectType, CancellationToken.None);
        }
        var outcome = await Parts.GetAsync(await Users.GetAsync(), Number, Revision, Corr());
        if (outcome.Value is { } found) // the part's own lifecycle version (versions are data)
        {
            await using var lcConn = await Db.OpenConnectionAsync();
            lifecycle = await Lifecycle.LoadAsync(lcConn, null, found.LifecycleId, CancellationToken.None);
        }
        notFound = !outcome.IsOk;
        hasModel = outcome.IsOk && await CadGraph.HasModelAsync(await Users.GetAsync(), Number);
        Apply(outcome.Value);
    }

    private void Apply(PartDetail? p)
    {
        part = p;
        if (p is null) return;
        overrideState = p.Revision.State;
        if (p.Checkout?.IsMine == true)
        {
            workingDescription = p.Checkout.Description ?? "";
            workingAttributes = AttributeInput.From(p.Checkout.Attributes);
        }
        else workingAttributes = null;
    }

    private async Task<bool> Run(Func<Subject, Task<Outcome<PartDetail>>> op, string? success = null)
    {
        busy = true;
        error = null;
        var outcome = await op(await Users.GetAsync());
        busy = false;
        if (outcome.IsOk)
        {
            Apply(outcome.Value);
            if (success is not null) Toasts.Success(success);
            return true;
        }
        error = UiText.Message(outcome, C);
        return false;
    }

    private PartEditAdvice editAdvice => part is null ? new(PartEditState.ReadOnly, "") : SimpleFlows.Advise(part);

    // Edit: check-out when needed, then show the form (ADR 0061). The module's check-out decides; a refusal is shown as it is.
    private async Task StartEdit()
    {
        busy = true;
        error = null;
        var outcome = await Flows.BeginEditAsync(await Users.GetAsync(), Number, Corr());
        busy = false;
        if (outcome.IsOk) { Apply(outcome.Value); tab = "overview"; Toasts.Success(P["Part.EditNow"]); }
        else error = UiText.Message(outcome, C);
    }

    // Save: store the draft and check in as the next version, with the optional note.
    private async Task SaveSimple()
    {
        busy = true;
        error = null;
        var outcome = await Flows.SaveAsync(await Users.GetAsync(), Number, workingDescription, workingAttributes!.ToJson(defs!), note, Corr());
        busy = false;
        if (outcome.IsOk) { Apply(outcome.Value); note = ""; Toasts.Success(P["Part.SavedAs", outcome.Value!.Iteration.Label]); }
        else error = UiText.Message(outcome, C);
    }

    private void OpenAddDocument(bool create) { addDocCreate = create; addDocOpen = true; }

    private async Task OnDocumentAdded(AddDocumentResult result)
    {
        if (result.IsOk) { Toasts.Success(result.Message); OnTabChanged("documents"); } else error = result.Message; // show where the file now is
        await Refresh();
    }

    private Task SaveWorkingCopy() =>
        Run(s => Parts.UpdateWorkingCopyAsync(s, Number, workingDescription, workingAttributes!.ToJson(defs!), Corr()), P["Part.WorkingCopySaved"].Value);

    // Check-in saves the open working copy first so unsaved edits are never silently dropped.
    private async Task CheckIn()
    {
        if (await Run(s => Parts.UpdateWorkingCopyAsync(s, Number, workingDescription, workingAttributes!.ToJson(defs!), Corr())))
        {
            var c = comment;
            if (await Run(s => Parts.CheckInAsync(s, Number, c, Corr()), P["Part.CheckedIn"].Value)) comment = "";
        }
    }

    private async Task SaveMarkings()
    {
        var m = editMarkings!.Effective().ToMarkings();
        if (!m.IsSuccess) { error = string.Join(" ", m.Errors); return; }
        if (await Run(s => Parts.ChangeMarkingsAsync(s, Number, m.Value, markingsReason, Corr()), P["Part.MarkingsChanged"].Value)) { editMarkings = null; markingsReason = ""; }
    }
}
