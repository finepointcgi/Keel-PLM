@page "/parts/{Number}"
@inject CurrentUser Users
@inject PartService Parts
@inject NpgsqlDataSource Db
@using Npgsql
@using Keel.Web.Components.Pages.Workflow

<PageFrame Banner="@BannerMerge.Union(bomBanner ?? part?.Banner ?? UiText.Unclassified, changesBanner, tdpBanner)" Title="Part">
    @if (notFound)
    {
        <p class="error" role="alert">Part @Number was not found, or you are not authorized to see it.</p>
    }
    else if (part is not null && defs is not null)
    {
        var p = part;
        <article class="stack">
            <header class="part-header">
                <div>
                    <h2>@p.Number · @p.Name</h2>
                    <p class="muted">@p.PartType · @p.Source · unit @p.DefaultUnit · created by @p.CreatedBy</p>
                </div>
                <div class="badges">
                    <span class="badge">Version @p.Iteration.Label</span>
                    <span class="badge state-@p.Revision.State.ToLowerInvariant()">@p.Revision.StateLabel</span>
                    @if (p.Revision.IsLocked) { <span class="badge">Locked</span> }
                </div>
            </header>

            @if (p.Revisions.Count > 1)
            {
                <nav class="toolbar" aria-label="Revisions">
                    @foreach (var r in p.Revisions)
                    {
                        <a href="@($"parts/{Uri.EscapeDataString(p.Number)}{(r.IsLatest ? "" : $"?revision={r.Revision}")}")" aria-current="@(r.Id == p.Revision.Id ? "page" : null)">Rev @r.Revision (@r.StateLabel)</a>
                    }
                </nav>
            }

            @if (error is not null) { <p class="error" role="alert">@error</p> }
            @if (!p.Permissions.CanModify)
            {
                <p class="muted">Read only: @string.Join(" ", p.Permissions.ModifyDeniedReasons.Select(UiText.Reason))</p>
            }

            @if (p.Revision.IsLatest)
            {
                var co = p.Checkout;
                <section class="panel">
                    <h3>Work</h3>
                    @if (co is not null && !co.IsMine)
                    {
                        <p>Checked out by @(co.UserName ?? co.UserId) since @UiText.Utc(co.CheckedOutAt).</p>
                    }
                    <div class="toolbar">
                        @if (co is null && p.Permissions.CanModify && !p.Revision.IsLocked)
                        {
                            <button type="button" disabled="@busy" @onclick="() => Run(s => Parts.CheckOutAsync(s, Number, Corr()))">Check out</button>
                        }
                        @if (co is not null && (co.IsMine || p.Permissions.CanAdminister))
                        {
                            <button type="button" class="secondary" disabled="@busy" @onclick="() => Run(s => Parts.UndoCheckOutAsync(s, Number, Corr()))">Undo check-out</button>
                        }
                        @foreach (var t in p.Transitions)
                        {
                            <button type="button" class="secondary" disabled="@(!t.Allowed || busy)" title="@t.Reason"
                                    @onclick="() => Run(s => Parts.SetStateAsync(s, Number, t.To, null, false, Corr()))">Move to @t.Label</button>
                        }
                    </div>
                    @foreach (var t in p.Transitions.Where(t => !t.Allowed && t.Reason is not null))
                    {
                        <p class="muted small">@t.Label: @t.Reason</p>
                    }

                    @if (co?.IsMine == true && workingAttributes is not null)
                    {
                        <div class="stack">
                            <p class="muted">You have this part checked out. Changes stay private until you check in.</p>
                            <div class="grid-form">
                                <label class="wide">Description <textarea rows="3" maxlength="4000" @bind="workingDescription"></textarea></label>
                                <AttributeFields Definitions="defs" Value="workingAttributes" />
                            </div>
                            <div class="toolbar">
                                <button type="button" class="secondary" disabled="@busy" @onclick="SaveWorkingCopy">Save working copy</button>
                                <input aria-label="Check-in comment" placeholder="Check-in comment" class="grow" @bind="comment" />
                                <button type="button" disabled="@busy" @onclick="CheckIn">Check in</button>
                            </div>
                        </div>
                    }

                    @if (p.Permissions.CanAdminister)
                    {
                        <details class="admin">
                            <summary>Administrator: set state</summary>
                            <div class="toolbar">
                                <select aria-label="Target state" @bind="overrideState">
                                    @foreach (var s in lifecycle!.States) { <option value="@s.State">@s.Label</option> }
                                </select>
                                <input aria-label="Override reason" placeholder="Reason (required, audited)" class="grow" @bind="overrideReason" />
                                <button type="button" disabled="@(busy || overrideState == p.Revision.State)"
                                        @onclick="() => Run(s => Parts.SetStateAsync(s, Number, overrideState, overrideReason, true, Corr()))">Set state</button>
                            </div>
                        </details>
                    }
                </section>
            }

            @* Increment 1.5: submit for review, review status and release history. *@
            <PartReviewPanel Number="@p.Number" State="@p.Revision.State" Latest="@p.Revision.IsLatest" CheckedOut="@(p.Checkout is not null)"
                             CanModify="@p.Permissions.CanModify" OnChanged="Refresh" />

            @* --- Changes panel (increment 1.6): open changes listing this part and the notice a revision belongs to --- *@
            <Keel.Web.Components.Pages.Change.PartChangesPanel Number="@p.Number" Revision="@p.Revision.Revision" State="@p.Revision.State" Latest="@p.Revision.IsLatest"
                                                               CanModify="@p.Permissions.CanModify" OnBanner="b => changesBanner = b" />
            @* --- end changes panel --- *@

            <section class="panel">
                <h3>Iteration @p.Iteration.Label</h3>
                <p>@(string.IsNullOrEmpty(p.Iteration.Description) ? "No description" : p.Iteration.Description)</p>
                <dl class="facts">
                    @foreach (var (k, v) in p.Iteration.Attributes)
                    {
                        var (label, text) = AttributeInput.Format(defs, k, v);
                        <dt>@label</dt><dd>@text</dd>
                    }
                </dl>
            </section>

            @* --- Classification (increment 2.2): the class and its attribute values belong to the iteration --- *@
            @if (p.Revision.IsLatest)
            {
                <Keel.Web.Components.Pages.Classification.PartClassificationPanel Number="@p.Number" Editable="@(p.Checkout?.IsMine == true && p.Permissions.CanModify)" Version="@($"{p.Iteration.Label}|{p.Checkout is not null}")" />
            }
            @* --- end classification --- *@

            @* ---- Linked documents (increment 1.3, ADR-0016) ---- *@
            <PartDocumentsPanel PartNumber="@p.Number" Revision="@Revision" IterationLabel="@p.Iteration.Label" CheckedOutByMe="@(p.Checkout?.IsMine == true)" />
            @* ---- end linked documents ---- *@
            @* --- BOM section (increment 1.4): the page banner then aggregates the part and every displayed BOM row --- *@
            <Keel.Web.Components.Pages.Bom.BomSection Part="p" OnBanner="b => bomBanner = b" />
            @* --- end BOM section --- *@
            @* --- 4.0 Technical Data Package export (ADR-0025) --- *@
            <TdpExportPanel ObjectType="part" Number="@p.Number" Revision="@p.Revision.Revision" OnBanner="b => tdpBanner = b" />

            <section class="panel">
                <h3>Security markings</h3>
                @if (editMarkings is null)
                {
                    var m = p.Markings;
                    <dl class="facts">
                        <dt>Export jurisdiction</dt>
                        <dd>@(m.ExportJurisdiction switch { ExportJurisdiction.Itar => $"ITAR, USML {m.UsmlCategory}", ExportJurisdiction.Ear => $"EAR, ECCN {m.Eccn}", _ => "None" })</dd>
                        <dt>CUI categories</dt><dd>@(m.CuiCategories.IsEmpty ? "None" : string.Join(", ", m.CuiCategories))</dd>
                        <dt>Distribution</dt><dd>Statement @m.DistributionStatement@(m.ControllingOffice is null ? "" : $": {m.DistributionReason}; controlling office {m.ControllingOffice}")</dd>
                        <dt>Program</dt><dd>@(m.Program ?? "None")</dd>
                        <dt>Owning organization</dt><dd>@m.OwningOrg</dd>
                        <dt>Export authorizations</dt><dd>@(m.ExportAuthorizations.IsEmpty ? "None" : string.Join(", ", m.ExportAuthorizations))</dd>
                    </dl>
                    @if (p.Permissions.CanModify && p.Revision.IsLatest && !p.Revision.IsLocked)
                    {
                        <button type="button" class="secondary" @onclick="() => editMarkings = MarkingsInput.From(p.Markings)">Change markings</button>
                    }
                }
                else
                {
                    <div class="stack">
                        <div class="grid-form">
                            <MarkingsFields Value="editMarkings" />
                            <label class="wide">Reason for change (required, audited) <input @bind="markingsReason" /></label>
                        </div>
                        <div class="toolbar">
                            <button type="button" disabled="@busy" @onclick="SaveMarkings">Save markings</button>
                            <button type="button" class="secondary" @onclick="() => editMarkings = null">Cancel</button>
                        </div>
                    </div>
                }
            </section>

            <section class="panel">
                <h3>History</h3>
                <div class="table-wrap"><table class="data">
                    <thead><tr><th scope="col">Version</th><th scope="col">Checked in (UTC)</th><th scope="col">By</th><th scope="col">Comment</th></tr></thead>
                    <tbody>
                        @foreach (var h in p.History)
                        {
                            <tr><td>@h.Label</td><td>@UiText.Utc(h.CreatedAt)</td><td>@h.CreatedBy</td><td>@h.Comment</td></tr>
                        }
                    </tbody>
                </table></div>
            </section>
        </article>
    }
</PageFrame>

@code {
    [Parameter] public required string Number { get; set; }
    [SupplyParameterFromQuery] public string? Revision { get; set; }

    private PartDetail? part;
    private IReadOnlyList<AttributeDefinition>? defs;
    private Lifecycle? lifecycle;
    private bool notFound, busy;
    private string? error;
    private string workingDescription = "", comment = "", overrideState = "", overrideReason = "", markingsReason = "";
    private AttributeInput? workingAttributes;
    private MarkingsInput? editMarkings;
    private string? bomBanner; // 1.4: aggregate banner reported by the BOM section
    private string? changesBanner; // 1.6: aggregate banner reported by the changes panel
    private string? tdpBanner; // 4.0: banner of the previewed Technical Data Package

    private static string Corr() => CurrentUser.NewCorrelationId();

    private Task Refresh() => OnParametersSetAsync();

    protected override async Task OnParametersSetAsync()
    {
        bomBanner = null; // 1.4: the BOM section republishes its aggregate banner after it reloads
        changesBanner = null; // 1.6: likewise the changes panel
        await using (var conn = await Db.OpenConnectionAsync())
        {
            defs = await AttributeValidator.LoadAsync(conn, null, PartService.ObjectType, CancellationToken.None);
        }
        var outcome = await Parts.GetAsync(await Users.GetAsync(), Number, Revision, Corr());
        if (outcome.Value is { } found) // 2.2: the part's own lifecycle version (versions are data)
        {
            await using var lcConn = await Db.OpenConnectionAsync();
            lifecycle = await Lifecycle.LoadAsync(lcConn, null, found.LifecycleId, CancellationToken.None);
        }
        notFound = !outcome.IsOk;
        Apply(outcome.Value);
    }

    private void Apply(PartDetail? p)
    {
        part = p;
        if (p is null) return;
        overrideState = p.Revision.State;
        if (p.Checkout?.IsMine == true)
        {
            workingDescription = p.Checkout.Description ?? "";
            workingAttributes = AttributeInput.From(p.Checkout.Attributes);
        }
        else workingAttributes = null;
    }

    private async Task<bool> Run(Func<Subject, Task<Outcome<PartDetail>>> op)
    {
        busy = true;
        error = null;
        var outcome = await op(await Users.GetAsync());
        busy = false;
        if (outcome.IsOk) { Apply(outcome.Value); return true; }
        error = UiText.Message(outcome);
        return false;
    }

    private Task SaveWorkingCopy() =>
        Run(s => Parts.UpdateWorkingCopyAsync(s, Number, workingDescription, workingAttributes!.ToJson(defs!), Corr()));

    // Check-in saves the open working copy first so unsaved edits are never silently dropped.
    private async Task CheckIn()
    {
        if (await Run(s => Parts.UpdateWorkingCopyAsync(s, Number, workingDescription, workingAttributes!.ToJson(defs!), Corr())))
        {
            var c = comment;
            if (await Run(s => Parts.CheckInAsync(s, Number, c, Corr()))) comment = "";
        }
    }

    private async Task SaveMarkings()
    {
        var m = editMarkings!.Effective().ToMarkings();
        if (!m.IsSuccess) { error = string.Join(" ", m.Errors); return; }
        if (await Run(s => Parts.ChangeMarkingsAsync(s, Number, m.Value, markingsReason, Corr()))) { editMarkings = null; markingsReason = ""; }
    }
}
