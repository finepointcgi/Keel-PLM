@page "/parts"
@inject CurrentUser Users
@inject PartService Parts

<PageFrame Banner="@(result?.PageBanner ?? UiText.Unclassified)" Title="Parts" Crumbs="@Crumbs">
    <form class="toolbar" role="search" @onsubmit="() => Search(0)">
        <input aria-label="Search parts" placeholder="Number or name" class="grow" @bind="query" />
        <select aria-label="State" @bind="state" @bind:after="() => Search(0)">
            <option value="">Any state</option>
            <option value="InWork">In Work</option>
            <option value="UnderReview">Under Review</option>
            <option value="Released">Released</option>
            <option value="Obsolete">Obsolete</option>
        </select>
        <button type="submit">Search</button>
        <AuthorizeView Roles="@($"{Roles.Author},{Roles.Admin}")">
            <a class="button secondary" href="parts/new">New part</a>
        </AuthorizeView>
        <a class="button secondary" href="parts/classification">By classification</a>
    </form>

    @if (result is not null)
    {
        <p class="muted">@result.Total part@(result.Total == 1 ? "" : "s") you can access</p>
        <DataTable TItem="PartSummary" TableId="parts" Items="result.Items" Columns="Columns" Caption="Parts" OnServerSort="OnSort" ServerSort="sort">
            <Empty>
                <EmptyState Title="@(query.Length > 0 || state != "" ? "No parts match" : "No parts yet")" IconName="part"
                            ActionHref="@(query.Length > 0 || state != "" ? null : "parts/new")" ActionText="New part">
                    @(query.Length > 0 || state != "" ? "Try a different number or name, or choose Any state." : "Create the first part to start building products.")
                </EmptyState>
            </Empty>
        </DataTable>
        <Pager Total="result.Total" Offset="offset" PageSize="PageSize" OnPage="Search" />
    }
    else
    {
        <Skeleton Lines="6" Label="Loading parts" />
    }
</PageFrame>

@code {
    private const int PageSize = 50;
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    private SortSpec? sort;
    private bool sortLoaded;

    // The order lives in the address bar (GAP-A-1). A stale or hand-edited value that is not one of the module's sort keys falls back to the default order.
    protected override async Task OnParametersSetAsync()
    {
        _ = PartService.SortKeys.TryResolve(SortParam, DirParam, out var requested, out _);
        if (sortLoaded && requested == sort) return;
        (sort, sortLoaded) = (requested, true);
        await Search(0);
    }

    private async Task OnSort((string Key, bool Descending) s)
    {
        sort = new SortSpec(s.Key, s.Descending);
        await Search(0);
    }

    private string query = "";
    private string state = "";
    private int offset;
    private PartSearchResult? result;

    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Parts")];

    private static readonly IReadOnlyList<DataColumn<PartSummary>> Columns =
    [
        new() { Key = "number", Title = "Number", Required = true, ServerSortKey = "number", Cell = p => @<a href="parts/@Uri.EscapeDataString(p.Number)">@p.Number</a> },
        new() { Key = "name", Title = "Name", ServerSortKey = "name", Text = p => p.Name },
        new() { Key = "type", Title = "Type", ServerSortKey = "type", Text = p => p.PartType },
        new() { Key = "version", Title = "Version", ServerSortKey = "version", Text = p => $"{p.Revision}.{p.Iteration}" },
        new() { Key = "state", Title = "State", ServerSortKey = "state", Text = p => StateText.Label(p.State) },
        new() { Key = "markings", Title = "Markings", Required = true, Cell = p => @<MarkingChip Text="@p.Banner" /> },
    ];

    private async Task Search(int newOffset)
    {
        offset = newOffset;
        result = await Parts.SearchAsync(await Users.GetAsync(), query, state == "" ? null : state, PageSize, offset, sort, CurrentUser.NewCorrelationId());
    }
}
