@page "/parts"
@inject CurrentUser Users
@inject PartService Parts
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C

<PageFrame Banner="@(result?.PageBanner ?? UiText.Unclassified)" Title="@P["Parts.Title"]" Crumbs="@Crumbs">
    <form class="toolbar" role="search" @onsubmit="() => Search(0)">
        <input aria-label="@P["Parts.Search"]" placeholder="@C["Search.Placeholder"]" class="grow" @bind="query" />
        <select aria-label="@C["State"]" @bind="state" @bind:after="() => Search(0)">
            <option value="">@C["State.Any"]</option>
            @foreach (var s in States) { <option value="@s">@C.StateLabel(s)</option> }
        </select>
        <button type="submit">@C["Search"]</button>
        <AuthorizeView Roles="@($"{Roles.Author},{Roles.Admin}")">
            <a class="button" href="parts/new" data-action="create-part">@P["Parts.Create"]</a>
        </AuthorizeView>
        <a class="button secondary" href="parts/classification">@P["Parts.ByClassification"]</a>
    </form>

    @if (result is not null)
    {
        <section class="list-card">
            <p class="list-title">@P.Count("Parts.Count", result.Total)</p>
            <DataTable TItem="PartSummary" TableId="parts" Items="result.Items" Columns="Columns" Caption="@P["Parts.Title"]" OnServerSort="OnSort" ServerSort="sort">
                <Empty>
                    <EmptyState Title="@(query.Length > 0 || state != "" ? P["Parts.NoMatch"] : P["Parts.None"])" IconName="part"
                                ActionHref="@(query.Length > 0 || state != "" ? null : "parts/new")" ActionText="@P["Parts.Create"]">
                        @(query.Length > 0 || state != "" ? P["Parts.NoMatchHelp"] : P["Parts.NoneHelp"])
                    </EmptyState>
                </Empty>
            </DataTable>
        </section>
        <Pager Total="result.Total" Offset="offset" PageSize="PageSize" OnPage="Search" />
    }
    else
    {
        <Skeleton Lines="6" Label="@P["Parts.Loading"]" />
    }
</PageFrame>

@code {
    private const int PageSize = 50;
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    // The search box on Home arrives here as ?q=text: the first search starts from it.
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    private SortSpec? sort;
    private bool sortLoaded;

    // The order lives in the address bar (GAP-A-1). A stale or hand-edited value that is not one of the module's sort keys falls back to the default order.
    protected override async Task OnParametersSetAsync()
    {
        _ = PartService.SortKeys.TryResolve(SortParam, DirParam, out var requested, out _);
        if (!sortLoaded && !string.IsNullOrWhiteSpace(QueryParam)) query = QueryParam.Trim();
        if (sortLoaded && requested == sort) return;
        (sort, sortLoaded) = (requested, true);
        await Search(0);
    }

    private async Task OnSort((string Key, bool Descending) s)
    {
        sort = new SortSpec(s.Key, s.Descending);
        await Search(0);
    }

    private string query = "";
    private string state = "";
    private int offset;
    private PartSearchResult? result;

    private static readonly string[] States = ["InWork", "UnderReview", "Released", "Obsolete"];

    private IReadOnlyList<Crumb> Crumbs => [new(P["Parts.Title"])];

    // Built per render: the titles and state labels follow the language of the circuit (ADR 0057).
    private IReadOnlyList<DataColumn<PartSummary>> Columns =>
    [
        new() { Key = "number", Title = C["Column.Number"], Required = true, ServerSortKey = "number", Cell = p => @<a class="row-id" href="parts/@Uri.EscapeDataString(p.Number)">@p.Number</a> },
        new() { Key = "name", Title = C["Column.Name"], ServerSortKey = "name", Cell = p => @<a class="row-name" href="parts/@Uri.EscapeDataString(p.Number)">@p.Name</a>, Text = p => p.Name },
        new() { Key = "type", Title = C["Column.Type"], ServerSortKey = "type", Text = p => p.PartType },
        new() { Key = "version", Title = C["Column.Version"], ServerSortKey = "version", Text = p => $"{p.Revision}.{p.Iteration}" },
        new() { Key = "state", Title = C["Column.State"], ServerSortKey = "state", Cell = p => @<span class="badge state-@p.State.ToLowerInvariant()">@C.StateLabel(p.State)</span>, Text = p => C.StateLabel(p.State) },
        new() { Key = "markings", Title = C["Column.Markings"], Required = true, Cell = p => @<MarkingChip Text="@p.Banner" Compact="true" /> },
    ];

    private async Task Search(int newOffset)
    {
        offset = newOffset;
        result = await Parts.SearchAsync(await Users.GetAsync(), query, state == "" ? null : state, PageSize, offset, sort, CurrentUser.NewCorrelationId());
    }
}
