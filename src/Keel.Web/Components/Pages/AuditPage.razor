@page "/audit"
@attribute [Authorize(Policy = Policies.Auditor)]
@inject CurrentUser Users
@inject AuditLogService AuditLog

@* ASSUMPTION(A20): audit records reveal who accessed export-controlled data, so the audit view is marked CUI. *@
<PageFrame Banner="CUI" Title="Audit log" Crumbs="@Crumbs">
    <div class="toolbar">
        <button type="button" @onclick="Verify" disabled="@busy">Verify chain</button>
        <button type="button" class="secondary" @onclick="Load" disabled="@busy">Refresh</button>
    </div>
    @if (verification is not null)
    {
        <div class="@(verification.Valid ? "permit" : "deny")" role="status">
            @(verification.Valid
                ? $"Chain valid: {verification.EventsChecked} events, {verification.CheckpointsChecked} signed checkpoints."
                : $"Chain INVALID: {string.Join("; ", verification.Failures)}")
        </div>
    }
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (events is not null)
    {
        <DataTable TItem="AuditRecord" TableId="audit" Items="events" Columns="Columns" Caption="Audit events">
            <Empty><EmptyState Title="No audit events" IconName="audit">Events are recorded as people work. Nothing has been recorded yet.</EmptyState></Empty>
        </DataTable>
    }
</PageFrame>

@code {
    private const int PageSize = 200;
    private IReadOnlyList<AuditRecord>? events;
    private VerificationResult? verification;
    private string? error;
    private bool busy;

    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Audit log")];

    private static readonly IReadOnlyList<DataColumn<AuditRecord>> Columns =
    [
        new() { Key = "seq", Title = "Seq", Required = true, SortValue = e => e.Seq, Text = e => e.Seq.ToString(System.Globalization.CultureInfo.InvariantCulture) },
        new() { Key = "time", Title = "Time (UTC)", SortValue = e => e.OccurredAt, Text = e => UiText.Utc(e.OccurredAt) },
        new() { Key = "actor", Title = "Actor", SortValue = e => AuditLogService.ActorName(e) ?? e.Actor, Cell = e => @<span title="@e.Actor">@(AuditLogService.ActorName(e) ?? e.Actor)</span> },
        new() { Key = "action", Title = "Action", SortValue = e => e.Action, Text = e => e.Action },
        new() { Key = "object", Title = "Object", Text = e => $"{e.ObjectType} {e.ObjectId}" },
        new() { Key = "outcome", Title = "Outcome", SortValue = e => e.Outcome.ToString(), Cell = e => @<span class="outcome-@e.Outcome.ToString().ToLowerInvariant()">@e.Outcome</span> },
        new() { Key = "hash", Title = "Hash", DefaultHidden = true, Cell = e => @<code title="@Convert.ToHexStringLower(e.Hash)">@Convert.ToHexStringLower(e.Hash)[..12]</code> },
    ];

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        busy = true;
        var outcome = await AuditLog.ListAsync(await Users.GetAsync(), new AuditQuery(Limit: PageSize, NewestFirst: true), CurrentUser.NewCorrelationId());
        if (outcome.IsOk) events = outcome.Value;
        else error = UiText.Message(outcome);
        busy = false;
    }

    private async Task Verify()
    {
        busy = true;
        var outcome = await AuditLog.VerifyAsync(await Users.GetAsync(), CurrentUser.NewCorrelationId());
        if (outcome.IsOk) verification = outcome.Value; else error = UiText.Message(outcome);
        busy = false;
    }
}
