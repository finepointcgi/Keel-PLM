@page "/"
@using Keel.Web.Components.Pages.Dashboard
@inject WorkspaceReads Reads
@inject WorkspaceService Workspace
@inject CurrentUser Users
@inject IStringLocalizer<PageStrings> P
@inject IStringLocalizer<CommonStrings> C

<PageFrame Banner="@PageBanner" Title="@P["Home.Title"]">
    <p class="muted">@P["Home.Intro"]</p>
    <form class="toolbar home-search" role="search" method="get" action="parts">
        <input name="q" type="search" aria-label="@P["Home.FindPart"]" placeholder="@C["Search.Placeholder"]" class="grow" />
        <button type="submit">@P["Home.FindPart"]</button>
    </form>
    <QuickActionsCard />
    <HomeTiles />
    <div class="cards">
        <AttentionCard OnBanner="SetBanner" />
        <ObjectCard Id="recent" Title="@P["Home.Card.recent"]" IconName="clock" Load="() => Reads.RecentAsync()" OnBanner="SetBanner" ShowDate="true"
                    EmptyTitle="@P["Home.Card.recent.EmptyTitle"]" EmptyText="@P["Home.Card.recent.EmptyText"]" />
        <ObjectCard @ref="favoritesCard" Id="favorites" Title="@P["Home.Card.favorites"]" IconName="star" Load="() => Reads.FavoritesAsync()" OnBanner="SetBanner" Removable="true" OnRemove="RemoveFavoriteAsync"
                    EmptyTitle="@P["Home.Card.favorites.EmptyTitle"]" EmptyText="@P["Home.Card.favorites.EmptyText"]" />
        <ObjectCard Id="programs" Title="@P["Home.Card.programs"]" IconName="change" Load="() => Reads.ProgramChangesAsync()" OnBanner="SetBanner"
                    EmptyTitle="@P["Home.Card.programs.EmptyTitle"]" EmptyText="@P["Home.Card.programs.EmptyText"]" />
        <ObjectCard Id="released" Title="@P["Home.Card.released"]" IconName="rocket" Load="() => Reads.RecentlyReleasedAsync()" OnBanner="SetBanner" ShowDate="true"
                    EmptyTitle="@P["Home.Card.released.EmptyTitle"]" EmptyText="@P["Home.Card.released.EmptyText"]" />
        <WatchedActivityCard OnBanner="SetBanner" />
        <RecordsCard />
        <QualityCard OnBanner="SetBanner" />
        <MyProgramWorkCard OnBanner="SetBanner" />
        <ComplianceCard OnBanner="SetBanner" />
    </div>
</PageFrame>

@code {
    // The banner of the page is the aggregate of what its cards show now (an empty or still-loading dashboard is UNCLASSIFIED).
    private readonly Dictionary<string, string?> banners = [];

    private ObjectCard? favoritesCard;

    private async Task RemoveFavoriteAsync(ResolvedItem item)
    {
        await Workspace.RemoveFavoriteAsync(await Users.GetAsync(), item.Kind, item.Number);
        if (favoritesCard is not null) await favoritesCard.ReloadCardAsync();
    }

    private string PageBanner => BannerMerge.Union(banners.Values.ToArray());

    private void SetBanner((string Id, string? Banner) update)
    {
        banners[update.Id] = update.Banner;
        StateHasChanged();
    }
}
