@page "/baselines/new"
@inject CurrentUser Users
@inject BaselineService Baselines
@inject EffectivityService Effectivity
@inject NavigationManager Nav

@* A blank form shows no controlled data; the created baseline carries the markings that cover everything it freezes (ADR-0021). *@
<PageFrame Banner="@UiText.Unclassified" Title="New baseline">
    <p><a href="baselines">Back to baselines</a></p>
    <p class="muted">A baseline freezes the exact versions of a part's structure at this moment. It starts as a draft; whoever may modify data creates it, and it
        needs read access to every item. Release and product baselines are established by e-signature review.</p>
    <EditForm Model="this" OnSubmit="Create" FormName="new-baseline" class="stack">
        <fieldset class="grid-form">
            <legend>Baseline</legend>
            <label>Root part number * <InputText @bind-Value="rootNumber" maxlength="40" required /></label>
            <label>Name * <InputText @bind-Value="name" maxlength="200" required /></label>
            <label>
                Type
                <InputSelect @bind-Value="type">@foreach (var t in types) { <option value="@t.Type">@t.Label@(t.RequiresSignoff ? " (needs sign-off)" : "")</option> }</InputSelect>
            </label>
            <label>Milestone <InputText @bind-Value="milestone" maxlength="40" placeholder="PDR, CDR, FCA, PCA" /></label>
            <label class="wide">Purpose <InputTextArea @bind-Value="purpose" rows="3" maxlength="4000" /></label>
        </fieldset>
        <fieldset class="grid-form">
            <legend>Configuration</legend>
            <label>
                Children are taken as
                <InputSelect @bind-Value="specText">
                    <option value="LatestReleased">Latest released</option>
                    <option value="Latest">Latest (including work in progress)</option>
                    <option value="Effectivity">As of a serial, lot or date</option>
                </InputSelect>
            </label>
            @if (specText == "Effectivity")
            {
                <div class="wide"><UnitFields Value="unit" Label="Baseline unit: " ContextList="contexts" /></div>
            }
            <label class="inline-check wide"><InputCheckbox @bind-Value="releasedOnly" /> Released only: refuse the baseline when any item is not Released</label>
            <label class="inline-check wide"><InputCheckbox @bind-Value="includeDocuments" /> Pin the documents linked to the items (describes and references links)</label>
            <label class="inline-check wide"><InputCheckbox @bind-Value="forceSignoff" /> Require sign-off by e-signature even if the type does not</label>
        </fieldset>
        <fieldset class="grid-form">
            <legend>Markings</legend>
            <p class="muted wide">The baseline starts with the markings of the root part. When an item is more restrictive, the baseline needs the minimal markings that cover it, and you confirm that here.</p>
            <label class="inline-check wide"><InputCheckbox @bind-Value="confirmRaise" /> Raise the baseline's markings to the minimal cover when an item needs it</label>
        </fieldset>
        @if (errors is not null)
        {
            <ul class="error" role="alert">@foreach (var e in errors) { <li>@e</li> }</ul>
        }
        <div class="toolbar">
            <button type="submit" disabled="@busy">Create baseline</button>
            <a class="button secondary" href="baselines">Cancel</a>
        </div>
    </EditForm>
    <datalist id="contexts">@foreach (var c in contextIds) { <option value="@c"></option> }</datalist>
</PageFrame>

@code {
    [SupplyParameterFromQuery(Name = "part")] public string? Part { get; set; }

    private IReadOnlyList<BaselineTypeInfo> types = [];
    private IReadOnlyList<string> contextIds = [];
    private string rootNumber = "", name = "", type = "Design", milestone = "", purpose = "", specText = "LatestReleased";
    private bool releasedOnly, includeDocuments, forceSignoff, confirmRaise, busy;
    private readonly UnitForm unit = new();
    private IReadOnlyList<string>? errors;

    protected override async Task OnInitializedAsync()
    {
        types = await Baselines.ListTypesAsync();
        rootNumber = Part ?? "";
        contextIds = [.. (await Effectivity.ListContextsAsync(await Users.GetAsync(), CurrentUser.NewCorrelationId())).Select(c => c.Id)];
    }

    private async Task Create()
    {
        EffectivityRequest? request = null;
        var spec = Enum.Parse<BomConfigSpec>(specText);
        if (spec == BomConfigSpec.Effectivity)
        {
            var (r, error) = unit.ToRequest();
            if (r is null) { errors = [error!]; return; }
            request = r;
        }
        busy = true;
        var outcome = await Baselines.CreateAsync(await Users.GetAsync(),
            new CreateBaselineCommand(rootNumber.Trim(), name, type, spec, releasedOnly, includeDocuments, purpose, string.IsNullOrWhiteSpace(milestone) ? null : milestone.Trim(),
                null, request, null, confirmRaise, forceSignoff ? true : null), CurrentUser.NewCorrelationId());
        busy = false;
        if (outcome.IsOk) Nav.NavigateTo($"baselines/{Uri.EscapeDataString(outcome.Value!.Summary.Number)}");
        else errors = outcome.Kind is OutcomeKind.Invalid or OutcomeKind.Conflict ? outcome.Errors : [UiText.Message(outcome)];
    }
}
