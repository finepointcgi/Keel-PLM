@* Shortcuts to create things. Shown only to people whose roles allow creating (the pages and services check the role again). *@
@inject CurrentUser Users
@inject IStringLocalizer<PageStrings> P

<section class="card" aria-labelledby="card-quick">
    <h2 id="card-quick"><Icon Name="plus" /> @P["Quick.Title"]</h2>
    <div class="quick-actions">
        @if (canCreate)
        {
            <a class="button" href="parts/new">@P["Parts.Create"]</a>
            <a class="button secondary" href="documents/new">@P["Documents.Create"]</a>
            <a class="button secondary" href="@ChangeUi.NewHref("ECR")">@P["Quick.NewChange"]</a>
            <a class="button secondary" href="baselines/new">@P["Quick.NewBaseline"]</a>
        }
        <a class="button secondary" href="parts">@P["Quick.BrowseParts"]</a>
        <a class="button secondary" href="access">@P["Quick.CheckAccess"]</a>
    </div>
    <p class="small muted">@P["Quick.Shortcut"]</p>
</section>

@code {
    private bool canCreate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await Users.GetAsync();
            canCreate = me.Roles.Contains(Roles.Author) || me.Roles.Contains(Roles.Admin);
        }
        catch (InvalidOperationException)
        {
            canCreate = false;
        }
    }
}
