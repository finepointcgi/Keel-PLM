@* "Needs my attention": my open workflow tasks and review requests, change tasks assigned to me, and changes I requested that were decided recently. A task on an object
   the user can no longer read is a neutral "restricted" row: no number, name or markings. *@
@inject WorkspaceReads Reads
@inject IStringLocalizer<PageStrings> P
@inject UiLanguage Language

<section class="card" aria-labelledby="card-attention">
    <h2 id="card-attention"><Icon Name="tasks" /> @P["Attention.Title"]</h2>
    @if (loading)
    {
        <Skeleton Lines="4" Label="@P["Attention.Loading"]" />
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (result is null || result.Items.Count == 0)
    {
        <EmptyState Title="@P["Attention.EmptyTitle"]" IconName="check">@P["Attention.EmptyText"]</EmptyState>
    }
    else
    {
        <ul class="items">
            @foreach (var item in result.Items)
            {
                <li>
                    <span class="main">
                        <a href="@item.Href">@item.Title</a>
                        <span class="sub">@item.Detail@(item.At is { } at ? " · " + (item.Kind == "decision" ? Language.Utc(at) : P["Attention.Due", Language.Date(at)].Value) : "")</span>
                    </span>
                    @if (item.Overdue) { <span class="badge state-obsolete error">@P["Attention.Overdue"]</span> }
                    @if (item.Markings is { } m) { <MarkingChip Text="@m.BannerText()" Compact="true" /> }
                </li>
            }
        </ul>
        <p class="small"><a href="tasks">@P["Attention.AllTasks"]</a></p>
    }
</section>

@code {
    private bool loading = true;
    private string? error;
    private CardResult<AttentionItem>? result;

    [Parameter] public EventCallback<(string Id, string? Banner)> OnBanner { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try { result = await Reads.AttentionAsync(); }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException)
        {
            error = P["Attention.LoadFailed"];
        }
        loading = false;
        await OnBanner.InvokeAsync(("attention", result?.Banner));
    }
}
