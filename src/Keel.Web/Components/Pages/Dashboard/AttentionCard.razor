@* "Needs my attention": my open workflow tasks and review requests, change tasks assigned to me, and changes I requested that were decided recently. A task on an object
   the user can no longer read is a neutral "restricted" row: no number, name or markings. *@
@inject WorkspaceReads Reads

<section class="card" aria-labelledby="card-attention">
    <h2 id="card-attention"><Icon Name="tasks" /> Needs my attention</h2>
    @if (loading)
    {
        <Skeleton Lines="4" Label="Loading your tasks" />
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (result is null || result.Items.Count == 0)
    {
        <EmptyState Title="You are all caught up" IconName="check">Reviews to sign, change tasks assigned to you and decisions on your change requests show up here.</EmptyState>
    }
    else
    {
        <ul class="items">
            @foreach (var item in result.Items)
            {
                <li>
                    <span class="main">
                        <a href="@item.Href">@item.Title</a>
                        <span class="sub">@item.Detail@(item.At is { } at ? " · " + (item.Kind == "decision" ? UiText.Utc(at) : "due " + UiText.Utc(at)[..10]) : "")</span>
                    </span>
                    @if (item.Overdue) { <span class="badge state-obsolete error">Overdue</span> }
                    @if (item.Markings is { } m) { <MarkingChip Text="@m.BannerText()" /> }
                </li>
            }
        </ul>
        <p class="small"><a href="tasks">All my tasks</a></p>
    }
</section>

@code {
    private bool loading = true;
    private string? error;
    private CardResult<AttentionItem>? result;

    [Parameter] public EventCallback<(string Id, string? Banner)> OnBanner { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try { result = await Reads.AttentionAsync(); }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException)
        {
            error = "Your tasks could not be loaded. The rest of the page is not affected.";
        }
        loading = false;
        await OnBanner.InvokeAsync(("attention", result?.Banner));
    }
}
