@inject CurrentUser Users
@inject WorkflowService Flow
@inject RequirementService Requirements
@inject ToastService Toasts

@* Review status, "Submit for review", signature history and the next revision of one specification. A release is signed over a digest of every requirement (ADR-0018, ADR-0038). *@
<section class="panel stack" aria-labelledby="req-review-heading">
    <h3 id="req-review-heading">Release review</h3>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (status is not null)
    {
        var mapInstance = status.Active ?? status.Last;
        @if (mapInstance is not null) { <WorkflowMapPanel InstanceId="@mapInstance.Id" Version="@($"{mapInstance.Status}:{mapInstance.Tasks.Count(t => t.Status != "Open")}")" /> }
        @if (status.Active is { } active)
        {
            <p><span class="badge state-underreview">Review in progress</span> Started by @active.StartedBy on @WorkflowText.Utc(active.StartedAt) · <a href="workflows/@active.Id">Workflow details</a></p>
            <ul class="plain">@foreach (var t in active.Tasks.Where(t => t.Status == "Open")) { <li>@t.Name: waiting for @(t.AssigneeName ?? WorkflowText.Role(t.RequiredRole))@(t.Overdue ? " (overdue)" : "")</li> }</ul>
            @if (active.CanCancel)
            {
                <div class="toolbar">
                    <input aria-label="Reason for cancelling the review" placeholder="Reason for cancelling (required)" class="grow" @bind="cancelReason" />
                    <button type="button" class="secondary" disabled="@busy" @onclick="Cancel">Cancel review</button>
                </div>
            }
        }
        else
        {
            @if (status.Last is { } last)
            {
                <p><span class="badge @(last.Status == InstanceStatus.Approved ? "state-released" : null)">Last review: @WorkflowText.Status(last.Status)</span> @(last.CompletedAt is { } done ? WorkflowText.Utc(done) : "") · <a href="workflows/@last.Id">Workflow details</a></p>
                @if (last.Status == InstanceStatus.Rejected) { <ul class="plain" aria-label="Rejection reasons">@foreach (var r in last.Rejections) { <li>Rejected by @r.By (@r.Username): @r.Comment</li> }</ul> }
                else if (last.Status == InstanceStatus.Cancelled) { <p class="muted">@last.CompletionNote</p> }
            }
            else { <p class="muted">This specification has not been submitted for review.</p> }
            @if (Detail.Editable && Detail.CanModify && !starting)
            {
                <button type="button" disabled="@busy" @onclick="BeginStart">Submit for review</button>
                <p class="muted small">Every requirement must be approved, deferred or withdrawn first. The signatures cover a digest of all requirements.</p>
            }
        }
        @if (starting && template is not null) { <StartReviewDialog Template="template" Search="SearchUsers" OnStart="Start" OnCancel="EndStart" Busy="busy" Error="@startError" /> }
        @if (status.Releases.Count > 0)
        {
            <h4>Signatures</h4>
            @foreach (var rel in status.Releases)
            {
                <div class="release">
                    <p>Released @WorkflowText.Utc(rel.ReleasedAt) · <a href="workflows/@rel.InstanceId">Workflow details</a></p>
                    <ul class="plain signatures">@foreach (var s in rel.Signatures) { <li>@s.Manifestation@(string.IsNullOrEmpty(s.Comment) ? "" : $": {s.Comment}")</li> }</ul>
                </div>
            }
        }
    }
    @if (Detail.Displayed.IsLatest && Detail.Displayed.State == "Released" && Detail.CanModify)
    {
        <div class="toolbar">
            <input aria-label="Reason for the next revision" placeholder="Reason for the next revision (required)" class="grow" @bind="reviseReason" />
            <button type="button" disabled="@busy" @onclick="Revise">Revise</button>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public required SpecDetail Detail { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private ObjectWorkflowStatus? status;
    private TemplateView? template;
    private bool starting, busy;
    private string? error, startError;
    private string cancelReason = "", reviseReason = "";

    protected override async Task OnParametersSetAsync()
    {
        var outcome = await Flow.StatusForObjectAsync(await Users.GetAsync(), RequirementService.ObjectType, Detail.Summary.Number, CurrentUser.NewCorrelationId());
        status = outcome.IsOk ? outcome.Value : null;
    }

    private async Task BeginStart()
    {
        error = startError = null;
        var templates = await Flow.ListTemplatesAsync(await Users.GetAsync(), activeOnly: true, CurrentUser.NewCorrelationId());
        template = templates.FirstOrDefault(t => t.ObjectType == RequirementService.ObjectType);
        if (template is null) { error = "No workflow template is available for requirement specifications. Ask an administrator to upload one."; return; }
        starting = true;
    }

    private Task EndStart() { starting = false; return Task.CompletedTask; }

    private async Task<IReadOnlyList<DirectoryUserView>> SearchUsers(SlotView slot, string text)
    {
        var outcome = await Flow.SearchUsersAsync(await Users.GetAsync(), text, slot.Role, RequirementService.ObjectType, Detail.Summary.Number, 25, CurrentUser.NewCorrelationId());
        return outcome.IsOk ? outcome.Value! : [];
    }

    private async Task Start(StartSelection selection)
    {
        busy = true;
        startError = null;
        var outcome = await Flow.StartAsync(await Users.GetAsync(), new StartReviewCommand(RequirementService.ObjectType, Detail.Summary.Number, selection.Participants, selection.TemplateId, selection.Comment), CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk) { startError = WorkflowText.Message(outcome); return; }
        starting = false;
        await OnChanged.InvokeAsync();
    }

    private async Task Cancel()
    {
        busy = true;
        error = null;
        var outcome = await Flow.CancelAsync(await Users.GetAsync(), status!.Active!.Id, cancelReason, CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk) { error = WorkflowText.Message(outcome); return; }
        cancelReason = "";
        await OnChanged.InvokeAsync();
    }

    private async Task Revise()
    {
        busy = true;
        error = null;
        var outcome = await Requirements.ReviseAsync(await Users.GetAsync(), Detail.Summary.Number, reviseReason, CurrentUser.NewCorrelationId());
        busy = false;
        if (!outcome.IsOk) { error = outcome.Kind is OutcomeKind.Invalid or OutcomeKind.Conflict ? string.Join(" ", outcome.Errors) : UiText.Message(outcome); return; }
        reviseReason = "";
        Toasts.Success($"Revision {outcome.Value!.Displayed.Revision} started.");
        await OnChanged.InvokeAsync();
    }
}
