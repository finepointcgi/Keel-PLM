@page "/sourcing/where-sourced"
@inject CurrentUser Users
@inject SourcingService Sourcing

<PageFrame Banner="@(result?.Banner ?? UiText.Unclassified)" Title="Where sourced" Crumbs="@Crumbs">
    <p class="muted">Find the parts you can read that are sourced from a supplier, or through a manufacturer part number.</p>
    <form class="toolbar" role="search" @onsubmit="Search">
        <input aria-label="Supplier number" placeholder="Supplier number, for example SUP-000001" class="grow" @bind="supplier" />
        <input aria-label="Manufacturer part number" placeholder="Manufacturer part number (or the start of it)" class="grow" @bind="mpn" />
        <button type="submit">Search</button>
    </form>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (result is not null)
    {
        <p class="muted" role="status">@result.Total list entr@(result.Total == 1 ? "y" : "ies") on parts you can read</p>
        @if (result.Rows.Count == 0)
        {
            <EmptyState Title="Nothing found" IconName="search">No part you can read matches. A supplier or part you may not read is not reported.</EmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <caption class="visually-hidden">Parts found</caption>
                    <thead><tr><th scope="col">Part</th><th scope="col">Name</th><th scope="col">List</th><th scope="col">Supplier</th><th scope="col">Manufacturer part</th><th scope="col">Status</th><th scope="col">Entry</th><th scope="col">Markings</th></tr></thead>
                    <tbody>
                        @foreach (var r in result.Rows)
                        {
                            <tr>
                                <th scope="row"><a href="@SourcingUi.PartHref(r.PartNumber)">@r.PartNumber</a></th>
                                <td>@r.PartName</td>
                                <td>@SourceKinds.Label(r.Kind)</td>
                                <td><a href="@SourcingUi.SupplierHref(r.SupplierNumber)">@r.SupplierName</a></td>
                                <td>@(r.Mpn ?? "")</td>
                                <td>@EntryStatuses.Label(r.Status)</td>
                                <td><a href="@SourcingUi.EntryHref(r.EntryNumber)">@r.EntryNumber</a> <span class="badge @SourcingUi.EntryClass(r.ApprovalState)">@EntryApprovalStates.Label(r.ApprovalState)</span></td>
                                <td><MarkingChip Text="@r.Banner" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</PageFrame>

@code {
    [SupplyParameterFromQuery(Name = "supplier")] public string? SupplierParam { get; set; }
    [SupplyParameterFromQuery(Name = "mpn")] public string? MpnParam { get; set; }
    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Suppliers", "suppliers"), new("Where sourced")];
    private string supplier = "", mpn = "";
    private string? error;
    private WhereSourcedResult? result;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SupplierParam) && string.IsNullOrWhiteSpace(MpnParam)) return;
        (supplier, mpn) = (SupplierParam ?? "", MpnParam ?? "");
        await Search();
    }

    private async Task Search()
    {
        error = null;
        var outcome = await Sourcing.WhereSourcedAsync(await Users.GetAsync(), new WhereSourcedQuery(supplier, mpn, null, 200), CurrentUser.NewCorrelationId());
        if (!outcome.IsOk) { error = UiText.Message(outcome); result = null; return; }
        result = outcome.Value;
    }
}
