@page "/notifications/preferences"
@inject CurrentUser Users
@inject INotificationCenter Center
@inject IEmailPreferences EmailPrefs
@inject IEmailVerification EmailVerify
@inject ToastService Toasts

<PageFrame Banner="@UiText.Unclassified" Title="Notification preferences" Crumbs="@Crumbs">
    <p class="muted">Choose which notifications you get in the application. Notifications that need your action (tasks, reviews, change tasks and mentions) cannot be turned off, so you do not miss work that waits for you.
        A notification never carries the name or text of an object: it is read again from the object, with your current access, whenever you look at it.</p>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (prefs is null && error is null)
    {
        <Skeleton Lines="6" Label="Loading your preferences" />
    }
    else if (prefs is not null)
    {
        <section class="panel" aria-labelledby="auto-watch-heading">
            <h2 id="auto-watch-heading">Watching</h2>
            <label class="inline-check"><input type="checkbox" checked="@prefs.AutoWatch" data-pref="auto-watch" @onchange="SetAutoWatchAsync" /> Watch the objects I create, check out, sign or comment on</label>
            <p class="muted small">You can stop watching any object at any time from its page or from <a href="watching">Things I watch</a>.</p>
        </section>
        @if (email is { ChannelAvailable: true })
        {
            <section class="panel" aria-labelledby="email-heading">
                <h2 id="email-heading">E-mail</h2>
                <p class="muted">Get one short e-mail that says <em>you have a notification</em>, with a link that asks you to sign in. The e-mail never names an object or repeats what a notification says,
                    and you get at most one every @email.MinIntervalMinutes minutes.
                    Addresses at @string.Join(", ", email.AllowedDomains) are accepted.</p>
                @if (emailError is not null) { <p class="error" role="alert">@emailError</p> }
                <label class="inline-check"><input type="checkbox" checked="@emailEnabled" data-pref="email-enabled" @onchange="e => emailEnabled = e.Value is true" /> Send me e-mail when I have a notification</label>
                <div class="field">
                    <label for="email-address">My e-mail address</label>
                    <input id="email-address" type="email" autocomplete="email" maxlength="254" value="@emailAddress" data-pref="email-address" @onchange="e => emailAddress = e.Value?.ToString()" />
                </div>
                <button type="button" class="btn" data-pref="email-save" @onclick="SaveEmailAsync">Save e-mail settings</button>
                @if (!string.IsNullOrEmpty(email.Address))
                {
                    <div class="stack" data-pref="email-verification">
                        @if (email.AddressVerified) { <p class="permit" role="status" data-pref="email-verified">Your address is confirmed.</p> }
                        else if (email.AddressSuppressed) { <p class="error" role="alert" data-pref="email-suppressed">Mail to your confirmed address bounced, so Keel PLM stopped sending to it. Ask an administrator to lift this, or save another address.</p> }
                        else if (email.VerificationPending) { <p role="status" data-pref="email-pending">We sent a link to your address. Open it and press Confirm; until then no e-mail notifications are sent.</p> }
                        else { <p role="status" data-pref="email-unverified">Your address is not confirmed yet, so no e-mail notifications are sent to it.</p> }
                        @if (!email.AddressVerified && !email.AddressSuppressed)
                        {
                            <button type="button" class="secondary" data-pref="email-verify" @onclick="SendVerificationAsync">@(email.VerificationPending ? "Send a new link" : "Send me a confirmation link")</button>
                        }
                    </div>
                }
            </section>
        }
        <section class="panel" aria-labelledby="kinds-heading">
            <h2 id="kinds-heading">What I am told about</h2>
            <div class="table-wrap">
                <table class="data pref-table">
                    <caption class="visually-hidden">Notification kinds</caption>
                    <thead><tr><th scope="col">Notification</th><th scope="col">In the application</th><th scope="col">Also my own actions</th>@if (email is { ChannelAvailable: true }) { <th scope="col">By e-mail</th> }</tr></thead>
                    <tbody>
                        @foreach (var k in prefs.Kinds)
                        {
                            var kind = k;
                            <tr>
                                <th scope="row">
                                    @kind.Kind.Label
                                    <span class="muted small">@kind.Kind.Description</span>
                                    @if (!kind.Kind.CanDisable) { <span class="pref-locked">@kind.Kind.LockedReason</span> }
                                </th>
                                <td>
                                    <input type="checkbox" checked="@kind.InApp" disabled="@(!kind.Kind.CanDisable)" data-kind="@kind.Kind.Code" data-pref="in-app"
                                           aria-label="@($"Tell me in the application: {kind.Kind.Label}")" @onchange="e => SetKindAsync(kind, inApp: (bool)e.Value!, kind.NotifyOwn)" />
                                </td>
                                <td>
                                    <input type="checkbox" checked="@kind.NotifyOwn" data-kind="@kind.Kind.Code" data-pref="own"
                                           aria-label="@($"Also tell me when I did it myself: {kind.Kind.Label}")" @onchange="e => SetKindAsync(kind, kind.InApp, notifyOwn: (bool)e.Value!)" />
                                </td>
                                @if (email is { ChannelAvailable: true })
                                {
                                    <td>
                                        <input type="checkbox" checked="@(!email.KindsOff.Contains(kind.Kind.Code))" data-kind="@kind.Kind.Code" data-pref="email"
                                               aria-label="@($"Send me e-mail: {kind.Kind.Label}")" @onchange="e => SetKindEmailAsync(kind, (bool)e.Value!)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (email is not { ChannelAvailable: true })
            {
                <p class="muted small">E-mail is not set up on this system: notifications are in the application only.</p>
            }
        </section>
    }
</PageFrame>

@code {
    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Notifications", "notifications"), new("Preferences")];

    private NotificationPreferences? prefs;
    private EmailSettings? email;
    private bool emailEnabled;
    private string? emailAddress;
    private string? emailError;
    private string? error;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            var user = await Users.GetAsync();
            prefs = await Center.GetPreferencesAsync(user);
            email = await EmailPrefs.GetAsync(user);
            emailEnabled = email.Enabled;
            emailAddress = email.Address;
        }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException) { error = "Your preferences could not be loaded right now."; }
    }

    private async Task SetKindAsync(KindPreference kind, bool inApp, bool notifyOwn)
    {
        try
        {
            if (await Center.SetKindPreferenceAsync(await Users.GetAsync(), kind.Kind.Code, inApp, notifyOwn)) Toasts.Success("Preference saved.");
            else Toasts.Warning(kind.Kind.LockedReason ?? "That preference cannot be changed.");
            await ReloadAsync();
        }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException) { Toasts.Error("Your preference could not be saved right now."); }
    }

    private async Task SaveEmailAsync()
    {
        emailError = null;
        try
        {
            var result = await EmailPrefs.SetAsync(await Users.GetAsync(), emailEnabled, emailAddress);
            switch (result)
            {
                case EmailSaveResult.Saved:
                    Toasts.Success(emailEnabled ? "E-mail notifications are on." : "E-mail notifications are off.");
                    await ReloadAsync();
                    // A new or changed address is confirmed before it gets mail: the link goes out now (the same limits as a request on the button).
                    if (!string.IsNullOrWhiteSpace(emailAddress) && email is { AddressVerified: false, VerificationPending: false, AddressSuppressed: false }) await SendVerificationAsync();
                    break;
                case EmailSaveResult.AddressRequired: emailError = "Enter your e-mail address to turn e-mail on."; break;
                case EmailSaveResult.InvalidAddress: emailError = "That is not a valid e-mail address."; break;
                case EmailSaveResult.DomainNotAllowed: emailError = "Mail can only go to addresses at " + string.Join(", ", email?.AllowedDomains ?? []) + "."; break;
                default: emailError = "E-mail is not set up on this system."; break;
            }
        }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException) { Toasts.Error("Your e-mail settings could not be saved right now."); }
    }

    private async Task SendVerificationAsync()
    {
        emailError = null;
        try
        {
            var result = await EmailVerify.RequestAsync(await Users.GetAsync());
            switch (result)
            {
                case VerificationRequestResult.Sent: Toasts.Success("If the address can receive mail, a confirmation link is on its way."); break;
                case VerificationRequestResult.AlreadyVerified: Toasts.Success("Your address is already confirmed."); break;
                case VerificationRequestResult.RateLimited: emailError = "A link was sent recently or you asked too often. Wait a few minutes and try again."; break;
                case VerificationRequestResult.SendFailed: emailError = "The confirmation link could not be sent right now. Try again later or ask an administrator."; break;
                case VerificationRequestResult.AddressRequired: emailError = "Save an e-mail address first."; break;
                default: emailError = "E-mail is not set up on this system."; break;
            }
            await ReloadAsync();
        }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException) { Toasts.Error("The confirmation link could not be requested right now."); }
    }

    private async Task SetKindEmailAsync(KindPreference kind, bool send)
    {
        try
        {
            await EmailPrefs.SetKindAsync(await Users.GetAsync(), kind.Kind.Code, send);
            Toasts.Success("Preference saved.");
            await ReloadAsync();
        }
        catch (Exception e) when (e is InvalidOperationException or Npgsql.NpgsqlException) { Toasts.Error("Your preference could not be saved right now."); }
    }

    private async Task SetAutoWatchAsync(ChangeEventArgs e)
    {
        try
        {
            await Center.SetAutoWatchAsync(await Users.GetAsync(), e.Value is true);
            Toasts.Success("Preference saved.");
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Npgsql.NpgsqlException) { Toasts.Error("Your preference could not be saved right now."); }
    }
}
