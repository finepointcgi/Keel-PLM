@page "/changes"
@inject CurrentUser Users
@inject ChangeService Changes

<PageFrame Banner="@Banner" Title="Changes" Crumbs="@Crumbs">
    <form class="toolbar" role="search" @onsubmit="() => Search(0)">
        <input aria-label="Search changes" placeholder="Number or title" class="grow" @bind="text" />
        <select aria-label="Type" @bind="type" @bind:after="() => Search(0)">
            <option value="">All types</option>
            <option value="PR">Problem reports</option>
            <option value="ECR">Change requests</option>
            <option value="ECN">Change notices</option>
        </select>
        <select aria-label="State" @bind="state" @bind:after="() => Search(0)">
            <option value="">Any state</option>
            @foreach (var s in States) { <option value="@s.Key">@s.Value</option> }
        </select>
        <label class="inline"><input type="checkbox" @bind="openOnly" @bind:after="() => Search(0)" /> Open only</label>
        <button type="submit">Search</button>
        <AuthorizeView Roles="@($"{Roles.Author},{Roles.Admin}")">
            <a class="button secondary" href="@ChangeUi.NewHref("PR")">New problem report</a>
            <a class="button secondary" href="@ChangeUi.NewHref("ECR")">New change request</a>
            <a class="button secondary" href="@ChangeUi.NewHref("ECN")">New change notice</a>
        </AuthorizeView>
    </form>

    @if (mine is { Items.Count: > 0 })
    {
        <section class="panel" aria-labelledby="my-tasks-heading">
            <h2 id="my-tasks-heading">My change tasks</h2>
            <div class="table-wrap"><table class="data">
                <thead><tr><th scope="col">Task</th><th scope="col">Title</th><th scope="col">Change notice</th><th scope="col">State</th><th scope="col">Due</th></tr></thead>
                <tbody>
                    @foreach (var t in mine.Items)
                    {
                        <tr>
                            <td>@t.Number</td>
                            <td>@t.Title</td>
                            <td><a href="@ChangeUi.Href(t.EcnNumber)">@t.EcnNumber</a> <span class="muted">@t.EcnTitle</span></td>
                            <td>@t.StateLabel</td>
                            <td class="@(t.Overdue ? "error" : null)">@ChangeUi.DueText(t.DueDate, t.Overdue)</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>
    }

    @if (result is not null)
    {
        <p class="muted">@result.Total change@(result.Total == 1 ? "" : "s") you can access</p>
        <DataTable TItem="ChangeSummary" TableId="changes" Items="result.Items" Columns="Columns" Caption="Changes" OnServerSort="OnSort" ServerSort="sort">
            <Empty>
                <EmptyState Title="@(Filtered ? "No changes match" : "No changes yet")" IconName="change">
                    @(Filtered ? "Try a different search or clear the filters." : "Start a problem report or a change request when something about a released part or document needs to change.")
                </EmptyState>
            </Empty>
        </DataTable>
        <Pager Total="result.Total" Offset="offset" PageSize="PageSize" OnPage="Search" />
    }
</PageFrame>

@code {
    private const int PageSize = 50;
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    private SortSpec? sort;
    private bool sortLoaded;

    // The order lives in the address bar (GAP-A-1). A stale or hand-edited value that is not one of the module's sort keys falls back to the default order.
    protected override async Task OnParametersSetAsync()
    {
        _ = ChangeService.SortKeys.TryResolve(SortParam, DirParam, out var requested, out _);
        if (sortLoaded && requested == sort) return;
        (sort, sortLoaded) = (requested, true);
        await Search(0);
    }

    private async Task OnSort((string Key, bool Descending) s)
    {
        sort = new SortSpec(s.Key, s.Descending);
        await Search(0);
    }

    private string text = "", type = "", state = "";
    private bool openOnly;
    private int offset;
    private ChangeSearchResult? result;
    private MyChangeTasks? mine;

    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Changes")];
    private bool Filtered => text.Length > 0 || type != "" || state != "" || openOnly;

    private static readonly IReadOnlyList<DataColumn<ChangeSummary>> Columns =
    [
        new() { Key = "number", Title = "Number", Required = true, ServerSortKey = "number", Cell = c => @<a href="@ChangeUi.Href(c.Number)">@c.Number</a> },
        new() { Key = "type", Title = "Type", ServerSortKey = "type", Text = c => c.Type },
        new() { Key = "title", Title = "Title", ServerSortKey = "title", Text = c => c.Title },
        new() { Key = "class", Title = "Class", ServerSortKey = "class", Text = c => c.ChangeClass ?? "" },
        new() { Key = "priority", Title = "Priority", ServerSortKey = "priority", Text = c => c.Priority },
        new() { Key = "state", Title = "State", ServerSortKey = "state", Cell = c => @<span class="badge @ChangeUi.StateClass(c.State)">@c.StateLabel</span> },
        new() { Key = "requester", Title = "Requester", ServerSortKey = "requester", Text = c => c.RequesterName, DefaultHidden = false },
        new() { Key = "markings", Title = "Markings", Required = true, Cell = c => @<MarkingChip Text="@c.Banner" /> },
    ];

    // Union of the states of all three lifecycles, for the filter; the data-defined lifecycles stay the source of truth.
    private static readonly IReadOnlyDictionary<string, string> States = new Dictionary<string, string>
    {
        ["Open"] = "Open", ["Evaluating"] = "Evaluating", ["Draft"] = "Draft", ["UnderReview"] = "Under review", ["Approved"] = "Approved",
        ["Released"] = "Released", ["Resolved"] = "Resolved", ["Rejected"] = "Rejected", ["Implemented"] = "Implemented", ["Closed"] = "Closed", ["Cancelled"] = "Cancelled",
    };

    private string Banner => Markings.AggregateBanner((result?.Items.Select(i => i.Markings) ?? []).Concat(mine?.Items.Select(t => t.Markings) ?? []));

    protected override async Task OnInitializedAsync()
    {
        mine = await Changes.MyTasksAsync(await Users.GetAsync(), CurrentUser.NewCorrelationId());
    }

    private async Task Search(int newOffset)
    {
        offset = newOffset;
        result = await Changes.SearchAsync(await Users.GetAsync(),
            new ChangeSearchQuery(type == "" ? null : type, state == "" ? null : state, text, openOnly, PageSize, offset, sort), CurrentUser.NewCorrelationId());
    }
}
