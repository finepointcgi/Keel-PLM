@inject CurrentUser Users
@inject WorkflowService Flow
@inject ChangeService Changes
@using Keel.Web.Components.Pages.Workflow

@* Review status, "Submit for review" and release history for one ECR (CCB) or ECN (release review). Reuses the workflow start dialog. *@
@if (ObjectType is not null && status is not null)
{
    <section class="panel" aria-labelledby="review-heading">
        <h3 id="review-heading">@(Detail.Type == ChangeTypes.Ecr ? "CCB review" : "Review and release")</h3>
        @* UX-3: the progress map of the running (or last) review: steps, vote rule, who signed, who is pending. *@
        @{ var mapInstance = status.Active ?? status.Last; }
        @if (mapInstance is not null) { <WorkflowMapPanel InstanceId="@mapInstance.Id" Version="@($"{mapInstance.Status}:{mapInstance.Tasks.Count(t => t.Status != "Open")}")" /> }

        @if (status.Active is { } active)
        {
            <p>
                <span class="badge state-underreview">Under review</span>
                Started by @active.StartedBy on @WorkflowText.Utc(active.StartedAt) · <a href="workflows/@active.Id">Workflow details</a>
            </p>
            <ul class="plain">
                @foreach (var t in active.Tasks.Where(t => t.Status == "Open"))
                {
                    <li>@t.Name: waiting for @(t.AssigneeName ?? WorkflowText.Role(t.RequiredRole))@(t.Overdue ? " (overdue)" : "")</li>
                }
            </ul>
        }
        else
        {
            @if (status.Last is { } last)
            {
                <p>
                    <span class="badge @(last.Status == InstanceStatus.Approved ? "state-released" : null)">Last review: @WorkflowText.Status(last.Status)</span>
                    @(last.CompletedAt is { } done ? WorkflowText.Utc(done) : "") · <a href="workflows/@last.Id">Workflow details</a>
                </p>
                @if (last.Status == InstanceStatus.Rejected)
                {
                    <ul class="plain" aria-label="Rejection reasons">
                        @foreach (var r in last.Rejections) { <li>Rejected by @r.By (@r.Username): @r.Comment</li> }
                    </ul>
                }
                else if (last.Status == InstanceStatus.Cancelled) { <p class="muted">@last.CompletionNote</p> }
            }
            else { <p class="muted">This @ChangeUi.TypeName(Detail.Type).ToLowerInvariant() has not been submitted for review.</p> }

        }

        @if (status.Releases.Count > 0)
        {
            <h4>@(Detail.Type == ChangeTypes.Ecr ? "Approval history" : "Release history")</h4>
            @foreach (var rel in status.Releases)
            {
                <div class="release">
                    <p><strong>Submission @rel.Revision</strong> approved @WorkflowText.Utc(rel.ReleasedAt) · <a href="workflows/@rel.InstanceId">Workflow details</a></p>
                    <ul class="plain signatures">
                        @foreach (var s in rel.Signatures) { <li>@s.Manifestation@(string.IsNullOrEmpty(s.Comment) ? "" : $": {s.Comment}")</li> }
                    </ul>
                </div>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public required ChangeDetail Detail { get; set; }
    /// <summary>Raised after the review started or was cancelled, so the page reloads the change.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private ObjectWorkflowStatus? status;

    private string? ObjectType => ChangeUi.ReviewObjectType(Detail.Type);

    private bool CanStart => Detail.State == "Draft" && Detail.Permissions.CanModify && (Detail.Type != ChangeTypes.Ecr || Detail.ChangeClass is not null);

    protected override async Task OnParametersSetAsync()
    {
        if (ObjectType is null) return;
        var outcome = await Flow.StatusForObjectAsync(await Users.GetAsync(), ObjectType, Detail.Number, CurrentUser.NewCorrelationId());
        status = outcome.IsOk ? outcome.Value : null;
    }

}
