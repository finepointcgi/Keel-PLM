@using Keel.Process
@* The routing flow of a process plan as a picture (UX-3, ADR-0029, ADR-0042) with its legend, a detail panel and the same facts as a table. Presentational: the graph was built from
   the plan view the reader may see. Keyboard: focus the diagram, arrow keys follow the sequence, Space selects, Home and End jump. Below 600 px choose the table. *@
@inject VisualsJs Js

<div class="sf-noprint">
    <ViewSwitch Label="Routing flow view" Options="views" Value="@(table ? "table" : "graph")" ValueChanged='v => table = v == "table"' />
</div>
@if (Graph.Nodes.Count == 0)
{
    <p class="muted">The routing has no operations yet.</p>
}
else if (table)
{
    <div class="table-wrap">
        <table class="data" aria-label="Routing flow as a table">
            <caption class="sr-only">The operations of every routing in sequence</caption>
            <thead><tr><th scope="col">Routing</th><th scope="col">Operation</th><th scope="col">Description</th><th scope="col">Work center</th><th scope="col">Setup (min)</th><th scope="col">Run per unit (min)</th><th scope="col">Inspection</th><th scope="col">Next</th></tr></thead>
            <tbody>
                @foreach (var r in Routings.OrderByDescending(r => r.IsPrimary).ThenBy(r => r.Code, StringComparer.Ordinal))
                {
                    var ops = r.Operations.OrderBy(o => o.Number).ToList();
                    @for (var i = 0; i < ops.Count; i++)
                    {
                        var o = ops[i];
                        <tr>
                            <td>@r.Code@(r.IsPrimary ? " (primary)" : "")</td>
                            <th scope="row">@o.Number</th>
                            <td>@o.Name</td>
                            <td>@(o.WorkCenter ?? "")</td>
                            <td>@(o.SetupMinutes is { } s ? ProcessRules.Fmt(s) : "")</td>
                            <td>@(o.RunMinutes is { } u ? ProcessRules.Fmt(u) : "")</td>
                            <td>@(o.Inspection ? "Inspection point" : "")</td>
                            <td>@(i + 1 < ops.Count ? ops[i + 1].Number.ToString() : "End")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="vis-split">
        <div class="vis-main">
            <DiagramViewport Width="@geometry.Width" Height="@geometry.Height" Label="Routing flow" FirstId="@(order.Count > 0 ? order[0] : null)" LastId="@(order.Count > 0 ? order[^1] : null)" ContentKey="@contentKey">
                @{
                    var ctx = context;
                    <g class="vis-edges" aria-hidden="true">
                        @foreach (var e in geometry.Edges)
                        {
                            <g class="vis-edge" @key="@($"{e.From}>{e.To}")"><path d="@e.Path" fill="none" marker-end="@ctx.Arrow" /></g>
                        }
                    </g>
                    <g class="vis-nodes">
                        @foreach (var p in geometry.Nodes)
                        {
                            var n = nodes[p.Id];
                            var nav = navigation[p.Id];
                            <g id="@ctx.NodeId(p.Id)" class="vis-node vis-k-@n.Kind.ToString().ToLowerInvariant() @(selected == p.Id ? "is-selected" : null)" role="button" tabindex="@(p.Id == order[0] ? 0 : -1)" @key="p.Id"
                               aria-label="@n.Description" data-tip="@n.Label · @n.Sublabel"
                               data-x="@Num(p.X)" data-y="@Num(p.Y)" data-w="@Num(p.Width)" data-h="@Num(p.Height)"
                               data-right="@Ids(ctx, nav.Right)" data-left="@Ids(ctx, nav.Left)" data-up="@(nav.Up is null ? null : ctx.NodeId(nav.Up))" data-down="@(nav.Down is null ? null : ctx.NodeId(nav.Down))"
                               @onclick="() => selected = n.Id">
                                <path class="vis-shape" d="@GraphGeometry.Outline(n.Kind, p.X, p.Y, p.Width, p.Height)" />
                                @if (n.Highlight) { <path d="@GraphGeometry.Outline(n.Kind, p.X, p.Y, p.Width, p.Height)" fill="@ctx.Pattern("dots")" stroke="none" class="vis-dots" /> }
                                <text class="vis-label" x="@Num(p.X + 10)" y="@Num(p.Y + 21)">@n.Label</text>
                                <g><text class="vis-sub" x="@Num(p.X + 10)" y="@Num(p.Y + 40)">@GraphGeometry.Shorten(n.Sublabel, 27)</text></g>
                            </g>
                        }
                    </g>
                }
            </DiagramViewport>
        </div>
        <div class="vis-side" role="group" aria-label="Operation details">
            @if (selected is not null && nodes.TryGetValue(selected, out var s))
            {
                <h4>@s.Label: @s.Sublabel</h4>
                <dl class="facts compact">@foreach (var f in s.Facts!.Where(f => f.Value.Length > 0)) { <dt>@f.Key</dt><dd>@f.Value</dd> }</dl>
            }
            else { <p class="muted">Select an operation, or move to it with the arrow keys and press Space, to see its details here.</p> }
        </div>
    </div>
    <Legend Label="Legend" Items="RoutingFlowGraphBuilder.Legend" />
}

@code {
    private GraphLayout geometry = new([], [], 48, 48, 0);
    private Dictionary<string, GraphNode> nodes = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, NodeNavigation> navigation = new Dictionary<string, NodeNavigation>();
    private IReadOnlyList<string> order = [];
    private string? selected;
    private bool table;
    private string contentKey = "";
    private ImpactGraph? built;

    private static readonly IReadOnlyList<ViewOption> views = [new("graph", "Diagram"), new("table", "Table")];

    [Parameter, EditorRequired] public required ImpactGraph Graph { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<RoutingView> Routings { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(built, Graph)) return;
        built = Graph;
        nodes = Graph.Nodes.ToDictionary(n => n.Id, StringComparer.Ordinal);
        var inputs = Graph.Nodes.Select(n => { var (w, h) = GraphGeometry.Size(n.Kind); return new LayoutNodeInput(n.Id, n.Layer, w, h); }).ToList();
        geometry = LayeredLayout.Compute(inputs, [.. Graph.Edges.Select(e => new LayoutEdgeInput(e.From, e.To))]);
        navigation = GraphGeometry.Navigation(geometry);
        order = GraphGeometry.FocusOrder(geometry);
        if (selected is not null && !nodes.ContainsKey(selected)) selected = null;
        contentKey = string.Join('|', Graph.Nodes.Select(n => n.Id).Take(40)) + Graph.Nodes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string Num(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Ids(DiagramContext ctx, IReadOnlyList<string> ids) => string.Join(' ', ids.Select(ctx.NodeId));
}
