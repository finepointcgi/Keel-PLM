@* The "Timeline" tab of a part, document or manufacturing BOM (UX-3, ADR-0029): loads the merged timeline through TimelineService (each module applies the caller's access) and
   shows it with TimelineView. Entries about objects you may not read are neutral placeholders. *@
@inject CurrentUser Users
@inject TimelineService Timelines

<section class="panel stack" aria-labelledby="timeline-heading">
    <h3 id="timeline-heading">Timeline</h3>
    <p class="muted small">Check-ins, revisions, lifecycle changes, signatures and the changes, baselines, manufacturing BOMs and document links that touched @Key, oldest first.</p>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    else if (result is null) { <Skeleton Lines="4" Label="Loading the timeline" /> }
    else { <TimelineView Events="result.Events" /> }
</section>

@code {
    private TimelineResult? result;
    private string? error, loadedFor;

    [Parameter, EditorRequired] public required string ObjectType { get; set; }
    [Parameter, EditorRequired] public required string Key { get; set; }
    /// <summary>Raised with the markings of the other objects the entries name, so the page banner covers them.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Markings>> OnShown { get; set; }
    /// <summary>Changes when the object changed (a check-in, a release), so the timeline is read again.</summary>
    [Parameter] public string? Version { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ObjectType}:{Key}:{Version}";
        if (key == loadedFor) return;
        loadedFor = key;
        var outcome = await Timelines.GetAsync(await Users.GetAsync(), ObjectType, Key, CurrentUser.NewCorrelationId());
        if (outcome.IsOk) { result = outcome.Value; error = null; await OnShown.InvokeAsync(result!.Shown); }
        else { result = null; error = UiText.Message(outcome); await OnShown.InvokeAsync([]); }
    }
}
