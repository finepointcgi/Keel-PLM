@* The compliance of an assembly as a treemap (ADR-0029, ADR-0040): one regulation at a time, area is extended quantity or the number of parts below, fill and pattern are the
   standing (compliant, with an exemption, non-compliant, no declaration, expired, conflict status unknown). Click or Enter drills into a sub-assembly (breadcrumb, Backspace goes
   up), arrow keys move between tiles, a purchased part opens on its Compliance tab. The table below is the same data for every child of the assembly in view. The picture is
   built from the report, which holds only what the viewer may read, so a part the viewer cannot read is not in it. *@
@using Keel.Compliance
@inject VisualsJs Js

<div class="stack tm">
    <h3 class="visually-hidden">Compliance treemap</h3>
    <div class="toolbar vis-filters">
        <ViewSwitch Label="Compliance picture" Options="views" Value="@(table ? "table" : "map")" ValueChanged="OnView" />
        <label class="inline">Regulation
            <select aria-label="Regulation shown in the picture" @bind="regulation" @bind:after="Rebuild">
                @foreach (var r in Report.Regulations) { <option value="@r.Code">@r.Name (version @r.Version)</option> }
            </select>
        </label>
        <label class="inline">Area shows
            <select aria-label="Area shows" @bind="countMetric" @bind:after="Relayout">
                <option value="@false">Extended quantity</option>
                <option value="@true">Number of parts below</option>
            </select>
        </label>
    </div>

    <nav class="tm-crumbs" aria-label="Treemap path">
        <ol class="plain">
            @foreach (var (node, last) in Trail())
            {
                <li>
                    @if (last) { <span aria-current="location">@Crumb(node)</span> }
                    else { <button type="button" class="link" @onclick="() => Drill(node.Path)">@Crumb(node)</button> }
                </li>
            }
        </ol>
    </nav>

    @if (focus.Children.Count == 0)
    {
        <p class="muted">@(focus.Path.Length == 0 ? "No components." : "This item has no components.")</p>
    }
    else if (table)
    {
        <div class="table-wrap"><table class="data tm-table" aria-label="Compliance of the components as a table">
            <caption class="sr-only">Components of @Crumb(focus) with their standing</caption>
            <thead><tr><th scope="col">Part</th><th scope="col">Name</th><th scope="col">Standing</th><th scope="col">Qty</th><th scope="col">Parts below</th><th scope="col">Share</th></tr></thead>
            <tbody>
                @foreach (var c in focus.Children.OrderBy(c => ComplianceTreemapModel.Rank(c.Standing)).ThenByDescending(c => c.Value(countMetric)).ThenBy(c => c.Path, StringComparer.Ordinal).Take(rowLimit))
                {
                    <tr>
                        <td>
                            @if (c.Children.Count > 0) { <button type="button" class="link" @onclick="() => Drill(c.Path)">@c.Label</button> }
                            else { <a href="parts/@Uri.EscapeDataString(c.Label)?tab=compliance">@c.Label</a> }
                        </td>
                        <td>@c.Sublabel</td>
                        <td><span class="badge @ComplianceTreemapModel.Badge(c.Standing)">@(c.Children.Count > 0 ? Worst(c.Standing) : Standings.Label(c.Standing))</span></td>
                        <td>@Qty(c.Quantity) @c.Unit</td>
                        <td>@(c.Children.Count > 0 ? c.Descendants.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")</td>
                        <td>@Share(c)</td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (focus.Children.Count > rowLimit)
        {
            <p class="muted small">Showing the first @rowLimit of this assembly's components. <button type="button" class="link" @onclick="() => rowLimit = int.MaxValue">Show all</button></p>
        }
    }
    else
    {
        <div class="vis-split" @onkeydown="OnKey">
            <div class="vis-main">
                <DiagramViewport @ref="frame" Width="@Width" Height="@Height" Label="@($"Compliance treemap of {Crumb(focus)}")" FirstId="@FirstId" LastId="@LastId" ContentKey="@(focus.Path + "|" + regulation)">
                    @{
                        var ctx = context;
                        for (var i = 0; i < tiles.Count; i++)
                        {
                            var t = tiles[i];
                            var (cls, pattern) = ComplianceTreemapModel.Style(t.Node.Standing);
                            var dom = ctx.NodeId("t" + i.ToString(System.Globalization.CultureInfo.InvariantCulture));
                            var next = i + 1 < tiles.Count ? ctx.NodeId("t" + (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture)) : null;
                            var prev = i > 0 ? ctx.NodeId("t" + (i - 1).ToString(System.Globalization.CultureInfo.InvariantCulture)) : null;
                            <g id="@dom" class="vis-node vis-tile vis-k-@cls vis-d1 @(selected == t.Id ? "is-selected" : null)" @key="t.Id"
                               role="@(t.Drillable ? "button" : "link")" tabindex="@(i == 0 ? 0 : -1)" aria-label="@Describe(t)" data-tip="@Tip(t)" data-href="@Href(t)"
                               data-x="@Num(t.X)" data-y="@Num(t.Y)" data-w="@Num(t.Width)" data-h="@Num(t.Height)" data-right="@next" data-left="@prev"
                               @onclick="() => Activate(t)">
                                <rect class="vis-shape" x="@Num(t.X)" y="@Num(t.Y)" width="@Num(Math.Max(t.Width - 1, 0))" height="@Num(Math.Max(t.Height - 1, 0))" />
                                @if (pattern is not null) { <rect class="vis-overlay" x="@Num(t.X)" y="@Num(t.Y)" width="@Num(Math.Max(t.Width - 1, 0))" height="@Num(Math.Max(t.Height - 1, 0))" fill="@ctx.Pattern(pattern)" /> }
                                @if (t.Width >= 56 && t.Height >= 22)
                                {
                                    <g><text class="vis-label" x="@Num(t.X + 6)" y="@Num(t.Y + 15)">@Fit(t.Node.Label, t.Width)</text></g>
                                }
                                @if (t.Width >= 90 && t.Height >= 40 && t.Node.Sublabel is { Length: > 0 } sub)
                                {
                                    <g><text class="vis-sub" x="@Num(t.X + 6)" y="@Num(t.Y + 30)">@Fit(sub, t.Width)</text></g>
                                }
                            </g>
                        }
                    }
                </DiagramViewport>
                <p class="muted small" aria-live="polite">
                    @tiles.Count tile@(tiles.Count == 1 ? "" : "s") drawn@(focus.Children.Count > tiles.Count ? $" of {focus.Children.Count}; the table lists them all" : "").
                    Area: @(countMetric ? "number of parts below" : "extended quantity (units are not converted)"). An assembly is shown with the worst standing below it.
                </p>
            </div>
            <div class="vis-side" role="group" aria-label="Part details">
                @if (SelectedNode() is { } s)
                {
                    <h3>@s.Label</h3>
                    <p>@s.Sublabel</p>
                    <dl class="facts compact">
                        <dt>Standing</dt><dd>@(s.Children.Count > 0 ? Worst(s.Standing) : Standings.Label(s.Standing))</dd>
                        <dt>Quantity</dt><dd>@Qty(s.Quantity) @s.Unit</dd>
                        @if (s.Children.Count > 0) { <dt>Parts below</dt><dd>@s.Descendants</dd> }
                        <dt>Share</dt><dd>@Share(s)</dd>
                    </dl>
                    <p>
                        @if (s.Children.Count > 0) { <button type="button" class="secondary" @onclick="() => Drill(s.Path)">Drill into</button> }
                        else { <a href="parts/@Uri.EscapeDataString(s.Label)?tab=compliance">Open the part's compliance</a> }
                    </p>
                }
                else { <p class="muted">Select a tile to see its details. Enter on an assembly drills into it.</p> }
            </div>
        </div>
        <Legend Label="Legend" Items="Items" />
    }
</div>

@code {
    private const double Width = 960, Height = 540;
    private static readonly IReadOnlyList<ViewOption> views = [new("map", "Treemap"), new("table", "Table")];
    private static readonly IReadOnlyList<LegendItem> Items =
    [
        new("Compliant (plain)", "released", LegendItem.Rect),
        new("Compliant with an exemption (dots)", "released", LegendItem.Rect, "dots"),
        new("Non-compliant (crosshatch)", "unresolved", LegendItem.Rect, "cross"),
        new("No declaration (horizontal lines)", "underreview", LegendItem.Rect, "horiz"),
        new("Declaration expired (vertical lines)", "obsolete", LegendItem.Rect, "vert"),
        new("Conflict status unknown (diagonal lines)", "inwork", LegendItem.Rect, "hatch"),
    ];

    private CmpNode root = new() { Path = "", Label = "" };
    private CmpNode focus = new() { Path = "", Label = "" };
    private IReadOnlyList<CmpTile> tiles = [];
    private string regulation = "";
    private bool countMetric, table, tableChosen, focusFirstAfterRender;
    private int rowLimit = 200;
    private string? selected;
    private ComplianceReport? lastRef;
    private DiagramViewport? frame;

    [Parameter, EditorRequired] public required ComplianceReport Report { get; set; }
    /// <summary>The regulation to show first (its code); the first one of the report when null.</summary>
    [Parameter] public string? Regulation { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(lastRef, Report)) return;
        lastRef = Report;
        regulation = Regulation is not null && Report.Regulations.Any(r => r.Code == Regulation) ? Regulation : Report.Regulations.FirstOrDefault()?.Code ?? "";
        await Rebuild();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Js.IsNarrowAsync() && !tableChosen) { table = true; StateHasChanged(); }
        if (focusFirstAfterRender && frame is not null)
        {
            focusFirstAfterRender = false;
            await frame.FocusFirstAsync();
        }
    }

    private void OnView(string id) { table = id == "table"; tableChosen = true; }

    private Task Rebuild()
    {
        root = ComplianceTreemapModel.Build(Report, regulation);
        focus = root;
        selected = null;
        return Relayout();
    }

    private Task Relayout()
    {
        tiles = ComplianceTreemapModel.Layout(focus, Width, Height, countMetric);
        return Task.CompletedTask;
    }

    private async Task Drill(string path)
    {
        var node = ComplianceTreemapModel.Find(root, path);
        if (node is null || node.Children.Count == 0) return;
        focus = node;
        selected = null;
        focusFirstAfterRender = true;
        await Relayout();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" || (e.AltKey && e.Key == "ArrowUp"))
            if (focus.Parent is { } parent) { focus = parent; selected = null; focusFirstAfterRender = true; await Relayout(); }
    }

    private async Task Activate(CmpTile t)
    {
        selected = t.Id;
        if (t.Drillable) await Drill(t.Node.Path);
    }

    private IEnumerable<(CmpNode Node, bool Last)> Trail()
    {
        var chain = new List<CmpNode>();
        for (CmpNode? n = focus; n is not null; n = n.Parent) chain.Add(n);
        chain.Reverse();
        return chain.Select((n, i) => (n, i == chain.Count - 1));
    }

    private static string Crumb(CmpNode n) => n.Path.Length == 0 ? $"{n.Label}{(string.IsNullOrEmpty(n.Sublabel) ? "" : " " + n.Sublabel)}" : n.Label;

    private CmpNode? SelectedNode() => selected is null ? null : tiles.FirstOrDefault(t => t.Id == selected)?.Node;

    private string FirstId => tiles.Count > 0 ? "t0" : "";
    private string LastId => tiles.Count > 0 ? "t" + (tiles.Count - 1).ToString(System.Globalization.CultureInfo.InvariantCulture) : "";

    private string Share(CmpNode n) => (focus.Value(countMetric) <= 0 ? 0 : n.Value(countMetric) / focus.Value(countMetric)).ToString("P1", System.Globalization.CultureInfo.InvariantCulture);

    private static string Num(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Qty(decimal d) => d.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
    private static string Worst(string standing) => standing == Standings.NotRequired ? "Nothing purchased below" : "Worst below: " + Standings.Label(standing);

    private static string Fit(string text, double width)
    {
        var max = Math.Max((int)((width - 10) / 6.6), 1);
        return text.Length <= max ? text : max <= 1 ? "…" : string.Concat(text.AsSpan(0, max - 1), "…");
    }

    private string Describe(CmpTile t) =>
        $"{t.Node.Label} {t.Node.Sublabel}, {(t.Drillable ? Worst(t.Node.Standing) : Standings.Label(t.Node.Standing))}, quantity {Qty(t.Node.Quantity)} {t.Node.Unit}, {Share(t.Node)} of this view. " +
        (t.Drillable ? "Press Enter to drill into it." : "Press Enter to open the part.");

    private string Tip(CmpTile t) => $"{t.Node.Label} · {t.Node.Sublabel} · {(t.Drillable ? Worst(t.Node.Standing) : Standings.Label(t.Node.Standing))} · {Share(t.Node)}";

    private static string? Href(CmpTile t) => t.Drillable ? null : $"parts/{Uri.EscapeDataString(t.Node.Label)}?tab=compliance";
}
