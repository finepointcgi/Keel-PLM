@* Loads the progress map of one workflow instance and shows it (task page, workflow page and the review panels). Shows nothing when the map is not available to the reader. *@
@inject CurrentUser Users
@inject WorkflowService Flow

@if (map is not null)
{
    <WorkflowMapView Map="map" />
}

@code {
    private WorkflowMap? map;
    private Guid loadedFor;
    private string? loadedStatus;

    [Parameter, EditorRequired] public required Guid InstanceId { get; set; }
    /// <summary>Changes when the instance changed (a signature, a cancellation), so the map is read again.</summary>
    [Parameter] public string? Version { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == InstanceId && loadedStatus == Version) return;
        (loadedFor, loadedStatus) = (InstanceId, Version);
        var outcome = await Flow.GetMapAsync(await Users.GetAsync(), InstanceId, CurrentUser.NewCorrelationId());
        map = outcome.IsOk ? outcome.Value : null;
    }
}
