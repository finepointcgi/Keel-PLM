# Pinned container images for Keel PLM 1.7 (ADR-0012, ADR-0020). Single source of truth for:
#   - the Dockerfile build arguments (scripts/package-offline.sh passes SDK_IMAGE / RUNTIME_IMAGE),
#   - the compose production example (compose.prod-example.yaml reads KEEL_*_IMAGE; these are its defaults),
#   - the offline bundle (scripts/package-offline.sh saves exactly these images; install.sh loads them).
# Format: KEY=repository:tag@sha256:<manifest-list digest>. Digests are of the multi-arch manifest list, so the same pin
# resolves to amd64 on RHEL servers and arm64 on Apple Silicon dev machines. Refresh with scripts/refresh-image-pins.sh,
# review the diff, rebuild, rescan. Never ship a tag without a digest in a release.

# Build and runtime bases: Red Hat UBI 9 .NET 10 images (labels at pin time: version 9.8, .NET 10.0.13, SDK 10.0.113).
SDK_IMAGE=registry.access.redhat.com/ubi9/dotnet-100:latest@sha256:6938571c7256856fca0a82b4b8a5ad0534b3b6994a2449b9f82842a0fab64e79
RUNTIME_IMAGE=registry.access.redhat.com/ubi9/dotnet-100-aspnet:latest@sha256:1c10d6cffa50eeb7247e3739bfe30d7cd52cc6cc88eb9ce05438bf3eacd3ca12

# Third-party images used by the compose example and by the chart's dev values.
KEEL_POSTGRES_IMAGE=postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
KEEL_VAULT_IMAGE=chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882
KEEL_PROXY_IMAGE=caddy:2.10@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb

# The Keel image itself: built locally by scripts/package-offline.sh (or docker build), never pulled from a registry.
KEEL_APP_REPOSITORY=keel/api
