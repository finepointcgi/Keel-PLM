{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keel PLM chart values",
  "type": "object",
  "required": ["image", "replicaCount", "config", "secrets", "ingress", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 20 },
    "config": {
      "type": "object",
      "required": ["auth", "security", "vault", "proxy"],
      "properties": {
        "auth": {
          "type": "object",
          "required": ["authority", "audience", "webClientId", "requireHttpsMetadata"],
          "properties": {
            "authority": { "type": "string", "pattern": "^https?://.+", "description": "OIDC issuer URL of the site IdP (required)" },
            "audience": { "type": "string", "minLength": 1 },
            "webClientId": { "type": "string", "minLength": 1 },
            "requireHttpsMetadata": { "type": "boolean" }
          }
        },
        "security": { "type": "object", "properties": { "requireFips": { "type": "boolean" } } },
        "vault": {
          "type": "object",
          "required": ["serviceUrl", "bucket"],
          "properties": {
            "serviceUrl": { "type": "string", "pattern": "^https?://.+", "description": "S3 endpoint of the vault (required)" },
            "bucket": { "type": "string", "minLength": 3 },
            "region": { "type": "string", "minLength": 1 },
            "serverSideEncryption": { "type": "boolean" },
            "maxUploadBytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
            "partSizeBytes": { "type": "integer", "minimum": 5242880, "maximum": 536870912 },
            "maxPdfStampBytes": { "type": "integer", "minimum": 0 },
            "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
          }
        },
        "proxy": {
          "type": "object",
          "required": ["knownNetworks"],
          "properties": {
            "knownNetworks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } }
          }
        },
        "extraEnv": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["app", "migrator"],
      "properties": {
        "app": { "type": "object", "properties": { "existingSecret": { "type": "string" } } },
        "migrator": { "type": "object", "properties": { "existingSecret": { "type": "string" } } }
      }
    },
    "tls": {
      "type": "object",
      "properties": { "caBundle": { "type": "object", "properties": { "existingConfigMap": { "type": "string" }, "key": { "type": "string", "minLength": 1 } } } }
    },
    "dataProtection": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] },
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tlsSecretName": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "blockMetrics": { "type": "boolean" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "host": { "minLength": 1 }, "tlsSecretName": { "minLength": 1 } } }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": {
          "type": "object",
          "properties": {
            "postgres": { "$ref": "#/definitions/egressPeer" },
            "vault": { "$ref": "#/definitions/egressPeer" },
            "idp": { "$ref": "#/definitions/egressPeer" }
          }
        }
      }
    },
    "podDisruptionBudget": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": ["integer", "string"] } } },
    "migration": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["hook", "job"] },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30 }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": { "runAsNonRoot": { "const": true }, "runAsUser": { "type": "integer", "minimum": 1 } }
    },
    "securityContext": {
      "type": "object",
      "properties": { "readOnlyRootFilesystem": { "const": true }, "allowPrivilegeEscalation": { "const": false } }
    },
    "antiAffinity": { "enum": ["soft", "hard"] },
    "dev": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  },
  "allOf": [
    {
      "if": { "properties": { "dev": { "properties": { "enabled": { "const": false } } } } },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "app": { "properties": { "existingSecret": { "minLength": 1 } } },
              "migrator": { "properties": { "existingSecret": { "minLength": 1 } } }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "egressPeer": {
      "type": "object",
      "properties": {
        "to": { "type": "array", "items": { "type": "object" } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
