{
  "_comment": "TEMPLATE overlay (ADR-0058). Every __NAME__ must be given a value by scripts/idp/merge-realm-overlay.sh; the merge refuses to run with one left over. Nothing is granted to a person the IdP does not assert: an unmapped person gets no plm role and Keel denies them. Read docs/ops/sso-integration.md before use.",
  "identityProviders": [
    {
      "alias": "customer-oidc",
      "displayName": "__DISPLAY_NAME__",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "__ISSUER__",
        "authorizationUrl": "__AUTHORIZATION_URL__",
        "tokenUrl": "__TOKEN_URL__",
        "jwksUrl": "__JWKS_URL__",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "clientId": "__CLIENT_ID__",
        "clientSecret": "__CLIENT_SECRET__",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "disableUserInfo": "true",
        "filteredByClaim": "false",
        "hideOnLoginPage": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "group-to-plm-viewer",
      "identityProviderAlias": "customer-oidc",
      "identityProviderMapper": "oidc-role-idp-mapper",
      "config": {
