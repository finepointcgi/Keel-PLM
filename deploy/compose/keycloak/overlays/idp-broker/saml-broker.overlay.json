{
  "_comment": "TEMPLATE overlay (ADR-0058) for a SAML 2.0 identity provider (ADFS, Entra ID SAML, Okta SAML, Ping). Same rules as the OIDC template. Not exercised against a live SAML IdP by the repository tests (docs/ops/sso-integration.md says what was and was not verified).",
  "identityProviders": [
    {
      "alias": "customer-saml",
      "displayName": "__DISPLAY_NAME__",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "__SP_ENTITY_ID__",
        "idpEntityId": "__IDP_ENTITY_ID__",
        "singleSignOnServiceUrl": "__SSO_URL__",
        "singleLogoutServiceUrl": "__SLO_URL__",
        "signingCertificate": "__SIGNING_CERTIFICATE__",
        "validateSignature": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "signSpMetadata": "false",
        "wantAuthnRequestsSigned": "false",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "principalType": "SUBJECT",
        "allowCreate": "true",
        "forceAuthn": "false",
        "syncMode": "FORCE",
        "xmlSigKeyInfoKeyNameTransformer": "KEY_ID"
      }
    }
  ],
  "identityProviderMappers": [
