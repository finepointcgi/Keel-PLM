{
  "realm": "keel",
  "enabled": true,
  "displayName": "Keel PLM (development)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(12)",
  "roles": {
    "realm": [
      {
        "name": "plm-viewer"
      },
      {
        "name": "plm-author"
      },
      {
        "name": "plm-approver"
      },
      {
        "name": "plm-admin"
      },
      {
        "name": "plm-auditor"
      },
      {
        "name": "plm-integration",
        "description": "Service accounts of connected systems (ERP reconciliation): the integration pull API and read access under the account's own markings. Grants nothing in the UI or the interactive API."
      },
      {
        "name": "plm-supplier",
        "description": "An external supplier's user (supplier portal): sees only the requests addressed to the one supplier an administrator linked the user to. Grants no access to any internal object."
      },
      {
        "name": "plm-records",
        "description": "Records management: retention schedules, legal holds, disposition and archives. Grants no access to any object by itself; what the holder can see is still decided by the viewer role and the security markings."
      }
    ]
  },
