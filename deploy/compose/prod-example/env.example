# Copy to .env next to compose.prod-example.yaml (or export the variables). Only non-secret settings live here; secrets are files
# (gen-secrets.sh). Every Keel setting is documented in docs/ops/configuration.md.

# The name users type. Must match a SAN in prod-example/certs/proxy.crt and the redirect URIs registered at the IdP.
KEEL_PUBLIC_HOST=keel.test
KEEL_HTTPS_PORT=8443

# The site identity provider (EXTERNAL). The issuer URL exactly as in its discovery document.
KEEL_OIDC_AUTHORITY=https://idp.example.mil/realms/keel
KEEL_OIDC_AUDIENCE=keel-api
KEEL_OIDC_CLIENT_ID=keel-web

# true on FIPS-mode RHEL hosts (the application refuses to start otherwise). Set false only for a non-FIPS test host.
KEEL_REQUIRE_FIPS=true

# The Keel image built or loaded from the offline bundle. The other images default to the digests in deploy/images.env.
KEEL_APP_IMAGE=keel/api:1.7.0

# Malware scanning of uploads (ADR-0026). Required = every upload is scanned and refused when the scanner cannot answer (use with compose.clamav.yaml).
# BestEffort = accepted unscanned when the scanner is down. Disabled is refused while KEEL_REQUIRE_FIPS=true unless KEEL_SCAN_ACK_UNSCANNED=true.
KEEL_SCAN_MODE=Required
KEEL_SCAN_ACK_UNSCANNED=false

# Resource ceilings per service (optional; defaults in compose.prod-example.yaml suit about 50 concurrent users, see docs/ops/performance.md).
# KEEL_APP_MEMORY=2g
# KEEL_APP_CPUS=2
# KEEL_POSTGRES_MEMORY=4g
# KEEL_POSTGRES_CPUS=2
# KEEL_VAULT_MEMORY=2g
# KEEL_VAULT_CPUS=1
# KEEL_PROXY_MEMORY=256m
# KEEL_PROXY_CPUS=1
# KEEL_MIGRATE_MEMORY=1g
