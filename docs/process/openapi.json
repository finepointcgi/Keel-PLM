  "components": {
    "schemas": {
      "AttachmentDef": {
        "required": [
          "document",
          "fileId",
          "caption"
        ],
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          },
          "fileId": {
            "type": "string",
            "format": "uuid"
          },
          "caption": {
            "type": "string"
          }
        }
      },
      "CalibrationRequest": {
        "required": [
          "calibratedOn"
        ],
        "type": "object",
        "properties": {
          "calibratedOn": {
            "type": "string",
            "format": "date"
          },
          "reference": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CheckInPlanRequest": {
        "type": "object",
        "properties": {
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ComponentAssignment": {
        "required": [
          "partMasterId",
          "find",
          "alt",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "partMasterId": {
            "type": "string",
            "format": "uuid"
          },
          "find": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "alt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreatePlanRequest": {
        "required": [
          "mbom"
        ],
        "type": "object",
        "properties": {
          "mbom": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "markings": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MarkingsDto"
              }
            ]
          },
          "confirmRaiseMarkings": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "CreateToolRequest": {
        "required": [
          "name",
          "kind",
          "plant",
          "markings"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "plant": {
            "type": "string"
          },
          "markings": {
            "$ref": "#/components/schemas/MarkingsDto"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "requiresCalibration": {
            "type": "boolean",
            "default": false
          },
          "intervalDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lastCalibratedOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "DistributionStatement": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F"
        ]
      },
      "ExportJurisdiction": {
        "enum": [
          "None",
          "Ear",
          "Itar"
        ]
      },
      "MarkingsDto": {
        "required": [
          "exportJurisdiction",
          "distributionStatement",
          "owningOrg"
        ],
        "type": "object",
        "properties": {
          "exportJurisdiction": {
            "$ref": "#/components/schemas/ExportJurisdiction"
          },
          "distributionStatement": {
            "$ref": "#/components/schemas/DistributionStatement"
          },
          "owningOrg": {
            "type": "string"
          },
          "eccn": {
            "type": [
              "null",
              "string"
            ]
          },
          "usmlCategory": {
            "type": [
              "null",
              "string"
            ]
          },
          "cuiCategories": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "controllingOffice": {
            "type": [
              "null",
              "string"
            ]
          },
          "distributionReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "program": {
            "type": [
              "null",
              "string"
            ]
          },
          "exportAuthorizations": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OperationDef": {
        "required": [
          "id",
          "number",
          "name",
          "workCenter",
          "setupMinutes",
          "runMinutes",
          "condition",
          "inspection",
          "inspectionText",
          "components",
          "tools",
          "steps"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "workCenter": {
            "type": [
              "null",
              "string"
            ]
          },
          "setupMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "runMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "condition": {
            "type": [
              "null",
              "string"
            ]
          },
          "inspection": {
            "type": "boolean"
          },
          "inspectionText": {
            "type": [
              "null",
              "string"
            ]
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentAssignment"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepDef"
            }
          }
        }
      },
      "PlanContent": {
        "required": [
          "routings"
        ],
        "type": "object",
        "properties": {
          "routings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutingDef"
            }
          }
        }
      },
      "RoutingDef": {
        "required": [
          "code",
          "name",
          "isPrimary",
          "condition",
          "note",
          "operations"
        ],
        "type": "object",
