{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/change.released.v1.json",
  "title": "change.released v1",
  "description": "A change notice was released: affected revisions, resulting revisions and effectivity.",
  "type": "object",
  "properties": {
    "changeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "number": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "changeClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "sourceChange": {
      "type": [
        "string",
        "null"
      ]
    },
    "submission": {
      "type": "integer",
      "minimum": 0
    },
    "affected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectType": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "effectivity": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "objectType",
          "number",
          "name",
          "revision",
          "action",
          "effectivity"
        ],
        "additionalProperties": false
      }
    },
    "resulting": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectType": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "iteration": {
            "type": "string"
          }
        },
        "required": [
          "objectType",
          "number",
          "revision",
          "iteration"
        ],
        "additionalProperties": false
      }
    },
    "obsoleted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retainedByEffectivity": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "releasedAt": {
      "type": "string"
    }
  },
  "required": [
    "changeId",
    "number",
    "type",
    "title",
    "description",
    "changeClass",
    "priority",
    "reason",
    "sourceChange",
    "submission",
    "affected",
    "resulting",
    "obsoleted",
    "retainedByEffectivity",
    "releasedAt"
  ],
  "additionalProperties": false
}
