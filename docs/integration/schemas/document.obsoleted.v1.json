{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.invalid/schemas/document.obsoleted.v1.json",
  "title": "document.obsoleted v1",
  "description": "A released document revision became obsolete.",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "documentType": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "iteration": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "const": "admin"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "fileName",
          "mediaType",
          "sizeBytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "documentId",
    "revisionId",
    "number",
    "name",
    "documentType",
    "revision",
    "iteration",
    "state",
    "via",
    "files"
  ],
  "additionalProperties": false
}
