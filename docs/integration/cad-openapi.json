  "components": {
    "schemas": {
      "AddMemberRequest": {
        "required": [
          "name",
          "documentType",
          "cadRole"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "documentType": {
            "type": "string"
          },
          "cadRole": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "references": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CadAssociationRequest": {
        "required": [
          "documentNumber",
          "partNumber",
          "kind"
        ],
        "type": "object",
        "properties": {
          "documentNumber": {
            "type": "string"
          },
          "partNumber": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "CadCheckOutRequest": {
        "required": [
          "top"
        ],
        "type": "object",
        "properties": {
          "top": {
            "type": "string"
          },
          "roles": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "includeDependents": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "allowPartial": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "CadDecisionsRequest": {
        "required": [
          "decisions"
        ],
        "type": "object",
        "properties": {
          "decisions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ProposalPartDecision"
            }
          },
          "applyRemovals": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "CheckInMemberRequest": {
        "required": [
          "number"
        ],
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          },
          "references": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ExpectedFile"
            }
          }
        }
      },
      "ExpectedFile": {
        "required": [
          "fileName",
          "sha256"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "PackageCheckInRequest": {
        "type": "object",
        "properties": {
          "comment": {
            "type": [
              "null",
              "string"
            ]
          },
          "members": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CheckInMemberRequest"
            }
          },
          "skipUnchanged": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ProposalPartDecision": {
        "required": [
          "ref",
          "decision"
        ],
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "matchNumber": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "cadSystem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "CAD"
    }
  ]
}
