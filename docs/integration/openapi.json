{
  "openapi": "3.1.1",
  "info": {
    "title": "Keel PLM integration API",
    "description": "Pull API for ERP reconciliation, Technical Data Package export and integration administration. Events are delivered to sinks as signed envelopes; see docs/integration/erp-contract.md.",
    "version": "1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/integration/events": {
      "get": {
        "tags": [
          "Integration pull API"
        ],
        "summary": "Events in commit order after a cursor, limited to what the caller may read.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aggregate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/integration/boms/{number}": {
      "get": {
        "tags": [
          "Integration pull API"
        ],
        "summary": "Released EBOM snapshot of an assembly revision (children resolved at the requested configuration spec). With variant, only the lines that variant uses; otherwise every line with its option condition.",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "spec",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "baseline",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "variant",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/integration/mboms/{number}": {
      "get": {
        "tags": [
          "Integration pull API"
        ],
        "summary": "Latest released MBOM of a part in a plant (or the named revision), children resolved to the plant\u0027s released MBOMs. Lines you may not read are placeholders.",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "plant",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/integration/changes/{number}": {
      "get": {
        "tags": [
          "Integration pull API"
        ],
        "summary": "A change request or notice with its affected and resulting revisions and effectivity.",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tdp/preview": {
      "post": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "What a package would contain, and why it would be refused (counts only).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TdpApiRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tdp": {
      "post": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "Exports the package as a signed ZIP stream.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TdpApiRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "Export history readable by the caller.",
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tdp/{id}": {
      "get": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "One export record with its manifest.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/tdp/{id}/verify": {
      "get": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "Checks the stored manifest against its recorded hash and signature.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Technical Data Package"
        ],
        "summary": "Verifies an uploaded package against the record of this export.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/zip": {
              "schema": {
                "$ref": "#/components/schemas/Stream"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/profiles": {
      "get": {
        "tags": [
          "Integration administration"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Integration administration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/sinks": {
      "get": {
        "tags": [
          "Integration administration"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Integration administration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SinkInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/deliveries": {
      "get": {
        "tags": [
          "Integration administration"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sink",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/deliveries/requeue": {
      "post": {
        "tags": [
          "Integration administration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequeueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/deliveries/reevaluate": {
      "post": {
        "tags": [
          "Integration administration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequeueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/outbox": {
      "get": {
        "tags": [
          "Integration administration"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aggregate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/admin/integration/tdp-categories": {
      "get": {
        "tags": [
          "Integration administration"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Integration administration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRuleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Integration administration"
        ],
        "parameters": [
          {
            "name": "documentType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "linkType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryRuleRequest": {
        "required": [
          "documentType",
          "linkType",
          "category"
        ],
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string"
          },
          "linkType": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": "string"
          }
        }
      },
      "JsonObject": {
        "type": "object"
      },
      "ProfileInput": {
        "required": [
          "name",
          "label",
          "description",
          "recipientCategory",
          "usPersonsOnly",
          "allowedJurisdictions",
          "allowedEccns",
          "allowedUsml",
          "allowedCui",
          "allowedPrograms",
          "allowedStatements",
          "exportAuthorizations"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "recipientCategory": {
            "type": "string"
          },
          "usPersonsOnly": {
            "type": "boolean"
          },
          "allowedJurisdictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedEccns": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allowedUsml": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allowedCui": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allowedPrograms": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allowedStatements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exportAuthorizations": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "RequeueRequest": {
        "required": [
          "deliveryId",
          "sink"
        ],
        "type": "object",
        "properties": {
          "deliveryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sink": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SinkInput": {
        "required": [
          "name",
          "label",
          "kind",
          "enabled",
          "profileName",
          "config"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "profileName": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "eventTypes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "fullStructure": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Stream": {
        "type": "string",
        "format": "binary"
      },
      "TdpApiRequest": {
        "required": [
          "objectType",
          "number",
          "revision",
          "recipientProfile"
        ],
        "type": "object",
        "properties": {
          "objectType": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "revision": {
            "type": [
              "null",
              "string"
            ]
          },
          "recipientProfile": {
            "type": "string"
          },
          "variant": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Integration pull API"
    },
    {
      "name": "Technical Data Package"
    },
    {
      "name": "Integration administration"
    }
  ]
}
