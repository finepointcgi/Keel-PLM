  "components": {
    "schemas": {
      "CreateDeclarationRequest": {
        "required": [
          "partNumber",
          "declaration"
        ],
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "string"
          },
          "declaration": {
            "$ref": "#/components/schemas/DeclarationRequest"
          }
        }
      },
      "CreateListRequest": {
        "required": [
          "code",
          "name",
          "kind"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeclarationLineRequest": {
        "required": [
          "substanceCas",
          "materialCode",
          "percent",
          "massMg"
        ],
        "type": "object",
        "properties": {
          "substanceCas": {
            "type": [
              "null",
              "string"
            ]
          },
          "materialCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "percent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "massMg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "exemptionCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "conflictFree": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "DeclarationRequest": {
        "required": [
          "declaredOn",
          "expiresOn",
          "lines"
        ],
        "type": "object",
        "properties": {
          "declaredOn": {
            "type": "string",
            "format": "date"
          },
          "expiresOn": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeclarationLineRequest"
            }
          },
          "source": {
            "type": "string",
            "default": "internal"
          },
          "revisionScope": {
            "type": [
              "null",
              "string"
            ]
          },
          "supplierRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "mpnRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "itemMassMg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DraftVersionRequest": {
        "required": [
          "effectiveFrom"
        ],
        "type": "object",
        "properties": {
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "sourceNote": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LinkDocumentRequest": {
        "required": [
          "documentNumber"
        ],
        "type": "object",
        "properties": {
          "documentNumber": {
            "type": "string"
          }
        }
      },
      "MaterialComponentRequest": {
        "required": [
          "casNumber",
          "fractionPct"
        ],
        "type": "object",
        "properties": {
          "casNumber": {
            "type": "string"
          },
          "fractionPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "MaterialRequest": {
        "required": [
          "code",
          "name",
          "description",
          "composition"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "composition": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaterialComponentRequest"
            }
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 0
          }
        }
      },
      "RegEntryRequest": {
        "required": [
          "casNumber",
          "thresholdPct"
        ],
        "type": "object",
        "properties": {
          "casNumber": {
            "type": "string"
          },
          "thresholdPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegExemptionRequest": {
        "required": [
          "code",
          "description"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "casNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "SaveVersionRequest": {
        "required": [
          "effectiveFrom",
          "revision",
          "entries"
        ],
        "type": "object",
        "properties": {
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "entries": {
            "type": "array",
            "items": {
