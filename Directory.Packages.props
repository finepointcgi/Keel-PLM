<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!-- Vault: S3 API only (A13, ADR-0015). Apache-2.0. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104" />
    <!-- PDF marking (A10). MIT. Core build: no GDI/WPF, works on Linux and macOS with our own font resolver. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp pulls System.Security.Cryptography.Pkcs 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); pin the patched servicing release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
